@model List<MapHub.Models.PasswordResetRequest>
@{
    ViewData["Title"] = "Admin – Đặt lại mật khẩu";
    var pending = Model.Where(r => r.Status == "pending").ToList();
    var done = Model.Where(r => r.Status == "done").ToList();
}

<partial name="_AdminNav" />

<div class="admin-page" style="max-width:900px">
    <div class="admin-section-header">
        <div>
            <h2 class="admin-section-title"><i class="fa-solid fa-key"></i> Yêu cầu đặt lại mật khẩu</h2>
            <p class="admin-section-sub">@pending.Count yêu cầu đang chờ xử lý</p>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(TempData["Success"]?.ToString()))
    {
        <div class="admin-alert admin-alert-success">✅ @TempData["Success"]</div>
    }
    @if (!string.IsNullOrEmpty(TempData["Error"]?.ToString()))
    {
        <div class="admin-alert" style="background:#fef2f2;color:#b91c1c;border:1px solid #fecaca">@TempData["Error"]</div>
    }

    <div class="dash-card mb-3">
        <div class="dash-card-head"><h3 class="dash-card-title">Đang chờ (@pending.Count)</h3></div>
        @if (!pending.Any())
        {
            <p class="text-muted" style="font-size:.9rem">Không có yêu cầu nào đang chờ.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="admin-table">
                    <thead><tr><th>Email</th><th>Lời nhắn</th><th>Lúc</th><th>Đặt mật khẩu mới</th></tr></thead>
                    <tbody>
                        @foreach (var r in pending)
                        {
                            <tr>
                                <td class="fw-semibold">@r.Email</td>
                                <td><span class="admin-sub">@(string.IsNullOrWhiteSpace(r.Message) ? "—" : r.Message)</span></td>
                                <td><span class="admin-sub">@r.CreatedAt.ToLocalTime().ToString("dd/MM HH:mm")</span></td>
                                <td>
                                    <form method="post" action="/Admin/ResolveReset" class="d-flex gap-2 align-items-center"
                                          onsubmit="return confirm('Đặt mật khẩu mới cho @r.Email?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@r.Id">
                                        <input type="text" name="newPassword" value="@("Cs" + Guid.NewGuid().ToString("N").Substring(0,8))"
                                               class="form-control form-control-sm" style="width:150px" minlength="8" required>
                                        <button type="submit" class="btn-accent" style="padding:.35rem .8rem">Đặt lại</button>
                                        <button type="submit" formaction="/Admin/DeleteReset" class="aact-btn aact-del"
                                                onclick="return confirm('Xoá yêu cầu này?')" title="Xoá"><i class="fa-solid fa-trash"></i></button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <p class="text-muted mt-2" style="font-size:.82rem"><i class="bi bi-info-circle"></i> Sau khi bấm "Đặt lại", mật khẩu mới hiện ở thông báo trên cùng — copy gửi cho người dùng.</p>
        }
    </div>

    @if (done.Any())
    {
        <div class="dash-card">
            <div class="dash-card-head"><h3 class="dash-card-title">Đã xử lý (@done.Count)</h3></div>
            <div class="table-responsive">
                <table class="admin-table">
                    <thead><tr><th>Email</th><th>Mật khẩu đã đặt</th><th>Xử lý lúc</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var r in done.Take(30))
                        {
                            <tr>
                                <td class="fw-semibold">@r.Email</td>
                                <td><span class="mono-code">@(r.NewPassword ?? "—")</span></td>
                                <td><span class="admin-sub">@(r.HandledAt?.ToLocalTime().ToString("dd/MM HH:mm") ?? "—")</span></td>
                                <td>
                                    <form method="post" action="/Admin/DeleteReset" class="d-inline" onsubmit="return confirm('Xoá?')">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@r.Id">
                                        <button type="submit" class="aact-btn aact-del" title="Xoá"><i class="fa-solid fa-trash"></i></button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
