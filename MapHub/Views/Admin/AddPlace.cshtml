@{
    ViewData["Title"] = "Admin – Thêm địa điểm";
    var allTags = ViewBag.AllTags as List<MapHub.Models.Tag> ?? new List<MapHub.Models.Tag>();
}

<div class="container-xl py-4" style="max-width:760px">
    <a href="/Admin" class="back-link">← Admin Dashboard</a>
    <h2 class="mt-3 mb-4"><i class="fa-solid fa-circle-plus"></i> Thêm Địa Điểm Mới (Admin)</h2>

    <form method="post" action="/Admin/AddPlace" class="needs-validation" enctype="multipart/form-data">
        @Html.AntiForgeryToken()

        <div class="info-card mb-3">
            <div class="row g-3">
                <div class="col-md-8">
                    <label class="form-label fw-semibold">Tên địa điểm *</label>
                    <input type="text" name="Name" class="form-control" required placeholder="VD: Hồ Hoàn Kiếm">
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-semibold">Danh mục</label>
                    <select name="Category" class="form-select">
                        <optgroup label="Cá nhân">
                            <option value="home">🏠 Nhà riêng</option>
                            <option value="work">🏢 Công ty</option>
                            <option value="school">🏫 Trường học</option>
                            <option value="favorite">❤️ Quán ăn yêu thích</option>
                        </optgroup>
                        <optgroup label="Công khai">
                            <option value="restaurant">🍽️ Nhà hàng</option>
                            <option value="cafe">☕ Cà phê</option>
                            <option value="entertainment">🎯 Vui chơi</option>
                            <option value="hotel">🏨 Lưu trú</option>
                            <option value="culture">🏛️ Văn hóa</option>
                            <option value="temple">🛕 Tâm linh</option>
                            <option value="nature">🌿 Thiên nhiên</option>
                            <option value="education">🎓 Giáo dục</option>
                            <option value="other">📌 Khác</option>
                        </optgroup>
                    </select>
                </div>
                <div class="col-12">
                    <label class="form-label fw-semibold">Mô tả ngắn</label>
                    <input type="text" name="Description" class="form-control" placeholder="Một câu mô tả súc tích">
                </div>
                <div class="col-12">
                    <label class="form-label fw-semibold">Giới thiệu đầy đủ (About)</label>
                    <textarea name="About" class="form-control" rows="3" placeholder="Không gian, lịch sử, lưu ý..."></textarea>
                </div>
                <div class="col-md-8">
                    <label class="form-label fw-semibold">Địa chỉ</label>
                    <input type="text" name="Address" class="form-control" placeholder="Số nhà, đường, quận, Hà Nội">
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-semibold">Điện thoại</label>
                    <input type="text" name="Phone" class="form-control" placeholder="024 xxxx xxxx">
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-semibold">Vĩ độ (Lat) *</label>
                    <input type="number" step="0.000001" id="adminLat" name="Latitude" class="form-control" required placeholder="21.028511" oninput="syncAdminMarker()">
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-semibold">Kinh độ (Lng) *</label>
                    <input type="number" step="0.000001" id="adminLng" name="Longitude" class="form-control" required placeholder="105.852014" oninput="syncAdminMarker()">
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-semibold">Quyền xem</label>
                    <select name="Visibility" class="form-select">
                        <option value="public">🌍 Công khai</option>
                        <option value="private">🔒 Cá nhân</option>
                    </select>
                </div>
                <div class="col-12">
                    <label class="form-label fw-semibold">📍 Chọn vị trí trên bản đồ</label>
                    <div id="adminMiniMap" style="height:260px;border-radius:10px;overflow:hidden"></div>
                    <small class="text-muted">Click bản đồ để đặt toạ độ, hoặc gõ tay ở trên.</small>
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-semibold">Giá từ (đ)</label>
                    <input type="number" name="MinPrice" class="form-control" placeholder="VD: 30000">
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-semibold">Giá đến (đ)</label>
                    <input type="number" name="MaxPrice" class="form-control" placeholder="VD: 150000">
                </div>
                <div class="col-12">
                    <label class="form-label fw-semibold">🏷️ Tags</label>
                    @if (allTags.Any())
                    {
                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var tag in allTags)
                            {
                                <label style="display:inline-flex;align-items:center;gap:.35rem;padding:.3rem .7rem;border:1px solid #e2e8f0;border-radius:20px;cursor:pointer;font-size:.88rem">
                                    <input type="checkbox" name="tagIds" value="@tag.Id"> @tag.Name
                                </label>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="form-text">Chưa có tag nào. <a href="/Admin/Tags">Tạo tag →</a></div>
                    }
                </div>
                <div class="col-12">
                    <label class="form-label fw-semibold">Ảnh đại diện</label>
                    <input type="url" name="imageUrl" class="form-control mb-2" placeholder="https://... (dán link ảnh)">
                    <div class="d-flex align-items-center gap-2">
                        <span class="text-muted small text-nowrap">— hoặc tải từ máy —</span>
                        <input type="file" name="imageFile" class="form-control form-control-sm" accept="image/*">
                    </div>
                </div>
                <div class="col-12">
                    <label class="form-label fw-semibold"><i class="fa-solid fa-images"></i> Thêm nhiều ảnh khác <small class="text-muted">(không bắt buộc, chọn nhiều)</small></label>
                    <input type="file" name="moreImages" class="form-control form-control-sm" accept="image/*" multiple>
                </div>
                <div class="col-12">
                    <label class="form-label fw-semibold"><i class="fa-solid fa-utensils"></i> Ảnh thực đơn / menu <small class="text-muted">(không bắt buộc, chọn nhiều)</small></label>
                    <input type="file" name="menuImages" class="form-control form-control-sm" accept="image/*" multiple>
                </div>
            </div>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn-accent"><i class="fa-solid fa-floppy-disk"></i> Lưu địa điểm (tự duyệt)</button>
            <a href="/Admin" class="btn-ghost">Hủy</a>
        </div>
    </form>
</div>

@section Scripts {
<script>
let adminMap, adminMarker;
document.addEventListener('DOMContentLoaded', () => {
    adminMap = L.map('adminMiniMap').setView([21.0285, 105.8542], 12);
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png').addTo(adminMap);
    adminMap.on('click', e => {
        document.getElementById('adminLat').value = e.latlng.lat.toFixed(6);
        document.getElementById('adminLng').value = e.latlng.lng.toFixed(6);
        if (adminMarker) adminMarker.setLatLng(e.latlng); else adminMarker = L.marker(e.latlng).addTo(adminMap);
    });
});
function syncAdminMarker() {
    const lat = parseFloat(document.getElementById('adminLat').value);
    const lng = parseFloat(document.getElementById('adminLng').value);
    if (isNaN(lat) || isNaN(lng) || !adminMap) return;
    if (adminMarker) adminMarker.setLatLng([lat, lng]); else adminMarker = L.marker([lat, lng]).addTo(adminMap);
    adminMap.setView([lat, lng], Math.max(adminMap.getZoom(), 14));
}
</script>
}
