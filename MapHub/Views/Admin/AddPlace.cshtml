@{
    ViewData["Title"] = "Admin – Thêm địa điểm";
}

<div class="container-xl py-4" style="max-width:760px">
    <a href="/Admin" class="back-link">← Admin Dashboard</a>
    <h2 class="mt-3 mb-4">➕ Thêm Địa Điểm Mới (Admin)</h2>

    <form method="post" action="/Admin/AddPlace" class="needs-validation">
        @Html.AntiForgeryToken()

        <div class="info-card mb-3">
            <div class="row g-3">
                <div class="col-md-8">
                    <label class="form-label fw-semibold">Tên địa điểm *</label>
                    <input type="text" name="Name" class="form-control" required placeholder="VD: Hồ Hoàn Kiếm">
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-semibold">Danh mục</label>
                    <select name="Category" class="form-select">
                        <option value="restaurant">🍽️ Nhà hàng</option>
                        <option value="cafe">☕ Cà phê</option>
                        <option value="entertainment">🎯 Vui chơi</option>
                        <option value="hotel">🏨 Lưu trú</option>
                        <option value="culture">🏛️ Văn hóa</option>
                        <option value="temple">🛕 Tâm linh</option>
                        <option value="nature">🌿 Thiên nhiên</option>
                        <option value="education">🎓 Giáo dục</option>
                        <option value="other">📌 Khác</option>
                    </select>
                </div>
                <div class="col-12">
                    <label class="form-label fw-semibold">Mô tả ngắn</label>
                    <input type="text" name="Description" class="form-control" placeholder="Một câu mô tả súc tích">
                </div>
                <div class="col-12">
                    <label class="form-label fw-semibold">Giới thiệu đầy đủ (About)</label>
                    <textarea name="About" class="form-control" rows="3" placeholder="Không gian, lịch sử, lưu ý..."></textarea>
                </div>
                <div class="col-md-8">
                    <label class="form-label fw-semibold">Địa chỉ</label>
                    <input type="text" name="Address" class="form-control" placeholder="Số nhà, đường, quận, Hà Nội">
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-semibold">Điện thoại</label>
                    <input type="text" name="Phone" class="form-control" placeholder="024 xxxx xxxx">
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-semibold">Vĩ độ (Lat) *</label>
                    <input type="number" step="0.000001" name="Latitude" class="form-control" required placeholder="21.028511">
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-semibold">Kinh độ (Lng) *</label>
                    <input type="number" step="0.000001" name="Longitude" class="form-control" required placeholder="105.852014">
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-semibold">Quyền xem</label>
                    <select name="Visibility" class="form-select">
                        <option value="public">🌍 Công khai</option>
                        <option value="private">🔒 Cá nhân</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-semibold">Giá từ (đ)</label>
                    <input type="number" name="MinPrice" class="form-control" placeholder="0">
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-semibold">Giá đến (đ)</label>
                    <input type="number" name="MaxPrice" class="form-control" placeholder="0">
                </div>
                <div class="col-12">
                    <label class="form-label fw-semibold">URL ảnh đại diện</label>
                    <input type="url" name="imageUrl" class="form-control" placeholder="https://...">
                </div>
            </div>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn-accent">💾 Lưu địa điểm (tự duyệt)</button>
            <a href="/Admin" class="btn-ghost">Hủy</a>
        </div>
    </form>
</div>
