@model MapHub.Models.FeedPost
@{
    ViewData["Title"] = "Admin – Tạo bài viết";
}

<div class="container-xl py-4" style="max-width:760px">
    <a href="/Admin/FeedPosts" class="back-link">← Quản lý tin tức</a>
    <h2 class="mt-3 mb-4">📰 Tạo Bài Viết / Tin Tức Mới</h2>

    <form method="post" action="/Admin/CreateFeedPost" class="needs-validation" enctype="multipart/form-data">
        @Html.AntiForgeryToken()

        <div class="info-card mb-3">
            <div class="row g-3">
                <div class="col-12">
                    <label class="form-label fw-semibold">Tiêu đề *</label>
                    <input type="text" name="Title" class="form-control" required
                           placeholder="VD: Top 10 Quán Cà Phê Đẹp Nhất Hà Nội 2026" value="@Model.Title">
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Loại bài viết</label>
                    <select name="Type" class="form-select">
                        <option value="news" selected="@(Model.Type == "news" || Model.Type == null)">📰 Tin tức</option>
                        <option value="guide" selected="@(Model.Type == "guide")">📖 Cẩm nang</option>
                        <option value="tip" selected="@(Model.Type == "tip")">💡 Mẹo hay</option>
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Sự kiện liên quan</label>
                    <select name="EventId" class="form-select">
                        <option value="">— Không liên kết sự kiện —</option>
                        @if (ViewBag.Events != null)
                        {
                            foreach (var e in (dynamic)ViewBag.Events)
                            {
                                <option value="@e.Id" selected="@(Model.EventId == (int)e.Id)">@e.Title</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-12">
                    <label class="form-label fw-semibold">Tóm tắt</label>
                    <textarea name="Summary" class="form-control" rows="3"
                              placeholder="Mô tả ngắn hiển thị trên trang chủ (1-2 câu)...">@Model.Summary</textarea>
                </div>
                <div class="col-12">
                    <label class="form-label fw-semibold">Ảnh bìa</label>
                    <input type="file" name="imageFile" class="form-control mb-2" accept="image/*" onchange="previewCover(this)">
                    <img id="coverPreview" src="" alt="" style="display:none;max-height:140px;border-radius:8px;margin-bottom:6px">
                    <input type="url" name="CoverImageUrl" class="form-control"
                           placeholder="Hoặc dán URL ảnh: https://..." value="@Model.CoverImageUrl">
                    <div class="form-text">Tải ảnh từ máy HOẶC dán URL (file ưu tiên). Khuyến nghị 800×450px (16:9).</div>
                </div>
                <div class="col-12">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="IsPinned" value="true"
                               id="isPinned" @(Model.IsPinned ? "checked" : "")>
                        <label class="form-check-label fw-semibold" for="isPinned">
                            📌 Ghim bài viết (hiển thị ưu tiên trên trang chủ)
                        </label>
                    </div>
                </div>
            </div>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn-accent">💾 Đăng bài viết</button>
            <a href="/Admin/FeedPosts" class="btn-ghost">Hủy</a>
        </div>
    </form>
</div>
@section Scripts {
<script>
function previewCover(input) {
    const preview = document.getElementById('coverPreview');
    if (input.files && input.files[0]) {
        const reader = new FileReader();
        reader.onload = e => { preview.src = e.target.result; preview.style.display = 'block'; };
        reader.readAsDataURL(input.files[0]);
    }
}
</script>
}
