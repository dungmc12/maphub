@model MapHub.Models.FeedPost
@{
    ViewData["Title"] = "Admin – Sửa bài viết";
}

<div class="container-xl py-4" style="max-width:760px">
    <a href="/Admin/FeedPosts" class="back-link">← Quản lý tin tức</a>
    <h2 class="mt-3 mb-4">✏️ Sửa Bài Viết <small class="text-muted fs-6">#@Model.Id</small></h2>

    <form method="post" action="/Admin/EditFeedPost">
        @Html.AntiForgeryToken()
        <input type="hidden" name="Id" value="@Model.Id">

        <div class="info-card mb-3">
            <div class="row g-3">
                <div class="col-12">
                    <label class="form-label fw-semibold">Tiêu đề *</label>
                    <input type="text" name="Title" class="form-control" required value="@Model.Title">
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Loại bài viết</label>
                    <select name="Type" class="form-select">
                        <option value="news"  selected="@(Model.Type == "news")">📰 Tin tức</option>
                        <option value="guide" selected="@(Model.Type == "guide")">📖 Cẩm nang</option>
                        <option value="tip"   selected="@(Model.Type == "tip")">💡 Mẹo hay</option>
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-semibold">ID sự kiện liên quan</label>
                    <input type="number" name="EventId" class="form-control"
                           placeholder="Để trống nếu không có" value="@(Model.EventId?.ToString() ?? "")">
                </div>
                <div class="col-12">
                    <label class="form-label fw-semibold">Tóm tắt</label>
                    <textarea name="Summary" class="form-control" rows="3">@Model.Summary</textarea>
                </div>
                <div class="col-12">
                    <label class="form-label fw-semibold">URL ảnh bìa</label>
                    @if (!string.IsNullOrEmpty(Model.CoverImageUrl))
                    {
                        <img src="@Model.CoverImageUrl" alt="Ảnh bìa hiện tại"
                             style="max-height:100px;border-radius:6px;margin-bottom:6px;display:block">
                    }
                    <input type="url" name="CoverImageUrl" class="form-control"
                           placeholder="https://..." value="@Model.CoverImageUrl">
                </div>
                <div class="col-12">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="IsPinned" value="true"
                               id="isPinned" @(Model.IsPinned ? "checked" : "")>
                        <label class="form-check-label fw-semibold" for="isPinned">
                            📌 Ghim bài viết (hiển thị ưu tiên trên trang chủ)
                        </label>
                    </div>
                </div>
            </div>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn-accent">💾 Lưu thay đổi</button>
            <a href="/Admin/FeedPosts" class="btn-ghost">Hủy</a>
        </div>
    </form>
</div>
