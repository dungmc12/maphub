@model MapHub.Models.FeedPost
@{
    ViewData["Title"] = "Admin – Sửa bài viết";
}

<div class="container-xl py-4" style="max-width:760px">
    <a href="/Admin/FeedPosts" class="back-link">← Quản lý tin tức</a>
    <h2 class="mt-3 mb-4"><i class="fa-solid fa-pen-to-square"></i> Sửa Bài Viết <small class="text-muted fs-6">#@Model.Id</small></h2>

    <form method="post" action="/Admin/EditFeedPost" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <input type="hidden" name="Id" value="@Model.Id">

        <div class="info-card mb-3">
            <div class="row g-3">
                <div class="col-12">
                    <label class="form-label fw-semibold">Tiêu đề *</label>
                    <input type="text" name="Title" class="form-control" required value="@Model.Title">
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Slug</label>
                    <input type="text" name="Slug" class="form-control" value="@Model.Slug" placeholder="tu-tao-neu-de-trong">
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Loại bài viết</label>
                    <select name="Type" class="form-select">
                        <option value="news"  selected="@(Model.Type == "news")">Tin tức</option>
                        <option value="guide" selected="@(Model.Type == "guide")">Cẩm nang</option>
                        <option value="tip"   selected="@(Model.Type == "tip")">Mẹo hay</option>
                        <option value="toplist" selected="@(Model.Type == "toplist")">Top list</option>
                        <option value="review" selected="@(Model.Type == "review")">Review địa điểm</option>
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Sự kiện liên quan</label>
                    <select name="EventId" class="form-select">
                        <option value="">— Không liên kết sự kiện —</option>
                        @if (ViewBag.Events != null)
                        {
                            foreach (var e in (dynamic)ViewBag.Events)
                            {
                                <option value="@e.Id" selected="@(Model.EventId == (int)e.Id)">@e.Title</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-12">
                    <label class="form-label fw-semibold">Tóm tắt</label>
                    <textarea name="Summary" class="form-control" rows="2">@Model.Summary</textarea>
                </div>
                <div class="col-12">
                    <label class="form-label fw-semibold">Nội dung <small class="text-muted">(Markdown)</small></label>
                    <textarea name="Content" class="form-control" rows="12" style="font-family:ui-monospace,monospace;font-size:.9rem">@Model.Content</textarea>
                </div>
                <div class="col-12">
                    <label class="form-label fw-semibold">Ảnh bìa</label>
                    @if (!string.IsNullOrEmpty(Model.CoverImageUrl))
                    {
                        <img id="coverPreview" src="@Model.CoverImageUrl" alt="Ảnh bìa hiện tại"
                             style="max-height:120px;border-radius:6px;margin-bottom:6px;display:block">
                    }
                    else
                    {
                        <img id="coverPreview" src="" alt="" style="display:none;max-height:120px;border-radius:6px;margin-bottom:6px">
                    }
                    <input type="file" name="imageFile" class="form-control mb-2" accept="image/*" onchange="previewCover(this)">
                    <input type="url" name="CoverImageUrl" class="form-control"
                           placeholder="Hoặc URL ảnh (để trống = giữ nguyên)" value="@Model.CoverImageUrl">
                    <div class="form-text">Tải ảnh mới từ máy HOẶC URL, hoặc để trống để giữ ảnh cũ.</div>
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-semibold">SEO Title</label>
                    <input type="text" name="SeoTitle" class="form-control" value="@Model.SeoTitle">
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-semibold">SEO Description</label>
                    <input type="text" name="SeoDescription" class="form-control" value="@Model.SeoDescription">
                </div>
                <div class="col-12">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="IsPinned" value="true"
                               id="isPinned" @(Model.IsPinned ? "checked" : "")>
                        <label class="form-check-label fw-semibold" for="isPinned">
                            Ghim bài viết (hiển thị ưu tiên trên trang chủ)
                        </label>
                    </div>
                </div>
                <div class="col-12">
                    <a href="/bai-viet/@(string.IsNullOrEmpty(Model.Slug) ? Model.Id.ToString() : Model.Slug)" target="_blank" class="btn-ghost btn-sm-ghost">Xem bài viết →</a>
                    <small class="text-muted ms-2">@Model.ViewCount lượt xem</small>
                </div>
            </div>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn-accent"><i class="fa-solid fa-floppy-disk"></i> Lưu thay đổi</button>
            <a href="/Admin/FeedPosts" class="btn-ghost">Hủy</a>
        </div>
    </form>
</div>
@section Scripts {
<script>
function previewCover(input) {
    const preview = document.getElementById('coverPreview');
    if (input.files && input.files[0]) {
        const reader = new FileReader();
        reader.onload = e => { preview.src = e.target.result; preview.style.display = 'block'; };
        reader.readAsDataURL(input.files[0]);
    }
}
</script>
}
