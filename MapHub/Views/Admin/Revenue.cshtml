@model List<MapHub.Controllers.RevenueRow>
@{
    ViewData["Title"] = "Admin – Doanh thu";
    decimal total = (decimal)(ViewBag.Total ?? 0m);
    int count = (int)(ViewBag.Count ?? 0);
    decimal monthTotal = (decimal)(ViewBag.MonthTotal ?? 0m);
    int monthCount = (int)(ViewBag.MonthCount ?? 0);
    string Vnd(decimal n) => n.ToString("#,##0") + "đ";
    bool demoOn = Context.Request.Cookies["demo_tools"] == "1";
}

<partial name="_AdminNav" />
@Html.AntiForgeryToken()

<div class="admin-page dash">
    <div class="admin-section-header mb-3">
        <div>
            <h2 class="admin-section-title">Doanh thu</h2>
            <p class="admin-section-sub">Tổng hợp các đơn Pro đã thanh toán thành công</p>
        </div>
        @if (Context.Request.Cookies["demo_tools"] == "1")
        {
            <div class="d-flex gap-2 flex-wrap align-items-center">
                <form method="post" action="/Admin/SeedPayments" class="d-inline-flex align-items-center gap-1"
                      onsubmit="return confirm('Tạo lại đơn Pro mẫu rải đều theo thời gian (thay các đơn mẫu cũ, KHÔNG đụng đơn thật)?');">
                    @Html.AntiForgeryToken()
                    <input type="number" name="orders" value="20" min="1" max="50" title="Số đơn / người Pro"
                           class="form-control form-control-sm" style="width:64px">
                    <button type="submit" class="btn-ghost"><i class="fa-solid fa-wand-magic-sparkles"></i> Tạo đơn Pro mẫu (rải đều)</button>
                </form>
                <form method="post" action="/Admin/SpreadPaymentDates" class="d-inline-flex align-items-center gap-1"
                      onsubmit="return confirm('Rải đều NGÀY của mọi đơn đã thanh toán ra nhiều tháng (không dồn 1 tháng)?');">
                    @Html.AntiForgeryToken()
                    <input type="number" name="months" value="6" min="2" max="12" title="Rải ra mấy tháng"
                           class="form-control form-control-sm" style="width:56px">
                    <button type="submit" class="btn-ghost"><i class="fa-solid fa-calendar-days"></i> Rải đều ngày đơn</button>
                </form>
                <form method="post" action="/Admin/NormalizeSubscriptions"
                      onsubmit="return confirm('Chuẩn hoá gói Pro theo đơn: đơn trùng cách nhau 1 tháng, Pro hết hạn thì tự tắt, còn hạn thì bật đúng ngày?');">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn-ghost"><i class="fa-solid fa-arrows-rotate"></i> Chuẩn hoá Pro theo hạn</button>
                </form>
                @{ int seedCount = (int)(ViewBag.SeedCount ?? 0); }
                @if (seedCount > 0)
                {
                    <form method="post" action="/Admin/ClearSeedPayments"
                          onsubmit="return confirm('Xóa hết @seedCount đơn Pro mẫu và hạ các tài khoản đó về Free? (Không đụng đơn thật)');">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn-ghost" style="color:#b91c1c;border-color:#fecaca">
                            <i class="fa-solid fa-user-minus"></i> Xóa Pro mẫu (@seedCount)
                        </button>
                    </form>
                }
                @{ int testCount = (int)(ViewBag.TestCount ?? 0); }
                @if (testCount > 0)
                {
                    <form method="post" action="/Admin/ClearTestPayments"
                          onsubmit="return confirm('Xóa @testCount giao dịch thử nghiệm (giá cũ dưới 59.000đ)? Không thể hoàn tác.');">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn-ghost" style="color:#b91c1c;border-color:#fecaca">
                            <i class="fa-solid fa-trash"></i> Xóa @testCount giao dịch thử nghiệm
                        </button>
                    </form>
                }
            </div>
        }
    </div>

    <!-- KPI cards -->
    <div class="kpi-grid">
        <div class="kpi-card">
            <div class="kpi-label">Tổng doanh thu</div>
            <div class="kpi-num" data-count="@total" data-money="1">@Vnd(total)</div>
            <div class="kpi-foot">Tất cả thời gian</div>
        </div>
        <div class="kpi-card">
            <div class="kpi-label">Đơn đã thanh toán</div>
            <div class="kpi-num" data-count="@count">@count</div>
            <div class="kpi-foot">Tổng số đơn</div>
        </div>
        <div class="kpi-card kpi-accent">
            <div class="kpi-label">Doanh thu tháng này</div>
            <div class="kpi-num" data-count="@monthTotal" data-money="1">@Vnd(monthTotal)</div>
            <div class="kpi-foot">@DateTime.Now.ToString("MM/yyyy")</div>
        </div>
        <div class="kpi-card">
            <div class="kpi-label">Đơn tháng này</div>
            <div class="kpi-num" data-count="@monthCount">@monthCount</div>
            <div class="kpi-foot">@DateTime.Now.ToString("MM/yyyy")</div>
        </div>
    </div>

    <!-- Charts -->
    <div class="dash-charts">
        <div class="dash-card dash-trend">
            <div class="dash-card-head">
                <div>
                    <h3 class="dash-card-title">Xu hướng doanh thu</h3>
                    <p class="dash-card-sub">12 tuần gần nhất</p>
                </div>
            </div>
            <div id="revTrend" style="min-height:300px"></div>
        </div>
        <div class="dash-card">
            <div class="dash-card-head">
                <h3 class="dash-card-title">Cơ cấu gói</h3>
            </div>
            <div id="revChannel" style="min-height:300px"></div>
        </div>
    </div>

    <!-- Recent transactions -->
    <div class="dash-card mt-4" style="padding:0;overflow:hidden">
        <div class="dash-card-head" style="padding:1.1rem 1.3rem 0">
            <h3 class="dash-card-title">Giao dịch gần đây</h3>
        </div>
        <div class="admin-table-wrap" style="border:none;box-shadow:none;border-radius:0">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th>Mã đơn</th>
                        <th>Người dùng</th>
                        <th>Gói</th>
                        <th class="text-end">Số tiền</th>
                        <th>Trạng thái</th>
                        <th>Kênh</th>
                        <th>Ngày trả</th>
                        <th>Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr><td colspan="8" class="text-center text-muted p-4">Chưa có giao dịch nào.</td></tr>
                    }
                    else
                    {
                        @foreach (var r in Model.Take(50))
                        {
                            <tr>
                                <td><span class="mono-code">@r.Code</span></td>
                                <td>
                                    <div class="tx-user">
                                        <span class="tx-av">@((r.Email ?? "?").Trim()[..1].ToString().ToUpper())</span>
                                        <span>@(r.Email ?? "—")</span>
                                    </div>
                                </td>
                                <td>
                                    <span class="abadge @(r.PlanType == "year" ? "abadge-gold" : "abadge-blue")">@(r.PlanType == "year" ? "1 năm" : "1 tháng")</span>
                                    @if (r.Kind == "renewal")
                                    {
                                        <span class="abadge abadge-green" title="Tài khoản mua lại tháng sau"><i class="fa-solid fa-rotate"></i> Gia hạn</span>
                                    }
                                    else if (r.Kind == "new")
                                    {
                                        <span class="abadge abadge-gray"><i class="fa-solid fa-user-plus"></i> Đăng ký mới</span>
                                    }
                                </td>
                                <td class="text-end"><strong style="color:@(r.Status == "paid" ? "var(--green)" : "#94a3b8")">@Vnd(r.Amount)</strong></td>
                                <td>
                                    @if (r.Status == "paid")           { <span class="abadge abadge-green">Đã thanh toán</span> }
                                    else if (r.Status == "confirming") { <span class="abadge abadge-orange">Chờ duyệt</span> }
                                    else                               { <span class="abadge abadge-gray">Chưa trả</span> }
                                </td>
                                <td><span class="admin-sub">@(r.Provider ?? "—")</span></td>
                                <td><span class="admin-sub">@(r.PaidAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "—")</span></td>
                                <td>
                                    @if (r.Status != "paid")
                                    {
                                        <button class="aact-btn aact-approve" onclick="approvePay(@r.Id)"><i class="fa-solid fa-check"></i> Duyệt</button>
                                        <button class="aact-btn aact-reject" onclick="rejectPay(@r.Id)"><i class="fa-solid fa-xmark"></i></button>
                                    }
                                    @if (demoOn)
                                    {
                                        <button type="button" class="aact-btn aact-edit" title="Sửa đơn"
                                                onclick="openPayEdit(@r.Id, @((long)r.Amount), '@(r.PaidAt?.ToLocalTime().ToString("yyyy-MM-dd"))', '@r.PlanType', '@r.Code', '@(r.StoredKind)')">
                                            <i class="fa-solid fa-pen"></i>
                                        </button>
                                    }
                                    else if (r.Status == "paid")
                                    {
                                        <span class="admin-sub">—</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
.pay-edit { position:relative; display:inline-block; }
.pay-edit > summary { list-style:none; cursor:pointer; }
.pay-edit > summary::-webkit-details-marker { display:none; }
.pay-edit-pop { position:absolute; right:0; top:110%; z-index:60; width:210px; background:#fff;
  border:1px solid var(--line,#e2e8f0); border-radius:12px; box-shadow:0 12px 30px rgba(15,23,42,.18); padding:.75rem; }
.pay-edit[open] > summary { outline:2px solid var(--accent,#0891B2); }
.btn-sm { padding:.35rem .7rem; border-radius:8px; font-size:.82rem; font-weight:700; border:none; cursor:pointer; }
.rv-modal { position:fixed; inset:0; background:rgba(15,23,42,.5); display:flex; align-items:center; justify-content:center; z-index:1080; padding:1rem; }
.rv-modal-card { background:#fff; border-radius:18px; max-width:380px; width:100%; padding:1.6rem 1.5rem; text-align:center; box-shadow:0 20px 60px rgba(0,0,0,.25); }
.rv-modal-icon { font-size:2.4rem; line-height:1; margin-bottom:.5rem; }
.rv-modal-title { font-weight:800; font-size:1.1rem; margin:0 0 .4rem; color:#1e293b; }
.rv-modal-msg { color:#64748b; font-size:.88rem; margin:0 0 1.3rem; line-height:1.55; }
.rv-modal-actions { display:flex; gap:.6rem; }
.rv-btn { flex:1; padding:.62rem 1rem; border-radius:10px; font-weight:700; font-size:.88rem; cursor:pointer; border:1px solid transparent; }
.rv-btn-ghost { background:#fff; border-color:#e2e8f0; color:#475569; }
.rv-btn-ghost:hover { background:#f8fafc; }
.rv-btn-primary { background:#16a34a; color:#fff; }
.rv-btn-danger { background:#ef4444; color:#fff; }
.rv-btn:disabled { opacity:.6; cursor:default; }
.rv-toast { position:fixed; bottom:1.5rem; left:50%; transform:translateX(-50%); background:#0f172a; color:#fff; padding:.7rem 1.2rem; border-radius:10px; font-size:.9rem; z-index:1090; box-shadow:0 8px 24px rgba(0,0,0,.25); }
.rv-toast.ok { background:#16a34a; }
.rv-toast.err { background:#dc2626; }
</style>

<div id="rvConfirm" class="rv-modal" style="display:none" onclick="if(event.target===this)rvCloseModal()">
    <div class="rv-modal-card">
        <div class="rv-modal-icon" id="rvModalIcon"><i class="fa-solid fa-circle-question"></i></div>
        <h4 class="rv-modal-title" id="rvModalTitle">Xác nhận</h4>
        <p class="rv-modal-msg" id="rvModalMsg"></p>
        <div class="rv-modal-actions">
            <button type="button" class="rv-btn rv-btn-ghost" onclick="rvCloseModal()">Hủy</button>
            <button type="button" class="rv-btn rv-btn-primary" id="rvModalOk">Xác nhận</button>
        </div>
    </div>
</div>
<div id="rvToast" class="rv-toast" style="display:none"></div>

<!-- Modal sửa đơn (nổi giữa màn hình, không bị bảng che) -->
<div id="payEditModal" class="rv-modal" style="display:none" onclick="if(event.target===this)closePayEdit()">
    <div class="rv-modal-card" style="text-align:left;max-width:360px">
        <h4 class="rv-modal-title" style="margin-bottom:1rem">Sửa đơn <span id="peCode" style="color:var(--accent,#0891B2)"></span></h4>
        <form method="post" action="/Admin/EditPayment" class="d-flex flex-column gap-2">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" id="peId">
            <label class="fw-semibold small mb-0">Số tiền (đ)</label>
            <input type="number" name="amount" id="peAmount" min="0" step="1000" class="form-control">
            <label class="fw-semibold small mb-0">Ngày trả</label>
            <input type="date" name="paidDate" id="peDate" class="form-control">
            <label class="fw-semibold small mb-0">Gói</label>
            <select name="planType" id="pePlan" class="form-select">
                <option value="month">1 tháng</option>
                <option value="year">1 năm</option>
            </select>
            <label class="fw-semibold small mb-0">Loại đơn</label>
            <select name="kind" id="peKind" class="form-select">
                <option value="">Tự động (theo thứ tự mua)</option>
                <option value="new">Đăng ký mới</option>
                <option value="renewal">Gia hạn</option>
            </select>
            <div class="d-flex gap-2 mt-3">
                <button type="button" class="rv-btn rv-btn-ghost" onclick="closePayEdit()">Hủy</button>
                <button type="submit" formaction="/Admin/DeletePayment" class="rv-btn rv-btn-ghost" style="flex:0 0 auto;color:#b91c1c"
                        onclick="return confirm('Xóa hẳn đơn này?')"><i class="fa-solid fa-trash"></i></button>
                <button type="submit" class="rv-btn rv-btn-primary" style="flex:1">Lưu</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/apexcharts@3.49.0/dist/apexcharts.min.js"></script>
<script>
(function () {
    // Animated counters do site.js xử lý chung (.kpi-num[data-count])
    const ink = '#64748B', accent = '#0891B2';
    const trendData = @Html.Raw(ViewBag.TrendData ?? "[]");
    const trendLabels = @Html.Raw(ViewBag.TrendLabels ?? "[]");
    const chData = @Html.Raw(ViewBag.ChannelData ?? "[]");
    const chLabels = @Html.Raw(ViewBag.ChannelLabels ?? "[]");

    if (window.ApexCharts) {
        new ApexCharts(document.querySelector('#revTrend'), {
            chart: { type: 'area', height: 300, toolbar: { show: false }, fontFamily: 'Inter, sans-serif', animations: { speed: 600 } },
            series: [{ name: 'Doanh thu', data: trendData }],
            xaxis: { categories: trendLabels, labels: { style: { colors: ink } }, axisBorder: { show: false }, axisTicks: { show: false } },
            yaxis: { labels: { style: { colors: ink }, formatter: v => (v >= 1e6 ? (v/1e6).toFixed(1)+'tr' : (v/1e3).toFixed(0)+'k') } },
            colors: [accent],
            stroke: { curve: 'smooth', width: 3 },
            fill: { type: 'gradient', gradient: { shadeIntensity: 1, opacityFrom: 0.35, opacityTo: 0.02 } },
            grid: { borderColor: '#EEF2F6', strokeDashArray: 4 },
            dataLabels: { enabled: false },
            tooltip: { y: { formatter: v => v.toLocaleString('vi-VN') + 'đ' } }
        }).render();

        new ApexCharts(document.querySelector('#revChannel'), {
            chart: { type: 'donut', height: 300, fontFamily: 'Inter, sans-serif' },
            series: chData.length ? chData : [1],
            labels: chLabels.length ? chLabels : ['Chưa có'],
            colors: ['#0891B2', '#F59E0B', '#38BDF8', '#10B981'],
            legend: { position: 'bottom', labels: { colors: ink } },
            stroke: { width: 0 },
            plotOptions: { pie: { donut: { size: '68%', labels: { show: true, total: { show: true, label: 'Tổng đơn', color: ink } } } } },
            dataLabels: { enabled: true, formatter: (v) => v.toFixed(0) + '%' },
            tooltip: { y: { formatter: v => v.toLocaleString('vi-VN') + 'đ' } }
        }).render();
    }
})();

// Duyệt / từ chối thanh toán — modal xác nhận TRÊN WEB (không dùng confirm/alert của trình duyệt)
const _tok = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
let _rvAction = null;

function rvCloseModal() { document.getElementById('rvConfirm').style.display = 'none'; _rvAction = null; }
function rvToast(msg, type) {
    const t = document.getElementById('rvToast');
    t.textContent = msg; t.className = 'rv-toast ' + (type || '');
    t.style.display = 'block';
    clearTimeout(t._t); t._t = setTimeout(() => t.style.display = 'none', 3000);
}
function rvOpenModal(opt) {
    document.getElementById('rvModalTitle').textContent = opt.title;
    document.getElementById('rvModalMsg').textContent = opt.msg;
    const ic = document.getElementById('rvModalIcon');
    ic.innerHTML = '<i class="fa-solid ' + opt.icon + '"></i>'; ic.style.color = opt.iconColor;
    const ok = document.getElementById('rvModalOk');
    ok.textContent = opt.okText; ok.className = 'rv-btn ' + opt.okClass; ok.disabled = false;
    _rvAction = opt.onOk;
    document.getElementById('rvConfirm').style.display = 'flex';
}
document.getElementById('rvModalOk').addEventListener('click', async function () {
    if (!_rvAction) return;
    this.disabled = true; const old = this.textContent; this.textContent = 'Đang xử lý…';
    try { await _rvAction(); } finally { this.textContent = old; }
});
document.addEventListener('keydown', e => { if (e.key === 'Escape') { rvCloseModal(); closePayEdit(); } });

// Modal sửa đơn
function openPayEdit(id, amount, date, plan, code, kind) {
    document.getElementById('peId').value = id;
    document.getElementById('peAmount').value = amount;
    document.getElementById('peDate').value = date || '';
    document.getElementById('pePlan').value = (plan === 'year') ? 'year' : 'month';
    document.getElementById('peKind').value = (kind === 'new' || kind === 'renewal') ? kind : '';
    document.getElementById('peCode').textContent = code || '';
    document.getElementById('payEditModal').style.display = 'flex';
}
function closePayEdit() { document.getElementById('payEditModal').style.display = 'none'; }

async function _rvPost(url, id) {
    const fd = new FormData(); fd.append('id', id); fd.append('__RequestVerificationToken', _tok);
    const r = await fetch(url, { method: 'POST', body: fd });
    return r.json();
}
function approvePay(id) {
    rvOpenModal({
        title: 'Duyệt thanh toán này?',
        msg: 'Bạn chắc chắn đã nhận được tiền? Sau khi duyệt, đơn sẽ tính vào doanh thu và tài khoản được kích hoạt Pro.',
        okText: 'Duyệt & lên Pro', okClass: 'rv-btn-primary', icon: 'fa-circle-check', iconColor: '#16a34a',
        onOk: async () => {
            const d = await _rvPost('/Payments/Approve', id);
            if (d.ok) { rvToast('Đã duyệt — tài khoản đã lên Pro!', 'ok'); setTimeout(() => location.reload(), 900); }
            else { rvCloseModal(); rvToast('Lỗi: ' + (d.msg || 'không duyệt được'), 'err'); }
        }
    });
}
function rejectPay(id) {
    rvOpenModal({
        title: 'Từ chối giao dịch này?',
        msg: 'Đánh dấu giao dịch là từ chối. Dùng khi người dùng chưa thực sự chuyển tiền.',
        okText: 'Từ chối', okClass: 'rv-btn-danger', icon: 'fa-circle-xmark', iconColor: '#dc2626',
        onOk: async () => {
            const d = await _rvPost('/Payments/Reject', id);
            if (d.ok) { rvToast('Đã từ chối giao dịch.', 'ok'); setTimeout(() => location.reload(), 900); }
            else { rvCloseModal(); rvToast('Lỗi: ' + (d.msg || ''), 'err'); }
        }
    });
}
</script>
}
