@model IEnumerable<MapHub.Models.Place>
@{
    ViewData["Title"] = "Admin – Địa điểm";
    string? filter = ViewBag.Filter as string;
    // Đếm theo toàn bộ bảng (ViewBag) — không phụ thuộc tab đang lọc
    int total    = ViewBag.CountAll     ?? Model.Count();
    int pending  = ViewBag.CountPending ?? 0;
    int pub      = ViewBag.CountPublic  ?? 0;
    int priv     = ViewBag.CountPrivate ?? 0;
}

<partial name="_AdminNav" />

<div class="admin-page">

    <div class="admin-section-header">
        <div>
            <h2 class="admin-section-title"><i class="fa-solid fa-location-dot"></i> Quản lý Địa điểm</h2>
            <p class="admin-section-sub">@total địa điểm</p>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <form method="post" action="/Admin/SeedReviews" class="d-inline"
                  onsubmit="return confirm('Tạo đánh giá mẫu (tối thiểu 10/địa điểm) cho các địa điểm còn thiếu? Dữ liệu demo, không phải từ Google.');">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn-ghost"><i class="bi bi-star"></i> Tạo đánh giá mẫu</button>
            </form>
            <a href="/Admin/ImportPlaces" class="btn-ghost"><i class="bi bi-file-earmark-excel"></i> Nhập Excel</a>
            <a href="/Admin/AddPlace" class="btn-accent">＋ Thêm địa điểm</a>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(TempData["Success"]?.ToString()))
    {
        <div class="admin-alert admin-alert-success">✅ @TempData["Success"]</div>
    }
    @if (!string.IsNullOrEmpty(TempData["Error"]?.ToString()))
    {
        <div class="admin-alert" style="background:#fef2f2;color:#b91c1c;border:1px solid #fecaca">@TempData["Error"]</div>
    }

    <!-- Filter tabs -->
    <div class="admin-filter-tabs">
        <a href="/Admin/Places"                  class="admin-filter-tab @(filter == null     ? "active" : "")">Tất cả <span class="afc">@total</span></a>
        <a href="/Admin/Places?filter=pending"   class="admin-filter-tab @(filter == "pending" ? "active" : "")">⏳ Chờ duyệt <span class="afc afc-warn">@pending</span></a>
        <a href="/Admin/Places?filter=public"    class="admin-filter-tab @(filter == "public"  ? "active" : "")">🌐 Công khai <span class="afc">@pub</span></a>
        <a href="/Admin/Places?filter=private"   class="admin-filter-tab @(filter == "private" ? "active" : "")">🔒 Cá nhân <span class="afc">@priv</span></a>
    </div>

    @if (!Model.Any())
    {
        <div class="plans-empty">
            <div class="plans-empty-icon">📍</div>
            <h5>Không có địa điểm nào</h5>
        </div>
    }
    else
    {
        <div class="admin-bulkbar" id="bulkBar">
            <span class="abulk-count"><strong id="bulkN">0</strong> đã chọn</span>
            <button type="button" class="aact-btn aact-del" style="width:auto;padding:.4rem .9rem" onclick="bulkDelete()">
                <i class="fa-solid fa-trash"></i> Xóa đã chọn
            </button>
        </div>
        <form method="post" action="/Admin/DeletePlaces" id="bulkForm" class="d-none">
            @Html.AntiForgeryToken()
            <input type="hidden" name="filter" value="@filter">
            <div id="bulkIds"></div>
        </form>
        <div class="admin-table-wrap">
            <table class="admin-table">
                <thead>
                    <tr>
                        <th style="width:34px"><input type="checkbox" id="chkAll" title="Chọn tất cả"></th>
                        <th>Địa điểm</th>
                        <th>Danh mục</th>
                        <th>Người tạo</th>
                        <th>Trạng thái</th>
                        <th>Quyền xem</th>
                        <th>Hành động</th>
                    </tr>
                </thead>
                <tbody>
                    @{
                    var catVi = new Dictionary<string,(string L,string C)>(StringComparer.OrdinalIgnoreCase){
                        ["restaurant"]=("Nhà hàng","acat-restaurant"),["cafe"]=("Cà phê","acat-cafe"),
                        ["entertainment"]=("Vui chơi","acat-entertainment"),["culture"]=("Văn hóa","acat-culture"),
                        ["temple"]=("Tâm linh","acat-temple"),["nature"]=("Thiên nhiên","acat-nature"),
                        ["education"]=("Giáo dục","acat-education"),["hotel"]=("Lưu trú","acat-hotel")
                    };
                }
                @foreach (var p in Model)
                    {
                        var (cL,cC) = catVi.TryGetValue(p.Category??"",out var cv2)?cv2:(p.Category??"Khác","");
                        <tr class="@(!p.IsApproved && p.Visibility == "public" ? "admin-row-warn" : "")">
                            <td><input type="checkbox" class="chkRow" name="ids" value="@p.Id"></td>
                            <td>
                                <div style="display:flex;align-items:center;gap:.6rem">
                                    @{ var img = p.Images.FirstOrDefault()?.Url; }
                                    @if (!string.IsNullOrEmpty(img))
                                    { <img src="@img" style="width:40px;height:40px;border-radius:8px;object-fit:cover;flex-shrink:0"> }
                                    <div>
                                        <a href="/Map/Details/@p.Id" class="admin-place-link">@p.Name</a>
                                        @if (!string.IsNullOrEmpty(p.Address))
                                        { <div class="admin-sub"><i class="fa-solid fa-location-dot" style="color:#ef4444"></i> @p.Address</div> }
                                    </div>
                                </div>
                            </td>
                            <td><span class="admin-cat-badge @cC">@cL</span></td>
                            <td><span class="admin-sub">@(p.CreatedByUserId?.Length > 8 ? p.CreatedByUserId[..8] + "…" : (p.CreatedByUserId ?? "—"))</span></td>
                            <td>
                                @if (p.IsApproved) { <span class="abadge abadge-green"><i class="fa-solid fa-circle-check"></i> Đã duyệt</span> }
                                else               { <span class="abadge abadge-orange"><i class="fa-solid fa-hourglass-half"></i> Chờ duyệt</span> }
                            </td>
                            <td>
                                @if (p.Visibility == "public") { <span class="abadge abadge-blue"><i class="fa-solid fa-globe"></i> Công khai</span> }
                                else                           { <span class="abadge abadge-gray"><i class="fa-solid fa-lock"></i> Cá nhân</span> }
                            </td>
                            <td>
                                <div class="admin-actions">
                                    <a href="/Map/Details/@p.Id"     class="aact-btn aact-view" title="Xem"><i class="fa-solid fa-eye"></i></a>
                                    <a href="/Admin/EditPlace/@p.Id"  class="aact-btn aact-edit" title="Sửa"><i class="fa-solid fa-pen"></i></a>
                                    <form method="post" action="/Admin/ToggleFeaturedPlace" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@p.Id">
                                        <button type="submit" class="aact-btn aact-star @(p.IsFeatured?"aact-star-on":"")" title="Nổi bật">
                                            <i class="bi @(p.IsFeatured?"bi-star-fill":"bi-star")"></i>
                                        </button>
                                    </form>
                                    @if (!p.IsApproved && p.Visibility == "public")
                                    {
                                        <form method="post" action="/Admin/ApprovePlace" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@p.Id">
                                            <button type="submit" class="aact-btn aact-approve"><i class="fa-solid fa-check"></i> Duyệt</button>
                                        </form>
                                        <form method="post" action="/Admin/RejectPlace" class="d-inline"
                                              onsubmit="return confirm('Từ chối và xóa địa điểm này?')">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@p.Id">
                                            <button type="submit" class="aact-btn aact-reject"><i class="fa-solid fa-xmark"></i> Từ chối</button>
                                        </form>
                                    }
                                    <form method="post" action="/Admin/DeletePlace" class="d-inline"
                                          onsubmit="return confirm('Xóa vĩnh viễn địa điểm &quot;@p.Name&quot;?')">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@p.Id">
                                        <button type="submit" class="aact-btn aact-del" title="Xóa"><i class="fa-solid fa-trash"></i></button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@section Scripts {
<script>
(function () {
    const chkAll = document.getElementById('chkAll');
    const rows = Array.from(document.querySelectorAll('.chkRow'));
    const bar = document.getElementById('bulkBar');
    const n = document.getElementById('bulkN');
    function refresh() {
        const sel = rows.filter(c => c.checked);
        n.textContent = sel.length;
        bar.classList.toggle('show', sel.length > 0);
        if (chkAll) chkAll.checked = sel.length > 0 && sel.length === rows.length;
    }
    if (chkAll) chkAll.addEventListener('change', () => { rows.forEach(c => c.checked = chkAll.checked); refresh(); });
    rows.forEach(c => c.addEventListener('change', refresh));
    window.bulkDelete = function () {
        const ids = rows.filter(c => c.checked).map(c => c.value);
        if (!ids.length) return;
        if (!confirm('Xóa ' + ids.length + ' địa điểm đã chọn?')) return;
        const box = document.getElementById('bulkIds');
        box.innerHTML = ids.map(id => '<input type="hidden" name="ids" value="' + id + '">').join('');
        document.getElementById('bulkForm').submit();
    };
    refresh();
})();
</script>
}
