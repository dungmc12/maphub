@model IEnumerable<MapHub.Models.Place>
@{
    ViewData["Title"] = "Admin Dashboard";
    int pendingCount = (int)(ViewBag.PendingCount ?? 0);
    int totalPlaces  = (int)(ViewBag.TotalPlaces  ?? 0);
    int totalEvents  = (int)(ViewBag.TotalEvents  ?? 0);
    int totalUsers   = (int)(ViewBag.TotalUsers   ?? 0);
}

<partial name="_AdminNav" />

<div class="admin-page">

    <!-- Stats -->
    <div class="admin-stats-row">
        <div class="astat astat-orange">
            <div class="astat-icon"><i class="fa-solid fa-hourglass-half"></i></div>
            <div class="astat-body">
                <div class="astat-num">@pendingCount</div>
                <div class="astat-label">Chờ duyệt</div>
            </div>
        </div>
        <div class="astat astat-blue">
            <div class="astat-icon"><i class="fa-solid fa-location-dot"></i></div>
            <div class="astat-body">
                <div class="astat-num">@totalPlaces</div>
                <div class="astat-label">Địa điểm</div>
            </div>
        </div>
        <div class="astat astat-green">
            <div class="astat-icon"><i class="fa-solid fa-calendar-day"></i></div>
            <div class="astat-body">
                <div class="astat-num">@totalEvents</div>
                <div class="astat-label">Sự kiện</div>
            </div>
        </div>
        <div class="astat astat-purple">
            <div class="astat-icon"><i class="fa-solid fa-users"></i></div>
            <div class="astat-body">
                <div class="astat-num">@totalUsers</div>
                <div class="astat-label">Người dùng</div>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(TempData["Success"]?.ToString()))
    {
        <div class="admin-alert admin-alert-success">✅ @TempData["Success"]</div>
    }

    @{
        var pendingPay = ViewBag.PendingPayments as IEnumerable<dynamic> ?? Enumerable.Empty<dynamic>();
        var pendingPayList = pendingPay.ToList();
    }
    @if (pendingPayList.Any())
    {
        <div class="admin-section-header mt-4">
            <h2 class="admin-section-title">💳 Thanh toán chờ duyệt <span class="admin-badge-warn">@pendingPayList.Count</span></h2>
        </div>
        <div class="table-responsive mb-4">
            <table class="admin-table">
                <thead><tr><th>Email</th><th>Gói</th><th>Số tiền</th><th>Mã CK</th><th>Mã GD ngân hàng</th><th>Thời gian</th><th>Thao tác</th></tr></thead>
                <tbody>
                @foreach (var p in pendingPayList)
                {
                    <tr id="payrow-@p.Id">
                        <td>@(p.Email ?? p.UserId)</td>
                        <td>@(p.PlanType == "year" ? "1 năm" : "1 tháng")</td>
                        <td>@(((decimal)p.Amount).ToString("#,##0"))đ</td>
                        <td><code>@p.Code</code></td>
                        <td><small class="text-muted">@(string.IsNullOrEmpty((string?)p.TransactionId) ? "—" : p.TransactionId)</small></td>
                        <td><small>@p.CreatedAt.ToString("dd/MM HH:mm")</small></td>
                        <td>
                            <button class="btn btn-sm btn-success me-1" onclick="approvePayment(@p.Id)">✅ Duyệt</button>
                            <button class="btn btn-sm btn-outline-danger" onclick="rejectPayment(@p.Id)">✗ Từ chối</button>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }

    <div class="admin-section-header">
        <div>
            <h2 class="admin-section-title">Địa điểm gần đây</h2>
            @if (pendingCount > 0)
            {
                <span class="admin-badge-warn">@pendingCount chờ duyệt</span>
            }
        </div>
        <a href="/Admin/AddPlace" class="btn-accent">＋ Thêm địa điểm</a>
    </div>

    <div class="admin-table-wrap">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>Địa điểm</th>
                    <th>Danh mục</th>
                    <th>Trạng thái</th>
                    <th>Quyền xem</th>
                    <th>Hành động</th>
                </tr>
            </thead>
            <tbody>
                @{
                    var catViMap = new Dictionary<string,(string L,string C)>(StringComparer.OrdinalIgnoreCase){
                        ["restaurant"]=("Nhà hàng","acat-restaurant"),["cafe"]=("Cà phê","acat-cafe"),
                        ["entertainment"]=("Vui chơi","acat-entertainment"),["culture"]=("Văn hóa","acat-culture"),
                        ["temple"]=("Tâm linh","acat-temple"),["nature"]=("Thiên nhiên","acat-nature"),
                        ["education"]=("Giáo dục","acat-education"),["hotel"]=("Lưu trú","acat-hotel")
                    };
                }
                @foreach (var p in Model)
                {
                    var (cLabel,cCls) = catViMap.TryGetValue(p.Category??"",out var cv)?cv:(p.Category??"Khác","");
                    <tr class="@(!p.IsApproved ? "admin-row-warn" : "")">
                        <td>
                            <a href="/Map/Details/@p.Id" class="admin-place-link">@p.Name</a>
                            @if (!string.IsNullOrEmpty(p.Address))
                            { <div class="admin-sub"><i class="fa-solid fa-location-dot" style="color:#ef4444"></i> @p.Address</div> }
                        </td>
                        <td><span class="admin-cat-badge @cCls">@cLabel</span></td>
                        <td>
                            @if (p.IsApproved) { <span class="abadge abadge-green"><i class="fa-solid fa-circle-check"></i> Đã duyệt</span> }
                            else               { <span class="abadge abadge-orange"><i class="fa-solid fa-hourglass-half"></i> Chờ duyệt</span> }
                        </td>
                        <td>
                            @if (p.Visibility == "public") { <span class="abadge abadge-blue"><i class="fa-solid fa-globe"></i> Công khai</span> }
                            else                           { <span class="abadge abadge-gray"><i class="fa-solid fa-lock"></i> Cá nhân</span> }
                        </td>
                        <td>
                            <div class="admin-actions">
                                <a href="/Map/Details/@p.Id"    class="aact-btn aact-view" title="Xem"><i class="fa-solid fa-eye"></i></a>
                                <a href="/Admin/EditPlace/@p.Id" class="aact-btn aact-edit" title="Sửa"><i class="fa-solid fa-pen"></i></a>
                                <form method="post" action="/Admin/ToggleFeaturedPlace" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@p.Id">
                                    <button type="submit" class="aact-btn aact-star @(p.IsFeatured ? "aact-star-on" : "")" title="@(p.IsFeatured?"Bỏ nổi bật":"Nổi bật")">
                                        <i class="bi @(p.IsFeatured?"bi-star-fill":"bi-star")"></i>
                                    </button>
                                </form>
                                @if (!p.IsApproved)
                                {
                                    <form method="post" action="/Admin/ApprovePlace" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@p.Id">
                                        <button type="submit" class="aact-btn aact-approve"><i class="fa-solid fa-check"></i> Duyệt</button>
                                    </form>
                                    <form method="post" action="/Admin/RejectPlace" class="d-inline"
                                          onsubmit="return confirm('Từ chối và xóa địa điểm này?')">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@p.Id">
                                        <button type="submit" class="aact-btn aact-reject"><i class="fa-solid fa-xmark"></i> Từ chối</button>
                                    </form>
                                }
                                <form method="post" action="/Admin/DeletePlace" class="d-inline"
                                      onsubmit="return confirm('Xóa vĩnh viễn địa điểm &quot;@p.Name&quot;?')">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@p.Id">
                                    <button type="submit" class="aact-btn aact-del" title="Xóa"><i class="fa-solid fa-trash"></i></button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
<script>
const _tok = document.querySelector('meta[name="RequestVerificationToken"]')?.content
    || document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';

async function approvePayment(id) {
    if (!confirm('Duyệt thanh toán này và kích hoạt Pro cho user?')) return;
    const fd = new FormData(); fd.append('id', id); fd.append('__RequestVerificationToken', _tok);
    const r = await fetch('/Payments/Approve', { method:'POST', body: fd });
    const d = await r.json();
    if (d.ok) { document.getElementById('payrow-' + id)?.remove(); alert('✅ Đã duyệt - user đã lên Pro!'); }
    else alert('Lỗi: ' + (d.msg||''));
}
async function rejectPayment(id) {
    if (!confirm('Từ chối thanh toán này?')) return;
    const fd = new FormData(); fd.append('id', id); fd.append('__RequestVerificationToken', _tok);
    const r = await fetch('/Payments/Reject', { method:'POST', body: fd });
    const d = await r.json();
    if (d.ok) { document.getElementById('payrow-' + id)?.remove(); }
    else alert('Lỗi: ' + (d.msg||''));
}
</script>
}
