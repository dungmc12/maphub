@model IEnumerable<MapHub.Models.Place>
@{
    ViewData["Title"] = "Admin Dashboard";
    int pendingCount = (int)(ViewBag.PendingCount ?? 0);
    int totalPlaces  = (int)(ViewBag.TotalPlaces  ?? 0);
    int totalEvents  = (int)(ViewBag.TotalEvents  ?? 0);
    int totalUsers   = (int)(ViewBag.TotalUsers   ?? 0);
}

<partial name="_AdminNav" />

<div class="admin-page">

    <!-- Stats -->
    <div class="admin-stats-row">
        <div class="astat astat-orange">
            <div class="astat-icon"><i class="bi bi-hourglass-split"></i></div>
            <div class="astat-body">
                <div class="astat-num">@pendingCount</div>
                <div class="astat-label">Chờ duyệt</div>
            </div>
        </div>
        <div class="astat astat-blue">
            <div class="astat-icon"><i class="bi bi-geo-alt-fill"></i></div>
            <div class="astat-body">
                <div class="astat-num">@totalPlaces</div>
                <div class="astat-label">Địa điểm</div>
            </div>
        </div>
        <div class="astat astat-green">
            <div class="astat-icon"><i class="bi bi-calendar-event-fill"></i></div>
            <div class="astat-body">
                <div class="astat-num">@totalEvents</div>
                <div class="astat-label">Sự kiện</div>
            </div>
        </div>
        <div class="astat astat-purple">
            <div class="astat-icon"><i class="bi bi-people-fill"></i></div>
            <div class="astat-body">
                <div class="astat-num">@totalUsers</div>
                <div class="astat-label">Người dùng</div>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(TempData["Success"]?.ToString()))
    {
        <div class="admin-alert admin-alert-success">✅ @TempData["Success"]</div>
    }

    <div class="admin-section-header">
        <div>
            <h2 class="admin-section-title">Địa điểm gần đây</h2>
            @if (pendingCount > 0)
            {
                <span class="admin-badge-warn">@pendingCount chờ duyệt</span>
            }
        </div>
        <a href="/Admin/AddPlace" class="btn-accent">＋ Thêm địa điểm</a>
    </div>

    <div class="admin-table-wrap">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>Địa điểm</th>
                    <th>Danh mục</th>
                    <th>Trạng thái</th>
                    <th>Quyền xem</th>
                    <th>Hành động</th>
                </tr>
            </thead>
            <tbody>
                @{
                    var catViMap = new Dictionary<string,(string L,string C)>(StringComparer.OrdinalIgnoreCase){
                        ["restaurant"]=("Nhà hàng","acat-restaurant"),["cafe"]=("Cà phê","acat-cafe"),
                        ["entertainment"]=("Vui chơi","acat-entertainment"),["culture"]=("Văn hóa","acat-culture"),
                        ["temple"]=("Tâm linh","acat-temple"),["nature"]=("Thiên nhiên","acat-nature"),
                        ["education"]=("Giáo dục","acat-education"),["hotel"]=("Lưu trú","acat-hotel")
                    };
                }
                @foreach (var p in Model)
                {
                    var (cLabel,cCls) = catViMap.TryGetValue(p.Category??"",out var cv)?cv:(p.Category??"Khác","");
                    <tr class="@(!p.IsApproved ? "admin-row-warn" : "")">
                        <td>
                            <a href="/Map/Details/@p.Id" class="admin-place-link">@p.Name</a>
                            @if (!string.IsNullOrEmpty(p.Address))
                            { <div class="admin-sub"><i class="bi bi-geo-alt" style="color:#ef4444"></i> @p.Address</div> }
                        </td>
                        <td><span class="admin-cat-badge @cCls">@cLabel</span></td>
                        <td>
                            @if (p.IsApproved) { <span class="abadge abadge-green"><i class="bi bi-check-circle-fill"></i> Đã duyệt</span> }
                            else               { <span class="abadge abadge-orange"><i class="bi bi-hourglass-split"></i> Chờ duyệt</span> }
                        </td>
                        <td>
                            @if (p.Visibility == "public") { <span class="abadge abadge-blue"><i class="bi bi-globe2"></i> Công khai</span> }
                            else                           { <span class="abadge abadge-gray"><i class="bi bi-lock-fill"></i> Cá nhân</span> }
                        </td>
                        <td>
                            <div class="admin-actions">
                                <a href="/Map/Details/@p.Id"    class="aact-btn aact-view" title="Xem"><i class="bi bi-eye-fill"></i></a>
                                <a href="/Admin/EditPlace/@p.Id" class="aact-btn aact-edit" title="Sửa"><i class="bi bi-pencil-fill"></i></a>
                                <form method="post" action="/Admin/ToggleFeaturedPlace" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@p.Id">
                                    <button type="submit" class="aact-btn aact-star @(p.IsFeatured ? "aact-star-on" : "")" title="@(p.IsFeatured?"Bỏ nổi bật":"Nổi bật")">
                                        <i class="bi @(p.IsFeatured?"bi-star-fill":"bi-star")"></i>
                                    </button>
                                </form>
                                @if (!p.IsApproved)
                                {
                                    <form method="post" action="/Admin/ApprovePlace" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@p.Id">
                                        <button type="submit" class="aact-btn aact-approve"><i class="bi bi-check-lg"></i> Duyệt</button>
                                    </form>
                                    <form method="post" action="/Admin/RejectPlace" class="d-inline"
                                          onsubmit="return confirm('Từ chối và xóa địa điểm này?')">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@p.Id">
                                        <button type="submit" class="aact-btn aact-reject"><i class="bi bi-x-lg"></i> Từ chối</button>
                                    </form>
                                }
                                <form method="post" action="/Admin/DeletePlace" class="d-inline"
                                      onsubmit="return confirm('Xóa vĩnh viễn địa điểm &quot;@p.Name&quot;?')">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@p.Id">
                                    <button type="submit" class="aact-btn aact-del" title="Xóa"><i class="bi bi-trash3-fill"></i></button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
