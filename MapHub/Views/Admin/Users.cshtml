@model IEnumerable<MapHub.Data.ApplicationUser>
@{
    ViewData["Title"] = "Admin – Người dùng";
    var userRoles   = (Dictionary<string, IList<string>>)ViewBag.UserRoles;
    var placeCounts = (Dictionary<string, int>)ViewBag.PlaceCounts;
    var proUserIds   = ViewBag.ProUserIds   as HashSet<string> ?? new HashSet<string>();
    var adminUserIds = ViewBag.AdminUserIds as HashSet<string> ?? new HashSet<string>();
    var lockedUserIds = ViewBag.LockedUserIds as HashSet<string> ?? new HashSet<string>();
    var lockReasons   = ViewBag.LockReasons   as Dictionary<string, string> ?? new Dictionary<string, string>();
    string? q = ViewBag.Q as string;
    string? currentUserId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
}

<partial name="_AdminNav" />

<div class="admin-page">

    <div class="admin-section-header">
        <div>
            <h2 class="admin-section-title">👥 Quản lý Người dùng</h2>
            <p class="admin-section-sub">@Model.Count() tài khoản</p>
        </div>
        <form method="get" action="/Admin/Users" class="admin-search-form">
            <input type="text" name="q" value="@q" class="admin-search-input" placeholder="🔍 Tìm theo email…">
            <button type="submit" class="btn-accent btn-sm-accent">Tìm</button>
            @if (!string.IsNullOrEmpty(q))
            {
                <a href="/Admin/Users" class="btn-ghost btn-sm-ghost">✕ Xóa lọc</a>
            }
        </form>
    </div>

    @if (!string.IsNullOrEmpty(TempData["Success"]?.ToString()))
    {
        <div class="admin-alert admin-alert-success">✅ @TempData["Success"]</div>
    }
    @if (!string.IsNullOrEmpty(TempData["Error"]?.ToString()))
    {
        <div class="admin-alert admin-alert-error">⚠️ @TempData["Error"]</div>
    }

    <div class="admin-table-wrap">
        <table class="admin-table">
            <thead>
                <tr>
                    <th>Tài khoản</th>
                    <th>Vai trò</th>
                    <th>Địa điểm</th>
                    <th>Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var u in Model)
                {
                    var roles = userRoles.TryGetValue(u.Id, out var r) ? r : new List<string>();
                    var placeCount = placeCounts.TryGetValue(u.Id, out var c) ? c : 0;
                    // Trạng thái thật = role HOẶC profile (để thấy đúng cả khi 2 nguồn lệch nhau)
                    var isAdmin = roles.Contains("Admin") || adminUserIds.Contains(u.Id);
                    var isPro   = roles.Contains("Pro")   || proUserIds.Contains(u.Id);
                    var isSelf  = u.Id == currentUserId;
                    var isLocked = lockedUserIds.Contains(u.Id);

                    <tr class="@(isSelf ? "admin-row-self" : "")" style="@(isLocked ? "opacity:.7" : "")">
                        <td>
                            <div class="admin-user-email">
                                @u.Email
                                @if (isSelf) { <span class="admin-self-tag">(bạn)</span> }
                                @if (isLocked) { <span class="abadge abadge-red" title="@(lockReasons.TryGetValue(u.Id, out var lr) ? lr : "")">🔒 Bị khóa</span> }
                            </div>
                            <div class="admin-sub">ID: @u.Id[..8]…</div>
                            @if (isLocked && lockReasons.TryGetValue(u.Id, out var reason))
                            {
                                <div class="admin-sub" style="color:#dc2626">Lý do: @reason</div>
                            }
                        </td>
                        <td>
                            @if (isAdmin)
                            {
                                <span class="abadge abadge-red">👑 Admin</span>
                            }
                            else if (isPro)
                            {
                                <span class="abadge abadge-gold"><i class="bi bi-lightning-charge-fill"></i> Pro</span>
                            }
                            else
                            {
                                <span class="abadge abadge-gray"><i class="bi bi-person-fill"></i> Người dùng</span>
                            }
                        </td>
                        <td>
                            <span class="admin-place-count"><i class="bi bi-geo-alt" style="color:#94a3b8"></i> @placeCount địa điểm</span>
                        </td>
                        <td>
                            <div class="admin-actions" style="flex-wrap:wrap">
                                @if (!isSelf)
                                {
                                    @if (!isPro && !isAdmin)
                                    {
                                        <form method="post" action="/Admin/SetRole" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="userId" value="@u.Id">
                                            <input type="hidden" name="role"   value="Pro">
                                            <button type="submit" class="aact-btn aact-pro"><i class="bi bi-lightning-charge-fill"></i> Cấp Pro</button>
                                        </form>
                                    }
                                    @if (isPro)
                                    {
                                        <form method="post" action="/Admin/SetRole" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="userId" value="@u.Id">
                                            <input type="hidden" name="role"   value="User">
                                            <button type="submit" class="aact-btn aact-reject"><i class="bi bi-lightning-slash"></i> Bỏ Pro</button>
                                        </form>
                                    }
                                    @if (!isAdmin)
                                    {
                                        <form method="post" action="/Admin/SetRole" class="d-inline"
                                              onsubmit="return confirm('Cấp quyền Admin cho @u.Email?')">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="userId" value="@u.Id">
                                            <input type="hidden" name="role"   value="Admin">
                                            <button type="submit" class="aact-btn aact-admin-grant"><i class="bi bi-shield-fill"></i> Admin</button>
                                        </form>
                                        <form method="post" action="/Admin/DeleteUser" class="d-inline"
                                              onsubmit="return confirm('Xóa tài khoản @u.Email? Hành động này không thể hoàn tác.')">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="userId" value="@u.Id">
                                            <button type="submit" class="aact-btn aact-del" title="Xóa tài khoản"><i class="bi bi-trash3-fill"></i></button>
                                        </form>
                                    }
                                    @if (isLocked)
                                    {
                                        <form method="post" action="/Admin/UnlockUser" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="userId" value="@u.Id">
                                            <button type="submit" class="aact-btn aact-pro" title="Mở khóa"><i class="bi bi-unlock-fill"></i> Mở khóa</button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form method="post" action="/Admin/LockUser" class="d-inline lock-form" onsubmit="return promptLock(this)">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="userId" value="@u.Id">
                                            <input type="hidden" name="reason" class="lock-reason">
                                            <button type="submit" class="aact-btn aact-reject" title="Khóa tài khoản"><i class="bi bi-lock-fill"></i> Khóa</button>
                                        </form>
                                    }
                                }
                                @if (isSelf)
                                {
                                    <span class="admin-sub">—</span>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
<script>
function promptLock(form) {
    const reason = prompt('Lý do khóa tài khoản này (người dùng sẽ thấy khi đăng nhập):', 'Vi phạm điều khoản sử dụng.');
    if (reason === null) return false;            // huỷ
    form.querySelector('.lock-reason').value = reason.trim();
    return true;
}
</script>
}
