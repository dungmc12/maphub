@model MapHub.Models.Event
@{
    ViewData["Title"] = "Admin – Tạo sự kiện";
    var defaultStart = DateTime.Now.ToString("yyyy-MM-ddTHH:mm");
}

<div class="container-xl py-4" style="max-width:760px">
    <a href="/Admin/Events" class="back-link">← Quản lý sự kiện</a>
    <h2 class="mt-3 mb-4">📅 Tạo Sự Kiện Mới</h2>

    <form method="post" action="/Admin/CreateEvent" enctype="multipart/form-data" class="needs-validation">
        @Html.AntiForgeryToken()

        <div class="info-card mb-3">
            <div class="row g-3">
                <div class="col-12">
                    <label class="form-label fw-semibold">Tên sự kiện *</label>
                    <input type="text" name="Title" class="form-control" required
                           placeholder="VD: Lễ hội Trung Thu Hà Nội 2026" value="@Model.Title">
                </div>
                <div class="col-12">
                    <label class="form-label fw-semibold">Mô tả</label>
                    <textarea name="Description" class="form-control" rows="3"
                              placeholder="Mô tả ngắn về sự kiện...">@Model.Description</textarea>
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Bắt đầu *</label>
                    <input type="datetime-local" name="StartAt" class="form-control" required
                           value="@defaultStart">
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Kết thúc <small class="text-muted">(để trống = không giới hạn)</small></label>
                    <input type="datetime-local" name="EndAt" class="form-control">
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Trạng thái</label>
                    <select name="Status" class="form-select">
                        <option value="upcoming">⏳ Sắp diễn ra</option>
                        <option value="ongoing">🟢 Đang diễn ra</option>
                        <option value="ended">✓ Đã kết thúc</option>
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Địa điểm liên quan</label>
                    <select name="PlaceId" class="form-select">
                        <option value="">— Không liên kết địa điểm —</option>
                        @if (ViewBag.Places != null)
                        {
                            foreach (var p in (dynamic)ViewBag.Places)
                            {
                                <option value="@p.Id">@p.Name</option>
                            }
                        }
                    </select>
                    <div class="form-text">Chọn để nút "Xem địa điểm" hiển thị trên trang chủ</div>
                </div>
                <div class="col-12">
                    <label class="form-label fw-semibold">Ảnh banner</label>
                    <input type="file" name="BannerFile" class="form-control mb-2" accept="image/*"
                           onchange="previewBanner(this)">
                    <img id="bannerPreview" src="" alt="" style="display:none;max-height:140px;border-radius:8px;margin-bottom:6px">
                    <input type="url" name="BannerImageUrl" class="form-control" placeholder="Hoặc dán URL ảnh: https://...">
                    <div class="form-text">Tải file lên hoặc nhập URL (file sẽ được ưu tiên)</div>
                </div>
                <div class="col-12">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="IsFeatured" value="true"
                               id="isFeatured">
                        <label class="form-check-label fw-semibold" for="isFeatured">
                            ⭐ Đánh dấu nổi bật (hiển thị trên trang chủ)
                        </label>
                    </div>
                </div>
            </div>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn-accent">💾 Tạo sự kiện</button>
            <a href="/Admin/Events" class="btn-ghost">Hủy</a>
        </div>
    </form>
</div>
@section Scripts {
<script>
function previewBanner(input) {
    const preview = document.getElementById('bannerPreview');
    if (input.files && input.files[0]) {
        const reader = new FileReader();
        reader.onload = e => { preview.src = e.target.result; preview.style.display = 'block'; };
        reader.readAsDataURL(input.files[0]);
    }
}
</script>
}
