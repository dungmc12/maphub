@model IEnumerable<MapHub.Models.Plan>
@functions {
    // Tổng quãng đường giữa các điểm liên tiếp (Haversine, km) — tính từ lat/lng sẵn có
    static double PlanDistanceKm(MapHub.Models.Plan plan)
    {
        var pts = plan.Items.Where(i => i.Place != null)
            .Select(i => (lat: (double)i.Place!.Latitude, lng: (double)i.Place!.Longitude)).ToList();
        double total = 0;
        for (int i = 1; i < pts.Count; i++)
        {
            double dLat = (pts[i].lat - pts[i-1].lat) * Math.PI / 180;
            double dLng = (pts[i].lng - pts[i-1].lng) * Math.PI / 180;
            double a = Math.Sin(dLat/2) * Math.Sin(dLat/2) +
                       Math.Cos(pts[i-1].lat * Math.PI/180) * Math.Cos(pts[i].lat * Math.PI/180) *
                       Math.Sin(dLng/2) * Math.Sin(dLng/2);
            total += 6371 * 2 * Math.Atan2(Math.Sqrt(a), Math.Sqrt(1-a));
        }
        return total;
    }
}
@{
    ViewData["Title"] = "Kế hoạch của tôi";
    bool isPro     = User.IsInRole("Admin") || User.IsInRole("Pro") || (bool)(ViewBag.IsPro ?? false);
    int  maxPlans  = (int)(ViewBag.MaxPlans ?? 3);
    int  planCount = Model?.Count() ?? 0;
    bool atLimit   = !isPro && planCount >= maxPlans;
}

<div class="container-xl py-4">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">
        <div>
            <h2 class="mb-0"><i class="fa-solid fa-calendar-week" style="color:#8b5cf6"></i> Kế hoạch chuyến đi</h2>
            @if (!isPro)
            {
                <p class="text-muted mt-1">Gói Free: @planCount / @maxPlans kế hoạch
                    — <a href="/Payments/Premium" style="color:#0891b2;font-weight:700">
                        <i class="fa-solid fa-bolt"></i> Nâng cấp Pro
                    </a> để tạo không giới hạn</p>
            }
        </div>
        <div class="d-flex gap-2 flex-wrap">
            @if (isPro)
            {
                <button class="btn-accent" onclick="openAiPlanModal()">
                    <i class="fa-solid fa-robot"></i> Tạo bằng AI
                </button>
            }
            @if (!atLimit)
            {
                <button class="btn-ghost" onclick="document.getElementById('createPlanModal').style.display='flex'">
                    ＋ Tạo kế hoạch mới
                </button>
            }
            else
            {
                <a href="/Payments/Premium" class="btn-ghost"><i class="fa-solid fa-lock"></i> Nâng cấp để tạo thêm</a>
            }
        </div>
    </div>

    <!-- Plan cards -->
    @if (Model != null && Model.Any())
    {
        <div class="plans-grid">
            @foreach (var plan in Model)
            {
                var firstImg = plan.Items.Select(i => i.Place).FirstOrDefault(p => p != null && p.Images.Any());
                var coverId  = firstImg?.Images.FirstOrDefault()?.Id;
                var km       = PlanDistanceKm(plan);
                var cost     = plan.Items.Sum(i => i.Place?.MinPrice ?? 0);
                int days     = (plan.StartDate.HasValue && plan.EndDate.HasValue)
                               ? (plan.EndDate.Value - plan.StartDate.Value).Days + 1
                               : Math.Max(1, plan.Items.Select(i => i.DayNumber).DefaultIfEmpty(1).Distinct().Count());
                <div class="plan-card2 reveal">
                    <a href="/Plans/Details/@plan.Id" class="plan-cover">
                        @if (coverId.HasValue)
                        {
                            <img src="/Map/Image/@coverId" alt="@plan.Title" loading="lazy"
                                 onerror="this.onerror=null;this.src='https://picsum.photos/seed/plan@(plan.Id)/600/360'">
                        }
                        else
                        {
                            <img src="https://picsum.photos/seed/plan@(plan.Id)/600/360" alt="@plan.Title" loading="lazy">
                        }
                        <span class="plan-cover-grad"></span>
                        @if (plan.IsPublic)
                        {
                            <span class="plan-cover-badge">Đang chia sẻ</span>
                        }
                        <div class="plan-cover-text">
                            <h3 class="plan-cover-title">@plan.Title</h3>
                            @if (plan.StartDate.HasValue)
                            {
                                <div class="plan-cover-date">@plan.StartDate.Value.ToString("dd/MM")@(plan.EndDate.HasValue ? " – " + plan.EndDate.Value.ToString("dd/MM/yyyy") : "")</div>
                            }
                        </div>
                    </a>
                    <div class="plan-card2-body">
                        <div class="plan-stats">
                            <div class="pstat"><b>@plan.Items.Count</b><span>địa điểm</span></div>
                            <div class="pstat"><b>@(km >= 1 ? km.ToString("0.#") : km.ToString("0.#"))<small>km</small></b><span>quãng đường</span></div>
                            <div class="pstat"><b>@days<small>ngày</small></b><span>thời lượng</span></div>
                            <div class="pstat"><b>@(cost > 0 ? (cost >= 1000 ? (cost/1000).ToString("0") + "k" : cost.ToString("0")) : "0")</b><span>ước tính (đ)</span></div>
                        </div>
                        @if (plan.Items.Any())
                        {
                            <div class="plan-items-preview">
                                @foreach (var item in plan.Items.Take(3))
                                {
                                    <span class="plan-item-chip">@item.Place?.Name</span>
                                }
                                @if (plan.Items.Count > 3)
                                {
                                    <span class="plan-item-chip plan-item-more">+@(plan.Items.Count - 3)</span>
                                }
                            </div>
                        }
                        <div class="plan-card2-actions">
                            <a href="/Plans/Details/@plan.Id" class="btn-accent btn-sm-accent">Xem chi tiết</a>
                            <form method="post" action="/Plans/ToggleShare" class="d-inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@plan.Id">
                                <button type="submit" class="btn-ghost btn-sm-ghost" title="@(plan.IsPublic ? "Tắt chia sẻ" : "Tạo link chia sẻ")">
                                    @Html.Raw(plan.IsPublic ? "<i class=\"fa-solid fa-link-slash\"></i>" : "<i class=\"fa-solid fa-share-nodes\"></i>")
                                </button>
                            </form>
                            <form method="post" action="/Plans/Delete" class="d-inline plan-del-form"
                                  onsubmit="return confirmPlanDelete(this)">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@plan.Id">
                                <button type="submit" class="btn-danger-ghost btn-sm-ghost" style="margin-left:auto"><i class="fa-solid fa-trash"></i></button>
                            </form>
                        </div>
                        @if (plan.IsPublic && !string.IsNullOrEmpty(plan.ShareToken))
                        {
                            <div class="plan-share-url">
                                <input type="text" readonly value="@($"{Context.Request.Scheme}://{Context.Request.Host}/Plans/Shared/{plan.ShareToken}")"
                                       onclick="this.select();document.execCommand('copy');showCopyMsg(this)">
                                <small class="text-muted">Click để sao chép link</small>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="plans-empty">
            <div class="plans-empty-icon"><i class="fa-solid fa-map"></i></div>
            <h4>Bạn chưa có kế hoạch nào</h4>
            <p>Tạo kế hoạch để lưu các địa điểm muốn ghé thăm và chia sẻ với bạn bè!</p>
            @if (!atLimit)
            {
                <button class="btn-accent" onclick="document.getElementById('createPlanModal').style.display='flex'">
                    ＋ Tạo kế hoạch đầu tiên
                </button>
            }
        </div>
    }
</div>

<!-- ── Create Plan Modal ─────────────────────────────────────────────────── -->
<div id="createPlanModal" class="custom-modal-overlay" style="display:none" onclick="if(event.target===this)this.style.display='none'">
    <div class="custom-modal-box">
        <div class="custom-modal-header">
            <h5><i class="fa-solid fa-clipboard-list"></i> Tạo kế hoạch mới</h5>
            <button onclick="document.getElementById('createPlanModal').style.display='none'"><i class="fa-solid fa-xmark"></i></button>
        </div>
        <form method="post" action="/Plans/Create" id="createPlanForm" onsubmit="return validatePlanDates()">
            @Html.AntiForgeryToken()
            <div class="custom-modal-body">
                <!-- Gợi ý nhanh tên kế hoạch (đồng bộ với modal AI) -->
                <div class="ai-prompt-row">
                    <span class="ai-prompt-label">Gợi ý</span>
                    <button type="button" class="ai-pchip" onclick="planNamePreset('Hà Nội cuối tuần')">Hà Nội cuối tuần</button>
                    <button type="button" class="ai-pchip" onclick="planNamePreset('Dã ngoại Hòa Lạc')">Dã ngoại Hòa Lạc</button>
                    <button type="button" class="ai-pchip" onclick="planNamePreset('Foodtour phố cổ')">Foodtour phố cổ</button>
                    <button type="button" class="ai-pchip" onclick="planNamePreset('Cà phê chill')">Cà phê chill</button>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Tên kế hoạch <span class="text-danger">*</span></label>
                    <input type="text" name="title" id="planTitleInput" class="form-control" required
                           placeholder="VD: Hà Nội cuối tuần, Dã ngoại Hòa Lạc...">
                </div>
                <div class="row g-2">
                    <div class="col-6">
                        <label class="form-label fw-semibold">Ngày khởi hành</label>
                        <input type="date" name="startDate" id="planStartDate" class="form-control"
                               onchange="updateEndDateMin()">
                    </div>
                    <div class="col-6">
                        <label class="form-label fw-semibold">Ngày về</label>
                        <input type="date" name="endDate" id="planEndDate" class="form-control">
                    </div>
                </div>
                <div id="dateError" class="text-danger small mt-1" style="display:none">
                    <i class="fa-solid fa-triangle-exclamation"></i> Ngày về phải sau hoặc bằng ngày khởi hành.
                </div>
            </div>
            <div class="custom-modal-footer">
                <button type="button" class="btn-ghost" onclick="document.getElementById('createPlanModal').style.display='none'">Hủy</button>
                <button type="submit" class="btn-accent">Tạo kế hoạch</button>
            </div>
        </form>
    </div>
</div>

<!-- ── AI Plan Modal (Pro only) ─────────────────────────────────────────── -->
@if (isPro)
{
    <div id="aiPlanModal" class="custom-modal-overlay" style="display:none" onclick="if(event.target===this)this.style.display='none'">
        <div class="custom-modal-box" style="width:min(680px,96vw);max-height:90vh;overflow-y:auto">
            <div class="custom-modal-header">
                <h5><i class="fa-solid fa-robot"></i> AI tạo kế hoạch</h5>
                <button onclick="document.getElementById('aiPlanModal').style.display='none'"><i class="fa-solid fa-xmark"></i></button>
            </div>
            <div class="custom-modal-body">
                <!-- Prompt suggestions -->
                <div class="ai-prompt-row">
                    <span class="ai-prompt-label">Gợi ý</span>
                    <button type="button" class="ai-pchip" onclick="aiPreset('lãng mạn, cà phê đẹp, ăn tối', 2, 1)">Hẹn hò cuối tuần</button>
                    <button type="button" class="ai-pchip" onclick="aiPreset('vui chơi, ăn uống, hợp trẻ em', 4, 1)">Đi với gia đình</button>
                    <button type="button" class="ai-pchip" onclick="aiPreset('cà phê yên tĩnh, chụp ảnh, dạo phố', 1, 1)">Đi một mình</button>
                    <button type="button" class="ai-pchip" onclick="aiPreset('hoạt động nhóm, ăn uống, giải trí', 10, 1)">Team building</button>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Bạn muốn khám phá đâu?</label>
                    <input type="text" id="aiDest" class="form-control" placeholder="VD: Hòa Lạc, Hồ Tây, Đồng Mô, Phố cổ...">
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Bạn thích trải nghiệm gì?</label>
                    <input type="text" id="aiInterests" class="form-control" placeholder="Chọn nhanh bên dưới hoặc tự nhập…">
                    <div class="ai-exp-chips">
                        <button type="button" class="ai-exp" onclick="aiAddInterest('cà phê')">☕ Cà phê</button>
                        <button type="button" class="ai-exp" onclick="aiAddInterest('check-in chụp ảnh')">📸 Check-in</button>
                        <button type="button" class="ai-exp" onclick="aiAddInterest('ăn uống')">🍜 Ăn uống</button>
                        <button type="button" class="ai-exp" onclick="aiAddInterest('giải trí')">🎵 Giải trí</button>
                        <button type="button" class="ai-exp" onclick="aiAddInterest('thiên nhiên')">🌳 Thiên nhiên</button>
                        <button type="button" class="ai-exp" onclick="aiAddInterest('văn hóa')">🏛️ Văn hóa</button>
                    </div>
                </div>
                <div class="row g-2 mb-3">
                    <div class="col-6">
                        <label class="form-label fw-semibold">Số ngày</label>
                        <input type="number" id="aiDays" class="form-control" value="1" min="1" max="7">
                    </div>
                    <div class="col-6">
                        <label class="form-label fw-semibold">Số người</label>
                        <input type="number" id="aiPeople" class="form-control" value="2" min="1" max="20">
                    </div>
                </div>
                <div id="aiPlanResult" class="ai-plan-result" style="display:none"></div>
                <div id="aiSaveRow" style="display:none;margin-top:.75rem">
                    <input type="text" id="aiPlanTitle" class="form-control form-control-sm mb-2"
                           placeholder="Tên kế hoạch (VD: Cắm trại Đồng Mô 3 ngày)">
                    <button type="button" class="btn-accent w-100" onclick="saveAiPlan()">
                        <i class="fa-solid fa-floppy-disk"></i> Lưu kế hoạch này
                    </button>
                    <div id="aiSaveMsg" style="display:none;margin-top:.5rem"></div>
                </div>
            </div>
            <div class="custom-modal-footer">
                <button type="button" class="btn-ghost" onclick="document.getElementById('aiPlanModal').style.display='none'">Đóng</button>
                <button type="button" id="btnAiGenerate" class="btn-accent" onclick="generateAiPlan()"><i class="fa-solid fa-robot"></i> Tạo lịch trình</button>
            </div>
        </div>
    </div>
}

@section Scripts {
<script>
// Mặc định ngày = hôm nay (giờ máy người dùng), không cho chọn quá khứ
(function initPlanDates() {
    const t = new Date();
    const today = t.getFullYear() + '-' +
        String(t.getMonth() + 1).padStart(2, '0') + '-' +
        String(t.getDate()).padStart(2, '0');
    const s = document.getElementById('planStartDate');
    const e = document.getElementById('planEndDate');
    if (s) { s.min = today; if (!s.value) s.value = today; }
    if (e) { e.min = today; if (!e.value) e.value = today; }
})();

function updateEndDateMin() {
    const start = document.getElementById('planStartDate');
    const end   = document.getElementById('planEndDate');
    if (start.value) {
        end.min = start.value;
        if (end.value && end.value < start.value) end.value = start.value;
    }
}

function validatePlanDates() {
    const startEl = document.getElementById('planStartDate');
    const start = startEl.value;
    const end   = document.getElementById('planEndDate').value;
    const err   = document.getElementById('dateError');
    if (start && startEl.min && start < startEl.min) {
        err.innerHTML = '<i class="fa-solid fa-triangle-exclamation"></i> Ngày khởi hành phải từ hôm nay trở đi.';
        err.style.display = 'block';
        return false;
    }
    if (start && end && end < start) {
        err.innerHTML = '<i class="fa-solid fa-triangle-exclamation"></i> Ngày về phải sau hoặc bằng ngày khởi hành.';
        err.style.display = 'block';
        return false;
    }
    err.style.display = 'none';
    return true;
}

function openAiPlanModal() {
    document.getElementById('aiPlanModal').style.display = 'flex';
}

// Xóa kế hoạch: fade card rồi mới submit (animation mượt)
function confirmPlanDelete(form) {
    if (!confirm('Xóa kế hoạch này?')) return false;
    const card = form.closest('.plan-card2');
    if (card) { card.style.transition = 'opacity .3s var(--ease), transform .3s var(--ease)'; card.style.opacity = '0'; card.style.transform = 'scale(.96)'; }
    setTimeout(() => form.submit(), 300);
    return false;
}

// Gợi ý nhanh tên kế hoạch (modal tạo thủ công)
function planNamePreset(name) {
    const inp = document.getElementById('planTitleInput');
    if (inp) { inp.value = name; inp.focus(); }
}

// Chip trải nghiệm → cộng dồn vào ô sở thích
function aiAddInterest(t) {
    const inp = document.getElementById('aiInterests');
    const cur = inp.value.split(',').map(s => s.trim()).filter(Boolean);
    if (!cur.includes(t)) cur.push(t);
    inp.value = cur.join(', ');
}
// Gợi ý nhanh → điền sở thích + số người + số ngày
function aiPreset(interests, people, days) {
    document.getElementById('aiInterests').value = interests;
    document.getElementById('aiPeople').value = people;
    document.getElementById('aiDays').value = days;
    document.getElementById('aiDest').focus();
}

// Loader AI dạng từng bước (cho cảm giác AI đang làm việc)
let _aiLoaderTimer = null;
function aiLoaderHTML() {
    return '<div class="ai-loader">' +
        '<div class="ai-loader-head"><span class="ai-loader-spin"></span> Trợ lý AI đang làm việc…</div>' +
        '<div class="ai-ls" data-i="0">Phân tích sở thích của bạn</div>' +
        '<div class="ai-ls" data-i="1">Tìm địa điểm phù hợp</div>' +
        '<div class="ai-ls" data-i="2">Ước tính chi phí</div>' +
        '<div class="ai-ls" data-i="3">Tạo lịch trình tối ưu</div></div>';
}
function startAiLoader() {
    const steps = document.querySelectorAll('#aiPlanResult .ai-ls');
    if (!steps.length) return;
    let i = 0;
    const tick = () => {
        steps.forEach((s, idx) => { s.classList.toggle('active', idx === i); s.classList.toggle('done', idx < i); });
        i = Math.min(i + 1, steps.length - 1);
    };
    tick();
    _aiLoaderTimer = setInterval(tick, 1400);
}
function stopAiLoader() { if (_aiLoaderTimer) { clearInterval(_aiLoaderTimer); _aiLoaderTimer = null; } }

async function generateAiPlan() {
    const dest   = document.getElementById('aiDest').value.trim();
    const days   = parseInt(document.getElementById('aiDays').value) || 1;
    const inter  = document.getElementById('aiInterests').value.trim();
    const people = parseInt(document.getElementById('aiPeople').value) || 2;
    const result = document.getElementById('aiPlanResult');

    if (!dest) { alert('Vui lòng nhập địa điểm muốn đến!'); return; }

    const genBtn = document.getElementById('btnAiGenerate');
    genBtn.disabled = true; genBtn.innerHTML = '<i class="fa-solid fa-hourglass-half"></i> Đang tạo…';
    document.getElementById('aiSaveRow').style.display = 'none';
    result.style.display = 'block';
    result.innerHTML = aiLoaderHTML();
    startAiLoader();

    try {
        const r = await fetch('/Plans/AiGenerate', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ destination: dest, days: days, interests: inter || 'ăn uống và vui chơi', people: people })
        });
        const d = await r.json();
        stopAiLoader();
        if (d.error) {
            result.innerHTML = `<div class="text-danger">${d.error}</div>`;
        } else {
            _lastAiText = d.plan;
            _lastAiDays = days;
            result.innerHTML = `<div class="ai-plan-text">${formatPlan(d.plan)}</div>`;
            // Hiển thị ô lưu kế hoạch
            const saveRow = document.getElementById('aiSaveRow');
            saveRow.style.display = 'block';
            document.getElementById('aiSaveMsg').style.display = 'none';
            const saveBtn = saveRow.querySelector('.btn-accent');
            saveBtn.style.display = ''; saveBtn.disabled = false;
            saveBtn.innerHTML = '<i class="fa-solid fa-floppy-disk"></i> Lưu kế hoạch này';
            // Gợi ý tên kế hoạch
            const titleInput = document.getElementById('aiPlanTitle');
            if (!titleInput.value) titleInput.value = `Kế hoạch ${dest} ${days} ngày`;
        }
    } catch {
        stopAiLoader();
        result.innerHTML = '<div class="text-danger">Lỗi kết nối AI. Vui lòng thử lại.</div>';
    } finally {
        stopAiLoader();
        genBtn.disabled = false; genBtn.innerHTML = '<i class="fa-solid fa-robot"></i> Tạo lịch trình';
    }
}

const _csrf = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
let _lastAiText = '';
let _lastAiDays = 1;

// Parse AI text → [{placeId, dayNumber, arrivalTime, leaveTime, note}]
function parseAiPlaces(text) {
    const result = [];
    const lines = text.split('\n');
    let currentDay = 1;
    let lastArr = null, lastLeave = null;   // khung giờ gần nhất, để kế thừa cho dòng con không có giờ riêng

    const dayPat   = /ngày\s*(\d+)/i;
    // Giờ chỉ dùng dấu ':' (tránh khớp giá tiền như "30.000"); validate 0-23 / 0-59 bên dưới
    const rangePat = /(\d{1,2}):(\d{2})\s*[-–]\s*(\d{1,2}):(\d{2})/;
    const timePat  = /(\d{1,2}):(\d{2})/;
    const costPat  = /ước tính chi phí|tổng chi phí|chi phí ước tính/i;

    const valid = (h, m) => h >= 0 && h <= 23 && m >= 0 && m <= 59;
    const hhmm  = (h, m) => `${String(h).padStart(2,'0')}:${String(m).padStart(2,'0')}`;

    for (const line of lines) {
        // Tới mục chi phí thì dừng — các số phía sau là TIỀN, không phải giờ
        if (costPat.test(line)) break;

        const dayMatch = line.match(dayPat);
        if (dayMatch) currentDay = parseInt(dayMatch[1]);

        // Lấy khung giờ từ dòng này nếu có và hợp lệ
        let arrTime = null, leaveTime = null;
        const rm = line.match(rangePat);
        if (rm && valid(+rm[1], +rm[2]) && valid(+rm[3], +rm[4])) {
            arrTime   = hhmm(+rm[1], +rm[2]);
            leaveTime = hhmm(+rm[3], +rm[4]);
        } else {
            const tm = line.match(timePat);
            if (tm && valid(+tm[1], +tm[2])) arrTime = hhmm(+tm[1], +tm[2]);
        }
        if (arrTime) { lastArr = arrTime; lastLeave = leaveTime; }

        // Gắn địa điểm với giờ của chính dòng, hoặc khung giờ gần nhất (dòng con)
        const localLink = /\[([^\]]+)\]\(\/Map\/Details\/(\d+)\)/g;
        let m;
        while ((m = localLink.exec(line)) !== null) {
            const pid = parseInt(m[2]);
            const slotArr   = arrTime || lastArr;
            const slotLeave = arrTime ? leaveTime : lastLeave;
            if (!slotArr) continue;   // chưa có khung giờ nào (phần intro) → bỏ qua
            // Cho phép cùng địa điểm nhiều lần nếu khác khung giờ
            const dup = result.find(r => r.placeId === pid && r.arrivalTime === slotArr);
            if (!dup) {
                result.push({ placeId: pid, dayNumber: currentDay,
                    arrivalTime: slotArr, leaveTime: slotLeave, note: null });
            }
        }
    }
    return result;
}

async function saveAiPlan() {
    const title = document.getElementById('aiPlanTitle').value.trim();
    if (!title) { alert('Vui lòng nhập tên kế hoạch!'); return; }

    const btn = document.querySelector('#aiSaveRow .btn-accent');
    btn.disabled = true; btn.textContent = 'Đang lưu…';

    const places = parseAiPlaces(_lastAiText);

    const resp = await fetch('/Plans/SaveAiPlan', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': _csrf },
        body: JSON.stringify({ title, aiText: _lastAiText, days: _lastAiDays,
            places: places.map(p => ({ placeId: p.placeId, dayNumber: p.dayNumber,
                arrivalTime: p.arrivalTime, leaveTime: p.leaveTime, note: p.note })) })
    });
    const d = await resp.json();
    const msgEl = document.getElementById('aiSaveMsg');
    if (d.ok) {
        msgEl.style.display = 'block';
        msgEl.innerHTML = `<div class="alert alert-success py-2"><i class="fa-solid fa-circle-check"></i> Đã lưu ${places.length} địa điểm! <a href="/Plans/Details/${d.id}" class="fw-bold">Xem kế hoạch →</a></div>`;
        btn.style.display = 'none';
    } else {
        msgEl.style.display = 'block';
        msgEl.innerHTML = `<div class="alert alert-warning py-2">${d.msg}</div>`;
        btn.disabled = false; btn.textContent = '<i class="fa-solid fa-floppy-disk"></i> Lưu kế hoạch này';
    }
}

function formatPlan(text) {
    return text
        .replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')
        .replace(/\[([^\]]+)\]\((\/[^)]+)\)/g,
            '<a href="$2" style="color:#7c3aed;font-weight:600;text-decoration:underline">$1 <i class="fa-solid fa-map"></i></a>')
        .replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>')
        .replace(/\n/g, '<br>');
}

function showCopyMsg(input) {
    const orig = input.value;
    input.value = '✅ Đã sao chép!';
    setTimeout(() => input.value = orig, 1500);
}
</script>
