@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/jpeg" href="~/img/logo.jpg" />
    <title>@ViewData["Title"] - CityScout</title>
    <meta name="description" content="@(ViewData["MetaDescription"] ?? "CityScout — khám phá địa điểm ăn uống, cà phê, vui chơi, văn hóa tại Hà Nội. Lập kế hoạch chuyến đi thông minh cùng AI, lọc theo ngân sách, thời tiết và giờ mở cửa.")" />
    @if (ViewData["Canonical"] != null)
    {
        <link rel="canonical" href="@ViewData["Canonical"]" />
    }
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@fortawesome/fontawesome-free@6.5.2/css/all.min.css">
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <link rel="stylesheet" href="https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.css" />
    <link rel="stylesheet" href="https://unpkg.com/leaflet.markercluster@1.5.3/dist/MarkerCluster.Default.css" />
    <link rel="stylesheet" href="https://unpkg.com/leaflet-routing-machine@latest/dist/leaflet-routing-machine.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="@(ViewData["BodyClass"] ?? "")">

    <header class="app-header">
        <div class="app-shell nav-row">
            <!-- Brand -->
            <a class="brand" asp-controller="Home" asp-action="Index">
                <img class="brand-mark" src="~/img/logo.jpg" alt="CityScout" />
                <span class="brand-text">CityScout</span>
            </a>

            <!-- Nav — tối giản: Explore · Map · Plans · avatar -->
            <nav class="top-nav">
                @{
                    var ctrl = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
                }
                <a asp-controller="Home" asp-action="Index" class="nav-link2 @(ctrl == "Home" ? "is-active" : "")">Khám phá</a>
                <a asp-controller="Map" asp-action="Index" class="nav-link2 @(ctrl == "Map" ? "is-active" : "")">Bản đồ</a>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a asp-controller="Plans" asp-action="Index" class="nav-link2 @(ctrl == "Plans" ? "is-active" : "")">Kế hoạch</a>
                }
                <partial name="_LoginPartial" />
            </nav>
        </div>
    </header>

    <main>@RenderBody()</main>

    @if (ViewData["BodyClass"]?.ToString() != "map-view")
    {
        <footer class="app-footer">
            <div class="app-shell">
                <span>© 2026 CityScout &nbsp;·&nbsp; Khám phá Hà Nội cùng AI</span>
            </div>
        </footer>
    }

    @{
        var mbToken = Configuration["Mapbox:Token"] ?? Environment.GetEnvironmentVariable("MAPBOX_TOKEN");
        var mbStyle = Configuration["Mapbox:Style"] ?? Environment.GetEnvironmentVariable("MAPBOX_STYLE");
    }
    @if (!string.IsNullOrWhiteSpace(mbToken))
    {
        <script>window.MAPBOX_TOKEN = "@Html.Raw(mbToken)";</script>
    }
    @if (!string.IsNullOrWhiteSpace(mbStyle))
    {
        <script>window.MAPBOX_STYLE = "@Html.Raw(mbStyle)";</script>
    }
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script src="https://unpkg.com/leaflet.markercluster@1.5.3/dist/leaflet.markercluster.js"></script>
    <script src="https://unpkg.com/leaflet-routing-machine@latest/dist/leaflet-routing-machine.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
