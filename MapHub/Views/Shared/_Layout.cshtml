<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CityScout</title>
    <meta name="description" content="@(ViewData["MetaDescription"] ?? "CityScout — khám phá địa điểm ăn uống, cà phê, vui chơi, văn hóa tại Hà Nội. Lập kế hoạch chuyến đi thông minh cùng AI, lọc theo ngân sách, thời tiết và giờ mở cửa.")" />
    @if (ViewData["Canonical"] != null)
    {
        <link rel="canonical" href="@ViewData["Canonical"]" />
    }
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <link rel="stylesheet" href="https://unpkg.com/leaflet-routing-machine@latest/dist/leaflet-routing-machine.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="@(ViewData["BodyClass"] ?? "")">

    <header class="app-header">
        <div class="app-shell nav-row">
            <!-- Brand -->
            <a class="brand" asp-controller="Home" asp-action="Index">
                <span class="brand-mark">CS</span>
                <span class="brand-text">CityScout</span>
            </a>

            <!-- Nav -->
            <nav class="top-nav">
                @{
                    var ctrl = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
                }
                <a asp-controller="Home" asp-action="Index" class="nav-item @(ctrl == "Home" ? "nav-item-active" : "")">
                    <i class="bi bi-house-fill" style="color:#22c55e"></i><span>Trang chủ</span>
                </a>
                <a asp-controller="Map" asp-action="Index" class="nav-item @(ctrl == "Map" ? "nav-item-active" : "")">
                    <i class="bi bi-map-fill" style="color:#3b82f6"></i><span>Bản đồ</span>
                </a>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a asp-controller="Map" asp-action="MyPlaces" class="nav-item @(ViewContext.RouteData.Values["action"]?.ToString() == "MyPlaces" ? "nav-item-active" : "")">
                        <i class="bi bi-geo-alt-fill" style="color:#ef4444"></i><span>Địa điểm của tôi</span>
                    </a>
                    <a asp-controller="Plans" asp-action="Index" class="nav-item @(ctrl == "Plans" ? "nav-item-active" : "")">
                        <i class="bi bi-calendar-week-fill" style="color:#8b5cf6"></i><span>Kế hoạch</span>
                    </a>
                }
                @if (!User.IsInRole("Admin"))
                {
                    <a asp-controller="Payments" asp-action="Premium" class="nav-item nav-item-pro">
                        <i class="bi bi-lightning-charge-fill"></i><span>Pro</span>
                    </a>
                }
                @if (User.IsInRole("Admin"))
                {
                    <a asp-controller="Admin" asp-action="Index" class="nav-item nav-item-admin">
                        <i class="bi bi-shield-fill"></i><span>Admin</span>
                    </a>
                }
                <partial name="_LoginPartial" />
            </nav>
        </div>
    </header>

    <main>@RenderBody()</main>

    @if (ViewData["BodyClass"]?.ToString() != "map-view")
    {
        <footer class="app-footer">
            <div class="app-shell">
                <span>© 2026 CityScout &nbsp;·&nbsp; Khám phá Hà Nội cùng AI</span>
            </div>
        </footer>
    }

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script src="https://unpkg.com/leaflet-routing-machine@latest/dist/leaflet-routing-machine.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
