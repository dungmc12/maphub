@model MapHub.Models.Place
@{
    ViewData["Title"] = Model.Name;
    var avgQuality = Model.Reviews.Any() ? Math.Round(Model.Reviews.Average(r => r.QualityRating), 1) : 0.0;
    var avgService = Model.Reviews.Any() ? Math.Round(Model.Reviews.Average(r => r.ServiceRating), 1) : 0.0;
    var avgFood    = Model.Reviews.Any(r => r.FoodRating.HasValue)
                     ? Math.Round(Model.Reviews.Where(r => r.FoodRating.HasValue).Average(r => r.FoodRating!.Value), 1) : 0.0;
    var attrGroups = Model.Attributes.GroupBy(a => a.GroupName).ToDictionary(g => g.Key, g => g.ToList());
    bool isRestaurantLike = new[]{"restaurant","cafe","nhà hàng","cà phê"}.Contains(Model.Category?.ToLower());
    string? currentUserId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
    bool isAdmin = User.IsInRole("Admin");
    var reviewAuthors = ViewBag.ReviewAuthors as Dictionary<string, (string Name, string? Avatar)>
                        ?? new Dictionary<string, (string Name, string? Avatar)>();
    // Tách ảnh thường (carousel) / ảnh menu / video (hiển thị riêng như Google Maps)
    var galleryImages = Model.Images.Where(i => !i.IsMenu && !i.IsVideo).ToList();
    var menuImages    = Model.Images.Where(i => i.IsMenu && !i.IsVideo).ToList();
    var videoItems    = Model.Images.Where(i => i.IsVideo).ToList();
}
@Html.AntiForgeryToken()

<div class="container-xl py-4">
    <div class="row g-4">

        <!-- ── LEFT: Media + Reviews ───────────────────────────────────── -->
        <div class="col-lg-8">

            <!-- Back link -->
            <a href="/Map" class="back-link"><i class="fa-solid fa-circle-arrow-left" style="color:#3b82f6"></i> Quay lại bản đồ</a>

            <!-- Title -->
            <div class="d-flex align-items-start gap-3 mt-2 mb-3 flex-wrap">
                <div class="flex-grow-1">
                    <h1 class="place-detail-title">@Model.Name</h1>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        bool isSavedDetail = ViewBag.IsSaved ?? false;
                        <button type="button" id="saveBtn" onclick="toggleSaveDetail(@Model.Id)"
                                class="btn btn-sm @(isSavedDetail ? "btn-danger" : "btn-outline-danger") mb-2">
                            @Html.Raw(isSavedDetail ? "<i class=\"fa-solid fa-heart\"></i> Đã lưu" : "<i class=\"fa-regular fa-heart\"></i> Lưu địa điểm")
                        </button>
                        @if (currentUserId == Model.CreatedByUserId || isAdmin)
                        {
                            <a href="/Map/EditMyPlace/@Model.Id" class="btn btn-sm btn-outline-primary mb-2 ms-1">
                                <i class="fa-solid fa-pen"></i> Sửa địa điểm
                            </a>
                        }
                    }
                    <div class="place-detail-meta-row">
                        @{
            var catMeta = new Dictionary<string,(string Label,string Icon,string Color)>(StringComparer.OrdinalIgnoreCase)
            {
                ["restaurant"]    = ("Nhà hàng",   "bi-shop-window",       "#e06d1b"),
                ["cafe"]          = ("Cà phê",      "bi-cup-hot-fill",      "#d97706"),
                ["entertainment"] = ("Vui chơi",    "bi-joystick",          "#7c3aed"),
                ["hotel"]         = ("Lưu trú",     "bi-building-fill",     "#db2777"),
                ["culture"]       = ("Văn hóa",     "bi-bank",              "#2563eb"),
                ["temple"]        = ("Tâm linh",    "bi-moon-stars-fill",   "#a16207"),
                ["nature"]        = ("Thiên nhiên", "bi-tree-fill",         "#16a34a"),
                ["education"]     = ("Giáo dục",    "bi-mortarboard-fill",  "#0d9488")
            };
            var (catLabel2, catIcon2, catColor2) = (Model.Category != null && catMeta.TryGetValue(Model.Category, out var cm))
                ? cm : ("Khác", "bi-geo-alt-fill", "#6b7280");
        }
        <span class="place-detail-cat" style="color:@catColor2">
            <i class="bi @catIcon2"></i> @catLabel2
        </span>
                        @if (Model.Reviews.Any())
                        {
                            <span class="place-detail-rating">★ @avgQuality <small>(@Model.Reviews.Count đánh giá)</small></span>
                        }
                        @if (Model.Visibility == "public")
                        {
                            <span class="badge bg-info text-dark">Công khai</span>
                        }
                    </div>
                    @if (!string.IsNullOrEmpty(Model.Address))
                    {
                        <p class="place-detail-address"><i class="fa-solid fa-location-dot" style="color:#ef4444"></i> @Model.Address</p>
                    }
                </div>
            </div>

            <!-- Image Carousel -->
            @if (galleryImages.Any())
            {
                <div class="place-gallery mb-4">
                    <!-- Main slide -->
                    <div id="placeCarousel" class="carousel slide" data-bs-ride="false" data-bs-touch="true">
                        <!-- Dot indicators -->
                        @if (galleryImages.Count > 1)
                        {
                            <div class="carousel-indicators">
                                @for (int di = 0; di < galleryImages.Count; di++)
                                {
                                    <button type="button" data-bs-target="#placeCarousel" data-bs-slide-to="@di"
                                            class="@(di == 0 ? "active" : "")" aria-label="Ảnh @(di+1)"></button>
                                }
                            </div>
                        }
                        <div class="carousel-inner rounded-3 overflow-hidden shadow-sm">
                            @{ int ci = 0; }
                            @foreach (var img in galleryImages)
                            {
                                <div class="carousel-item @(ci == 0 ? "active" : "")">
                                    <img src="/Map/Image/@img.Id?v=@Model.UpdatedAt.Ticks" class="d-block w-100 gallery-main-img"
                                         alt="@img.Caption" loading="lazy" onclick="openLightbox(this.src)"
                                         onerror="this.onerror=null;this.src='https://placehold.co/800x400?text=Ảnh+không+còn'">
                                    @if (!string.IsNullOrEmpty(img.Caption))
                                    {
                                        <div class="carousel-caption d-none d-md-block bg-dark bg-opacity-50 rounded p-1">
                                            <small>@img.Caption</small>
                                        </div>
                                    }
                                </div>
                                ci++;
                            }
                        </div>
                        @if (galleryImages.Count > 1)
                        {
                            <button class="carousel-control-prev" type="button" data-bs-target="#placeCarousel" data-bs-slide="prev">
                                <span class="carousel-control-prev-icon"></span>
                            </button>
                            <button class="carousel-control-next" type="button" data-bs-target="#placeCarousel" data-bs-slide="next">
                                <span class="carousel-control-next-icon"></span>
                            </button>
                        }
                    </div>

                    <!-- Thumbnail strip -->
                    @if (galleryImages.Count > 1)
                    {
                        <div class="gallery-thumbs mt-2" id="galleryThumbs">
                            @{ int ti = 0; }
                            @foreach (var img in galleryImages)
                            {
                                <img src="/Map/Image/@img.Id?v=@Model.UpdatedAt.Ticks" alt="thumb" loading="lazy"
                                     class="gallery-thumb @(ti == 0 ? "active" : "")"
                                     data-index="@ti"
                                     onclick="goToSlide(@ti)"
                                     onerror="this.onerror=null;this.src='https://placehold.co/72x52?text=x'">
                                ti++;
                            }
                        </div>
                    }
                </div>

                <!-- Lightbox overlay -->
                <div id="lightbox" onclick="closeLightbox()"
                     style="display:none;position:fixed;inset:0;background:rgba(0,0,0,.88);z-index:9999;align-items:center;justify-content:center;cursor:zoom-out">
                    <img id="lightboxImg" src="" alt="" style="max-width:92vw;max-height:92vh;border-radius:10px;object-fit:contain">
                </div>
            }
            else
            {
                <div class="detail-no-img mb-4">
                    <i class="fa-solid fa-camera" style="color:#94a3b8;font-size:1.5rem"></i>
                    <span style="color:#94a3b8">Chưa có ảnh cho địa điểm này</span>
                </div>
            }

            <!-- Ảnh thực đơn / menu (hiển thị riêng như Google Maps) -->
            @if (menuImages.Any())
            {
                <div class="detail-section">
                    <h4 class="detail-section-title"><i class="fa-solid fa-utensils"></i> Thực đơn / Menu</h4>
                    <div style="display:flex;flex-wrap:wrap;gap:.6rem">
                        @foreach (var mi in menuImages)
                        {
                            <img src="/Map/Image/@mi.Id?v=@Model.UpdatedAt.Ticks" alt="Ảnh menu" loading="lazy" onclick="openLightbox(this.src)"
                                 onerror="this.onerror=null;this.src='https://placehold.co/200x200?text=x'"
                                 style="width:140px;height:140px;object-fit:cover;border-radius:10px;cursor:zoom-in;border:1px solid var(--line)">
                        }
                    </div>
                </div>
            }

            @if (videoItems.Any())
            {
                <div class="detail-section">
                    <h4 class="detail-section-title"><i class="fa-solid fa-video"></i> Video</h4>
                    <div style="display:flex;flex-wrap:wrap;gap:.8rem">
                        @foreach (var v in videoItems)
                        {
                            <video controls preload="metadata" playsinline
                                   style="width:min(100%,360px);max-height:260px;border-radius:12px;border:1px solid var(--line);background:#000">
                                <source src="/Map/Image/@v.Id?v=@Model.UpdatedAt.Ticks">
                            </video>
                        }
                    </div>
                </div>
            }

            <!-- About -->
            @if (!string.IsNullOrEmpty(Model.About))
            {
                <div class="detail-section">
                    <h4 class="detail-section-title">Giới thiệu</h4>
                    <p class="detail-about">@Model.About</p>
                </div>
            }

            <!-- Tags -->
            @if (Model.PlaceTags.Any())
            {
                <div class="detail-tags mb-4">
                    @foreach (var pt in Model.PlaceTags.Where(pt => pt.Tag != null))
                    {
                        <span class="tag-chip-sm">@pt.Tag!.Name</span>
                    }
                </div>
            }

            <!-- Reviews -->
            <div class="detail-section">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h4 class="detail-section-title mb-0">Đánh giá (@Model.Reviews.Count)</h4>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <button class="btn-accent btn-sm-accent" onclick="document.getElementById('reviewForm').scrollIntoView({behavior:'smooth'})">
                            <i class="fa-solid fa-pen"></i> Viết đánh giá
                        </button>
                    }
                </div>

                <!-- Rating summary -->
                @if (Model.Reviews.Any())
                {
                    <div class="rating-summary mb-3">
                        <div class="rating-big">@avgQuality <span>/ 5</span></div>
                        <div class="rating-breakdown">
                            <div class="rating-row">
                                <span>Chất lượng</span>
                                <div class="rating-bar"><div style="width:@(avgQuality*20)%"></div></div>
                                <span>@avgQuality</span>
                            </div>
                            <div class="rating-row">
                                <span>Nhân viên</span>
                                <div class="rating-bar"><div style="width:@(avgService*20)%"></div></div>
                                <span>@avgService</span>
                            </div>
                            @if (isRestaurantLike && avgFood > 0)
                            {
                                <div class="rating-row">
                                    <span>Đồ ăn/uống</span>
                                    <div class="rating-bar"><div style="width:@(avgFood*20)%"></div></div>
                                    <span>@avgFood</span>
                                </div>
                            }
                        </div>
                    </div>
                }

                <!-- Review list -->
                @if (Model.Reviews.Any())
                {
                    @foreach (var rv in Model.Reviews.OrderByDescending(r => r.CreatedAt))
                    {
                        var author = reviewAuthors.TryGetValue(rv.UserId, out var a) ? a : (Name: "Người dùng", Avatar: (string?)null);
                        var isOwn = currentUserId == rv.UserId;
                        var initial = string.IsNullOrWhiteSpace(author.Name) ? "?" : author.Name.Trim()[..1].ToUpper();
                        <div class="review-card" id="review-@rv.Id">
                            <div class="review-header">
                                @if (!string.IsNullOrEmpty(author.Avatar))
                                {
                                    <img src="@author.Avatar" alt="@author.Name" class="review-avatar"
                                         onerror="this.onerror=null;this.src='https://placehold.co/72x72/0891b2/ffffff?text=@initial'"
                                         style="object-fit:cover">
                                }
                                else
                                {
                                    <div class="review-avatar" style="background:#0891b2;color:#fff;font-weight:700">@initial</div>
                                }
                                <div>
                                    <div class="review-user">
                                        @author.Name
                                        @if (isOwn)
                                        {
                                            <span style="font-size:.7rem;font-weight:700;color:#0891b2;background:#cffafe;border-radius:999px;padding:.05rem .4rem;margin-left:.3rem">Bạn</span>
                                        }
                                    </div>
                                    <div class="review-date">@rv.CreatedAt.ToString("dd/MM/yyyy")</div>
                                </div>
                                <div class="review-stars ms-auto">
                                    ★ @((rv.QualityRating + rv.ServiceRating) / 2.0)
                                </div>
                                @if (currentUserId == rv.UserId || isAdmin)
                                {
                                    <div style="display:flex;gap:.35rem;margin-left:.5rem">
                                        @if (currentUserId == rv.UserId)
                                        {
                                            <button type="button" onclick="toggleEditReview(@rv.Id)" title="Sửa đánh giá"
                                                    style="display:inline-flex;align-items:center;gap:.25rem;background:#eff6ff;border:1px solid #bfdbfe;color:#1d4ed8;cursor:pointer;font-size:.78rem;font-weight:600;border-radius:7px;padding:.2rem .5rem">
                                                <i class="fa-solid fa-pen"></i> Sửa
                                            </button>
                                        }
                                        <button type="button" onclick="deleteReview(@rv.Id, this)" title="Xóa đánh giá"
                                                style="display:inline-flex;align-items:center;gap:.25rem;background:#fef2f2;border:1px solid #fecaca;color:#dc2626;cursor:pointer;font-size:.78rem;font-weight:600;border-radius:7px;padding:.2rem .5rem">
                                            <i class="fa-solid fa-trash"></i> Xóa
                                        </button>
                                    </div>
                                }
                            </div>
                            <div class="review-ratings-row">
                                <span>Chất lượng: <b>@rv.QualityRating/5</b></span>
                                <span>Nhân viên: <b>@rv.ServiceRating/5</b></span>
                                @if (rv.FoodRating.HasValue)
                                {
                                    <span>Đồ ăn: <b>@rv.FoodRating/5</b></span>
                                }
                            </div>
                            @if (!string.IsNullOrEmpty(rv.Content))
                            {
                                <p class="review-content">@rv.Content</p>
                            }
                            @if (!string.IsNullOrEmpty(rv.FoodReview))
                            {
                                <p class="review-sub"><em><i class="fa-solid fa-utensils" style="color:#f59e0b"></i> @rv.FoodReview</em></p>
                            }
                            @if (!string.IsNullOrEmpty(rv.StaffReview))
                            {
                                <p class="review-sub"><em><i class="fa-solid fa-user-check" style="color:#6366f1"></i> @rv.StaffReview</em></p>
                            }
                            @if (!string.IsNullOrEmpty(rv.PhotoUrl))
                            {
                                <img src="/Map/ReviewMedia/@rv.Id?kind=photo" alt="Ảnh đánh giá" loading="lazy"
                                     onerror="this.onerror=null;this.style.display='none'"
                                     style="max-width:100%;max-height:220px;border-radius:10px;margin-top:8px;object-fit:cover">
                            }
                            @if (!string.IsNullOrEmpty(rv.VideoUrl))
                            {
                                <video controls preload="metadata" playsinline
                                       style="max-width:100%;max-height:240px;border-radius:10px;margin-top:8px;background:#000">
                                    <source src="/Map/ReviewMedia/@rv.Id?kind=video">
                                </video>
                            }

                            @if (currentUserId == rv.UserId || isAdmin)
                            {
                                <!-- Form sửa đánh giá (ẩn, mở bằng nút Sửa) -->
                                <form method="post" action="/Map/EditReview" enctype="multipart/form-data"
                                      id="editForm-@rv.Id" style="display:none;margin-top:.7rem;border-top:1px dashed var(--line);padding-top:.7rem">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@rv.Id">
                                    <div class="row g-2 mb-2">
                                        <div class="col-4">
                                            <label class="form-label mb-1" style="font-size:.78rem">Chất lượng</label>
                                            <select name="qualityRating" class="form-select form-select-sm" required>
                                                @for (int s = 5; s >= 1; s--)
                                                { <option value="@s" selected="@(rv.QualityRating == s)">@s ★</option> }
                                            </select>
                                        </div>
                                        <div class="col-4">
                                            <label class="form-label mb-1" style="font-size:.78rem">Nhân viên</label>
                                            <select name="serviceRating" class="form-select form-select-sm" required>
                                                @for (int s = 5; s >= 1; s--)
                                                { <option value="@s" selected="@(rv.ServiceRating == s)">@s ★</option> }
                                            </select>
                                        </div>
                                        @if (isRestaurantLike)
                                        {
                                            <div class="col-4">
                                                <label class="form-label mb-1" style="font-size:.78rem">Đồ ăn/uống</label>
                                                <select name="foodRating" class="form-select form-select-sm">
                                                    <option value="">--</option>
                                                    @for (int s = 5; s >= 1; s--)
                                                    { <option value="@s" selected="@(rv.FoodRating == s)">@s ★</option> }
                                                </select>
                                            </div>
                                        }
                                    </div>
                                    <textarea name="content" class="form-control form-control-sm mb-2" rows="2"
                                              placeholder="Chia sẻ trải nghiệm của bạn...">@rv.Content</textarea>
                                    @if (isRestaurantLike)
                                    {
                                        <input type="text" name="foodReview" class="form-control form-control-sm mb-2"
                                               value="@rv.FoodReview" placeholder="Nhận xét về đồ ăn/uống (tùy chọn)">
                                        <input type="text" name="staffReview" class="form-control form-control-sm mb-2"
                                               value="@rv.StaffReview" placeholder="Nhận xét về nhân viên (tùy chọn)">
                                    }
                                    <label class="form-label mb-1" style="font-size:.78rem"><i class="fa-solid fa-camera"></i> Đổi ảnh <small class="text-muted">(bỏ trống để giữ ảnh cũ)</small></label>
                                    <input type="file" name="photo" class="form-control form-control-sm mb-2" accept="image/*">
                                    <label class="form-label mb-1" style="font-size:.78rem"><i class="fa-solid fa-video"></i> Đổi video <small class="text-muted">(≤30s · ≤15MB, bỏ trống = giữ nguyên)</small></label>
                                    <input type="file" name="video" class="form-control form-control-sm mb-2 video-in" accept="video/mp4,video/webm,video/quicktime">
                                    <div class="d-flex gap-2">
                                        <button type="submit" class="btn-accent btn-sm-accent"><i class="fa-solid fa-floppy-disk"></i> Lưu thay đổi</button>
                                        <button type="button" class="btn-ghost btn-sm-ghost" onclick="toggleEditReview(@rv.Id)">Hủy</button>
                                    </div>
                                </form>
                            }
                        </div>
                    }
                }
                else
                {
                    <p class="text-muted">Chưa có đánh giá nào. Hãy là người đầu tiên!</p>
                }

                <!-- Write review form -->
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <div id="reviewForm" class="review-form-box mt-4">
                        <h5><i class="fa-solid fa-pen-to-square" style="color:#0891b2"></i> Viết đánh giá của bạn</h5>
                        <form method="post" action="/Map/AddReview" enctype="multipart/form-data"
                              onsubmit="this.querySelector('button[type=submit]').disabled=true;this.querySelector('button[type=submit]').textContent='Đang gửi…';">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="placeId" value="@Model.Id">
                            <div class="row g-2 mb-2">
                                <div class="col-md-4">
                                    <label class="form-label">Chất lượng tổng thể</label>
                                    <select name="qualityRating" class="form-select" required>
                                        @for (int s = 5; s >= 1; s--)
                                        { <option value="@s">@s ★</option> }
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Nhân viên phục vụ</label>
                                    <select name="serviceRating" class="form-select" required>
                                        @for (int s = 5; s >= 1; s--)
                                        { <option value="@s">@s ★</option> }
                                    </select>
                                </div>
                                @if (isRestaurantLike)
                                {
                                    <div class="col-md-4">
                                        <label class="form-label">Đồ ăn / đồ uống</label>
                                        <select name="foodRating" class="form-select">
                                            <option value="">-- Bỏ qua --</option>
                                            @for (int s = 5; s >= 1; s--)
                                            { <option value="@s">@s ★</option> }
                                        </select>
                                    </div>
                                }
                            </div>
                            <textarea name="content" class="form-control mb-2" rows="3"
                                      placeholder="Chia sẻ trải nghiệm của bạn..."></textarea>
                            @if (isRestaurantLike)
                            {
                                <input type="text" name="foodReview" class="form-control mb-2"
                                       placeholder="Nhận xét về đồ ăn/uống (tùy chọn)">
                                <input type="text" name="staffReview" class="form-control mb-2"
                                       placeholder="Nhận xét về nhân viên (tùy chọn)">
                            }
                            <div class="row g-2 mb-3">
                                <div class="col-md-6">
                                    <label class="form-label"><i class="fa-solid fa-camera" style="color:#3b82f6"></i> Ảnh đính kèm <small class="text-muted">(tùy chọn)</small></label>
                                    <input type="file" name="photo" class="form-control form-control-sm" accept="image/*">
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label"><i class="fa-solid fa-video" style="color:#0891b2"></i> Video <small class="text-muted">(tùy chọn · ≤30s · ≤15MB)</small></label>
                                    <input type="file" name="video" class="form-control form-control-sm video-in" accept="video/mp4,video/webm,video/quicktime">
                                </div>
                            </div>
                            <button type="submit" class="btn-accent">Gửi đánh giá</button>
                        </form>
                    </div>
                }
            </div>
        </div>

        <!-- ── RIGHT: Info Panel ───────────────────────────────────────── -->
        <div class="col-lg-4">

            <!-- Info Card -->
            <div class="info-card mb-3">
                <h5 class="info-card-title">Thông tin</h5>
                <ul class="info-list">
                    @if (!string.IsNullOrEmpty(Model.Phone))
                    {
                        <li>
                            <i class="fa-solid fa-phone" style="color:#22c55e;font-size:1rem"></i>
                            <a href="tel:@Model.Phone">@Model.Phone</a>
                        </li>
                    }
                    @if (!string.IsNullOrEmpty(Model.Phone2))
                    {
                        <li>
                            <i class="fa-solid fa-phone-volume" style="color:#0d9488;font-size:1rem"></i>
                            <a href="tel:@Model.Phone2">@Model.Phone2</a> <small class="text-muted">(hotline)</small>
                        </li>
                    }
                    @if (!string.IsNullOrEmpty(Model.OpenTime) || !string.IsNullOrEmpty(Model.CloseTime))
                    {
                        <li>
                            <i class="fa-solid fa-clock" style="color:#f59e0b;font-size:1rem"></i>
                            <span>@(Model.OpenTime ?? "?") – @(Model.CloseTime ?? "?")</span>
                        </li>
                    }
                    @if (!string.IsNullOrEmpty(Model.WebsiteUrl))
                    {
                        <li>
                            <i class="fa-solid fa-globe" style="color:#3b82f6;font-size:1rem"></i>
                            <a href="@Model.WebsiteUrl" target="_blank" rel="nofollow noopener">Trang web</a>
                        </li>
                    }
                    @if (Model.MinPrice.HasValue)
                    {
                        var priceStr = Model.MaxPrice.HasValue
                            ? $"{Model.MinPrice!.Value:N0}đ – {Model.MaxPrice!.Value:N0}đ"
                            : $"Từ {Model.MinPrice!.Value:N0}đ";
                        <li>
                            <i class="fa-solid fa-coins" style="color:#f59e0b;font-size:1rem"></i>
                            <span style="color:#16a34a;font-weight:700">@priceStr</span>
                        </li>
                    }
                </ul>

                <div class="info-actions mt-3">
                    @{
                        var invc = System.Globalization.CultureInfo.InvariantCulture;
                        var routeParam = $"{Model.Latitude.ToString(invc)},{Model.Longitude.ToString(invc)}";
                    }
                    <a class="btn-accent w-100 mb-2 text-center text-decoration-none" href="/Map?route=@routeParam">
                        <i class="fa-solid fa-location-arrow"></i> Chỉ đường
                    </a>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <a href="/Plans" class="btn-ghost w-100">
                            <i class="fa-solid fa-calendar-plus" style="color:#8b5cf6"></i> Thêm vào kế hoạch
                        </a>
                    }
                </div>
            </div>

            <!-- Attributes (Google Maps style) -->
            @if (attrGroups.Any())
            {
                <div class="info-card mb-3">
                    <h5 class="info-card-title">Tiện ích &amp; Dịch vụ</h5>
                    @foreach (var group in attrGroups)
                    {
                        <div class="attr-group">
                            <div class="attr-group-name">@group.Key</div>
                            <div class="attr-list">
                                @foreach (var attr in group.Value)
                                {
                                    <div class="attr-item @(attr.IsAvailable ? "" : "attr-unavailable")">
                                        <i class="bi @(attr.IsAvailable ? "bi-check-circle-fill" : "bi-x-circle-fill")"
                                           style="color:@(attr.IsAvailable ? "#22c55e" : "#d1d5db")"></i>
                                        @attr.Label
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }

            <!-- Mini map -->
            <div class="info-card">
                <h5 class="info-card-title">Vị trí</h5>
                <div id="detailMiniMap" style="height:200px;border-radius:8px;overflow:hidden;"></div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
// Lưu / bỏ lưu địa điểm
function toggleSaveDetail(id) {
    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
    fetch('/Map/ToggleSave', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': token },
        body: 'placeId=' + id
    }).then(r => r.json()).then(d => {
        if (!d.ok) return;
        const btn = document.getElementById('saveBtn');
        if (d.saved) { btn.className = 'btn btn-sm btn-danger mb-2'; btn.innerHTML = '<i class="fa-solid fa-heart"></i> Đã lưu'; }
        else { btn.className = 'btn btn-sm btn-outline-danger mb-2'; btn.innerHTML = '<i class="fa-regular fa-heart"></i> Lưu địa điểm'; }
    }).catch(() => {});
}

// Xóa đánh giá real-time (không reload trang)
function toggleEditReview(id) {
    const f = document.getElementById('editForm-' + id);
    if (!f) return;
    const open = f.style.display !== 'none';
    f.style.display = open ? 'none' : 'block';
    if (!open) f.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
}

function deleteReview(id, btn) {
    if (!confirm('Xóa đánh giá này?')) return;
    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
    fetch('/Map/DeleteReview', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': token },
        body: 'id=' + encodeURIComponent(id)
    })
    .then(r => {
        if (!r.ok) throw new Error();
        const card = document.getElementById('review-' + id);
        if (card) { card.style.transition = 'opacity .2s'; card.style.opacity = '0'; setTimeout(() => card.remove(), 220); }
    })
    .catch(() => alert('Không xóa được đánh giá. Thử lại.'));
}

document.addEventListener('DOMContentLoaded', () => {
    const lat = @Model.Latitude, lng = @Model.Longitude;
    const m = L.map('detailMiniMap', { zoomControl:false, dragging:false, scrollWheelZoom:false })
               .setView([lat, lng], 15);
    window.cityTiles(m);
    L.marker([lat, lng]).addTo(m)
     .bindPopup('<b>@Html.Raw(Model.Name.Replace("'", "\\'"))</b>').openPopup();

    // Sync carousel ↔ thumbnails
    const carousel = document.getElementById('placeCarousel');
    if (carousel) {
        carousel.addEventListener('slid.bs.carousel', e => {
            document.querySelectorAll('.gallery-thumb').forEach(t => t.classList.remove('active'));
            const active = document.querySelector(`.gallery-thumb[data-index="${e.to}"]`);
            if (active) {
                active.classList.add('active');
                // Chỉ cuộn NGANG trong dải thumbnail, KHÔNG cuộn dọc cả trang (trước đây tự trôi xuống review)
                const strip = document.getElementById('galleryThumbs');
                if (strip) strip.scrollTo({ left: active.offsetLeft - strip.clientWidth / 2 + active.clientWidth / 2, behavior: 'smooth' });
            }
        });
    }
});

function goToSlide(index) {
    const c = bootstrap.Carousel.getOrCreateInstance(document.getElementById('placeCarousel'));
    c.to(index);
}

function openLightbox(src) {
    const lb = document.getElementById('lightbox');
    document.getElementById('lightboxImg').src = src;
    lb.style.display = 'flex';
    document.body.style.overflow = 'hidden';
}
function closeLightbox() {
    document.getElementById('lightbox').style.display = 'none';
    document.body.style.overflow = '';
}
document.addEventListener('keydown', e => { if (e.key === 'Escape') closeLightbox(); });
</script>
}
