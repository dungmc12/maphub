@model IEnumerable<MapHub.Models.Place>
@{
    ViewData["Title"] = "Địa điểm của tôi";
    bool isPro     = User.IsInRole("Admin") || User.IsInRole("Pro") || (bool)(ViewBag.IsPro ?? false);
    int  maxPlaces = isPro ? int.MaxValue : (int)(ViewBag.MaxPlaces ?? 3);
    int  count     = (int)(ViewBag.PlaceCount ?? 0);
}

<div class="container-xl py-4">
    <div class="d-flex justify-content-between align-items-start flex-wrap gap-3 mb-4">
        <div>
            <h2 class="mb-0">📍 Địa điểm của tôi</h2>
            @if (!isPro)
            {
                <p class="text-muted mt-1">
                    @count / @maxPlaces địa điểm —
                    <a href="/Payments/Premium" class="text-warning fw-bold">Nâng cấp Pro</a> để thêm không giới hạn
                </p>
            }
            else
            {
                <p class="text-muted mt-1">@count địa điểm</p>
            }
        </div>
        <a href="/Map" class="btn-accent">＋ Thêm địa điểm mới</a>
    </div>

    @if (!string.IsNullOrEmpty(TempData["Success"]?.ToString()))
    {
        <div class="alert alert-success alert-dismissible fade show">
            @TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (!Model.Any())
    {
        <div class="plans-empty">
            <div class="plans-empty-icon">📍</div>
            <h5>Bạn chưa thêm địa điểm nào</h5>
            <p>Mở bản đồ và nhấn <strong>+ Thêm địa điểm</strong> để bắt đầu!</p>
            <a href="/Map" class="btn-accent mt-2">🗺️ Mở bản đồ</a>
        </div>
    }
    else
    {
        <div class="d-flex flex-wrap gap-2 mb-3">
            <input type="text" id="searchMy" class="form-control" style="max-width:260px"
                   placeholder="🔍 Tìm theo tên..." oninput="filterMy()">
            <select id="catMy" class="form-select" style="max-width:190px" onchange="filterMy()">
                <option value="">Mọi danh mục</option>
                <option value="home">🏠 Nhà riêng</option>
                <option value="work">🏢 Công ty</option>
                <option value="school">🏫 Trường học</option>
                <option value="favorite">❤️ Quán yêu thích</option>
                <option value="restaurant">🍽️ Nhà hàng</option>
                <option value="cafe">☕ Cà phê</option>
                <option value="entertainment">🎯 Vui chơi</option>
                <option value="hotel">🏨 Lưu trú</option>
                <option value="culture">🏛️ Văn hóa</option>
                <option value="temple">🛕 Tâm linh</option>
                <option value="nature">🌿 Thiên nhiên</option>
                <option value="education">🎓 Giáo dục</option>
                <option value="other">📌 Khác</option>
            </select>
            <select id="sortMy" class="form-select" style="max-width:150px" onchange="sortMy()">
                <option value="new">Mới nhất</option>
                <option value="old">Cũ nhất</option>
                <option value="name">Tên A→Z</option>
            </select>
        </div>

        <div class="row g-3" id="placeGrid">
            @foreach (var p in Model)
            {
                var img = p.Images.FirstOrDefault()?.Url ?? "https://placehold.co/400x250?text=No+Image";
                var inv = System.Globalization.CultureInfo.InvariantCulture;
                var dir = $"https://www.google.com/maps/dir/?api=1&destination={p.Latitude.ToString(inv)},{p.Longitude.ToString(inv)}";
                var delMsg = $"Xóa địa điểm \"{p.Name}\"? Hành động này không thể hoàn tác.";
                <div class="col-md-4 col-sm-6 my-place-card" data-name="@p.Name.ToLower()" data-cat="@(p.Category?.ToLower())" data-created="@p.CreatedAt.Ticks">
                    <div class="plan-card" style="overflow:hidden">
                        <img src="@img" alt="@p.Name"
                             style="width:100%;height:160px;object-fit:cover;border-radius:10px 10px 0 0">
                        <div style="padding:.85rem">
                            <div class="fw-bold mb-1">@p.Name</div>
                            <div class="text-muted small mb-1">
                                @switch(p.Category?.ToLower())
                                {
                                    case "home":          <text>🏠 Nhà riêng</text>      break;
                                    case "work":          <text>🏢 Công ty</text>        break;
                                    case "school":        <text>🏫 Trường học</text>     break;
                                    case "favorite":      <text>❤️ Quán yêu thích</text> break;
                                    case "restaurant":    <text>🍽️ Nhà hàng</text>     break;
                                    case "cafe":          <text>☕ Cà phê</text>          break;
                                    case "entertainment": <text>🎯 Vui chơi</text>        break;
                                    case "hotel":         <text>🏨 Lưu trú</text>         break;
                                    case "culture":       <text>🏛️ Văn hóa</text>        break;
                                    case "temple":        <text>🛕 Tâm linh</text>        break;
                                    case "nature":        <text>🌿 Thiên nhiên</text>     break;
                                    case "education":     <text>🎓 Giáo dục</text>        break;
                                    default:              <text>📌 @p.Category</text>     break;
                                }
                            </div>
                            @if (!string.IsNullOrEmpty(p.Address))
                            {
                                <div class="text-muted small">📍 @p.Address</div>
                            }
                            <div class="mt-2 mb-1">
                                @if (p.Visibility == "public")
                                { <span class="badge bg-success">🌍 Công khai</span> }
                                else
                                { <span class="badge bg-secondary">🔒 Cá nhân</span> }
                            </div>
                            <div class="d-flex gap-1 mt-2 flex-wrap align-items-center">
                                <a href="/Map/Details/@p.Id" class="btn btn-sm btn-outline-secondary" title="Xem">👁️</a>
                                <a href="/Map/EditMyPlace/@p.Id" class="btn btn-sm btn-outline-primary" title="Sửa">✏️</a>
                                <a href="@dir" target="_blank" rel="noopener" class="btn btn-sm btn-outline-success" title="Chỉ đường (Google Maps)">🧭</a>
                                <form method="post" action="/Map/DeleteMyPlace"
                                      onsubmit="return confirm(this.dataset.msg)" data-msg="@delMsg"
                                      class="d-inline ms-auto">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@p.Id">
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Xóa">🗑️</button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
        <p id="noMyResult" class="text-muted text-center p-4" style="display:none">Không tìm thấy địa điểm nào.</p>
    }

    @{
        var savedPlaces = ViewBag.SavedPlaces as List<MapHub.Models.Place> ?? new List<MapHub.Models.Place>();
    }
    @if (savedPlaces.Any())
    {
        @Html.AntiForgeryToken()
        <hr class="my-4">
        <h4 class="mb-3">❤️ Địa điểm đã lưu <span class="text-muted fs-6">(@savedPlaces.Count)</span></h4>
        <div class="row g-3">
            @foreach (var p in savedPlaces)
            {
                var simg = p.Images.FirstOrDefault()?.Url ?? "https://placehold.co/400x250?text=No+Image";
                var sinv = System.Globalization.CultureInfo.InvariantCulture;
                var sdir = $"https://www.google.com/maps/dir/?api=1&destination={p.Latitude.ToString(sinv)},{p.Longitude.ToString(sinv)}";
                <div class="col-md-4 col-sm-6" id="saved-@p.Id">
                    <div class="plan-card" style="overflow:hidden">
                        <img src="@simg" alt="@p.Name" style="width:100%;height:160px;object-fit:cover;border-radius:10px 10px 0 0">
                        <div style="padding:.85rem">
                            <div class="fw-bold mb-1">@p.Name</div>
                            @if (!string.IsNullOrEmpty(p.Address))
                            {
                                <div class="text-muted small">📍 @p.Address</div>
                            }
                            <div class="d-flex gap-1 mt-2 align-items-center">
                                <a href="/Map/Details/@p.Id" class="btn btn-sm btn-outline-secondary" title="Xem">👁️</a>
                                <a href="@sdir" target="_blank" rel="noopener" class="btn btn-sm btn-outline-success" title="Chỉ đường">🧭</a>
                                <button type="button" class="btn btn-sm btn-outline-danger ms-auto" onclick="unsavePlace(@p.Id)">❤️ Bỏ lưu</button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@section Scripts {
<script>
function unsavePlace(id) {
    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
    fetch('/Map/ToggleSave', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': token },
        body: 'placeId=' + id
    }).then(r => r.json()).then(d => {
        if (d.ok) { const c = document.getElementById('saved-' + id); if (c) c.remove(); }
    }).catch(() => alert('Lỗi, thử lại.'));
}

function filterMy() {
    const q   = (document.getElementById('searchMy').value || '').toLowerCase().trim();
    const cat = document.getElementById('catMy').value;
    let shown = 0;
    document.querySelectorAll('.my-place-card').forEach(card => {
        const okName = !q || (card.dataset.name || '').includes(q);
        const okCat  = !cat || card.dataset.cat === cat;
        const ok = okName && okCat;
        card.style.display = ok ? '' : 'none';
        if (ok) shown++;
    });
    const none = document.getElementById('noMyResult');
    if (none) none.style.display = shown ? 'none' : 'block';
}

function sortMy() {
    const mode = document.getElementById('sortMy').value;
    const grid = document.getElementById('placeGrid');
    const cards = Array.from(grid.querySelectorAll('.my-place-card'));
    cards.sort((a, b) => {
        if (mode === 'name') return (a.dataset.name || '').localeCompare(b.dataset.name || '');
        const ca = Number(a.dataset.created || 0), cb = Number(b.dataset.created || 0);
        return mode === 'old' ? ca - cb : cb - ca;
    });
    cards.forEach(c => grid.appendChild(c));
}
</script>
}
