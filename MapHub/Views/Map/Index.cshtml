// ── Routing ───────────────────────────────────────────────────────────────
let routeStart = null, routeDest = null;

function routeTo(lat, lng) {
    routeDest = { lat, lng };
    showRouteSkeleton();
    const fallback = () => drawRoute(21.0285, 105.8542, lat, lng);
    if (!navigator.geolocation) { fallback(); return; }
    navigator.geolocation.getCurrentPosition(
        pos => drawRoute(pos.coords.latitude, pos.coords.longitude, lat, lng),
        fallback, { timeout: 8000 }
    );
}

function drawRoute(slat, slng, dlat, dlng) {
    if (routingControl) map.removeControl(routingControl);
    routeStart = { lat: slat, lng: slng };
    routeDest  = { lat: dlat, lng: dlng };
    showRouteSkeleton();
    const opts = {
        waypoints: [L.latLng(slat, slng), L.latLng(dlat, dlng)],
        routeWhileDragging: false, showAlternatives: false, fitSelectedRoutes: true,
        show: false,                                   // ẩn panel mặc định của LRM (mình tự render)
        lineOptions: { styles: [{ color:'#0891b2', opacity:0.9, weight:6 }] },
        createMarker: () => null
    };
    // Vẽ tuyến bằng OSRM (miễn phí) → KHÔNG tốn token Mapbox Directions.
    // Token Mapbox chỉ dùng cho nền bản đồ. Lỗi thì rớt sang Google Maps.
    routingControl = L.Routing.control(opts)
        .on('routesfound', e => renderRoutePanel(e.routes[0]))
        .on('routingerror', () => {
            cancelRoute();
            window.open(`https://www.google.com/maps/dir/?api=1&destination=${dlat},${dlng}&origin=${slat},${slng}`, '_blank');
        }).addTo(map);
}

// ── Route panel (Material 3) ───────────────────────────────────────────────
function rpEl(id){ return document.getElementById(id); }
function fmtDist(m){ return m >= 1000 ? (m/1000).toFixed(1)+' km' : Math.round(m)+' m'; }
function fmtDur(s){ const h=Math.floor(s/3600), mi=Math.round((s%3600)/60); return h>0 ? h+'h '+mi+'m' : mi+' phút'; }
function escHtml(s){ const d=document.createElement('div'); d.textContent=s||''; return d.innerHTML; }
function routeDirIcon(type){
    const m = { Head:'bi-arrow-up', Continue:'bi-arrow-up', Straight:'bi-arrow-up',
        Left:'bi-arrow-90deg-left', SlightLeft:'bi-arrow-up-left', SharpLeft:'bi-arrow-90deg-left',
        Right:'bi-arrow-90deg-right', SlightRight:'bi-arrow-up-right', SharpRight:'bi-arrow-90deg-right',
        TurnAround:'bi-arrow-return-left', Roundabout:'bi-arrow-clockwise',
        DestinationReached:'bi-geo-alt-fill', WaypointReached:'bi-geo-alt', StartAt:'bi-record-circle' };
    return m[type] || 'bi-arrow-up';
}

function showRouteSkeleton(){
    const p = rpEl('routePanel'); if(!p) return;
    p.classList.remove('rp-hidden','rp-collapsed'); p.classList.add('rp-open','rp-loading');
    rpEl('rpName').textContent = 'Đang tính tuyến đường…';
    rpEl('rpSummary').innerHTML = '<span class="rp-sk rp-sk-sum"></span>';
    rpEl('rpSteps').innerHTML = Array(4).fill('<li class="rp-step"><span class="rp-sk rp-sk-ic"></span><span class="rp-sk rp-sk-line"></span></li>').join('');
}

function renderRoutePanel(route){
    const p = rpEl('routePanel'); if(!p) return;
    p.classList.remove('rp-hidden','rp-loading'); p.classList.add('rp-open');
    rpEl('rpName').textContent = route.name || 'Tuyến đường';
    rpEl('rpSummary').innerHTML = `<strong>${fmtDist(route.summary.totalDistance)}</strong> <span class="rp-dot">•</span> ${fmtDur(route.summary.totalTime)}`;
    rpEl('rpSteps').innerHTML = (route.instructions || []).map(ins => `
        <li class="rp-step">
            <span class="rp-step-ic"><i class="bi ${routeDirIcon(ins.type)}"></i></span>
            <span class="rp-step-text">${escHtml(ins.text)}</span>
            ${ins.distance > 0 ? `<span class="rp-step-dist">${fmtDist(ins.distance)}</span>` : ''}
        </li>`).join('');
    updateSavedCount();
}

function cancelRoute(){
    if (routingControl) { map.removeControl(routingControl); routingControl = null; }
    routeStart = routeDest = null;
    const p = rpEl('routePanel'); if(p){ p.classList.remove('rp-open','rp-loading'); p.classList.add('rp-hidden'); }
}
function toggleRouteSheet(){ rpEl('routePanel')?.classList.toggle('rp-collapsed'); }

function startNav(){
    if (!routeDest) return;
    const o = routeStart ? `&origin=${routeStart.lat},${routeStart.lng}` : '';
    // dir_action=navigate → Google Maps BẮT ĐẦU dẫn đường ngay (không chỉ xem tuyến)
    window.open(`https://www.google.com/maps/dir/?api=1&destination=${routeDest.lat},${routeDest.lng}${o}&travelmode=driving&dir_action=navigate`, '_blank');
}
function copyRouteLink(){
    if (!routeDest) return;
    const url = `${location.origin}/Map?route=${routeDest.lat},${routeDest.lng}`;
    navigator.clipboard.writeText(url).then(() => showToast('✓ Đã sao chép link tuyến đường', 'success'))
        .catch(() => prompt('Sao chép link này:', url));
}
function saveRoute(){
    if (!routeDest) return;
    const arr = JSON.parse(localStorage.getItem('cs_routes') || '[]');
    const dest = `${routeDest.lat.toFixed(5)},${routeDest.lng.toFixed(5)}`;
    if (!arr.some(r => r.dest === dest)) {
        arr.unshift({ dest, name: rpEl('rpName').textContent, at: Date.now() });
        localStorage.setItem('cs_routes', JSON.stringify(arr.slice(0, 50)));
        showToast('✓ Đã lưu vào tuyến của tôi', 'success');
    } else { showToast('Tuyến này đã được lưu', 'info'); }
    updateSavedCount();
}
function updateSavedCount(){
    const n = (JSON.parse(localStorage.getItem('cs_routes') || '[]')).length;
    const el = rpEl('rpSavedN'); if (el) { el.textContent = n; el.style.display = n ? '' : 'none'; }
}

// ── Add Place Modal ───────────────────────────────────────────────────────
// Có thể truyền sẵn lat/lng (vd click từ bản đồ chính) để điền toạ độ luôn
// ── Wizard 3 bước cho modal thêm địa điểm ──────────────────────────────────
let wizStep = 1;
function wizSet(n) {
    wizStep = Math.max(1, Math.min(3, n));
    document.querySelectorAll('#addPlaceModal .wiz-step').forEach(s => s.classList.toggle('active', +s.dataset.step === wizStep));
    document.querySelectorAll('#addPlaceModal .wiz-dot').forEach(d => {
        const dn = +d.dataset.dot;
        d.classList.toggle('active', dn === wizStep);
        d.classList.toggle('done', dn < wizStep);
    });
    document.getElementById('wizBack').style.display   = wizStep > 1 ? '' : 'none';
    document.getElementById('wizNext').style.display   = wizStep < 3 ? '' : 'none';
    document.getElementById('wizFinish').style.display = wizStep === 3 ? '' : 'none';
    const body = document.querySelector('#addPlaceModal .modal-body'); if (body) body.scrollTop = 0;
    if (wizStep === 3 && miniMap) setTimeout(() => miniMap.invalidateSize(), 80);
}
function isValidPhone(s) { return cs.isPhone(s); }

// Kiểm tra bước 1 (Tên + điện thoại). Trả về true nếu hợp lệ, đồng thời hiện lỗi inline.
function validateStep1() {
    cs.clear('newName'); cs.clear('newPhone'); cs.clear('newPhone2');
    let ok = true, first = null;
    const name = document.getElementById('newName').value.trim();
    if (!name) { cs.err('newName', 'Vui lòng nhập tên địa điểm.'); ok = false; first = first || 'newName'; }
    else if (name.length > 200) { cs.err('newName', 'Tên quá dài (tối đa 200 ký tự).'); ok = false; first = first || 'newName'; }
    const ph = document.getElementById('newPhone').value.trim();
    const ph2 = document.getElementById('newPhone2').value.trim();
    if (ph && !cs.isPhone(ph)) { cs.err('newPhone', 'Số điện thoại phải có 9–11 chữ số.'); ok = false; first = first || 'newPhone'; }
    if (ph2 && !cs.isPhone(ph2)) { cs.err('newPhone2', 'Hotline phụ phải có 9–11 chữ số.'); ok = false; first = first || 'newPhone2'; }
    if (first) document.getElementById(first).focus();
    return ok;
}

// Kiểm tra giá (bước 2): không âm, giá từ ≤ giá đến
function validatePrice() {
    cs.clear('newMinPrice'); cs.clear('newMaxPrice');
    const mn = parseInt(document.getElementById('newMinPrice').value);
    const mx = parseInt(document.getElementById('newMaxPrice').value);
    if (!isNaN(mn) && !isNaN(mx) && mn > mx) { cs.err('newMaxPrice', 'Giá đến phải lớn hơn hoặc bằng giá từ.'); return false; }
    return true;
}

// Kiểm tra vị trí (bước 3)
function validateLocation() {
    cs.clear('newLat');
    const errEl = document.getElementById('coordErr'); if (errEl) errEl.classList.remove('show');
    const lat = parseFloat(document.getElementById('newLat').value);
    const lng = parseFloat(document.getElementById('newLng').value);
    if (isNaN(lat) || isNaN(lng) || (lat === 0 && lng === 0)) {
        if (errEl) { errEl.textContent = 'Hãy bấm chọn vị trí trên bản đồ (hoặc nhập toạ độ).'; errEl.classList.add('show'); }
        return false;
    }
    if (lat < -90 || lat > 90 || lng < -180 || lng > 180) {
        if (errEl) { errEl.textContent = 'Toạ độ không hợp lệ (vĩ độ -90..90, kinh độ -180..180).'; errEl.classList.add('show'); }
        return false;
    }
    return true;
}

function wizGo(dir) {
    if (dir > 0 && wizStep === 1 && !validateStep1()) return;
    if (dir > 0 && wizStep === 2 && !validatePrice()) return;
    wizSet(wizStep + dir);
}

// Lưu nhanh: chỉ cần TÊN + VỊ TRÍ → tạo địa điểm tạm, bổ sung ảnh/chi tiết sau ở "Sửa địa điểm"
function quickSave() {
    if (!validateStep1()) { wizSet(1); return; }
    if (!validatePrice()) { wizSet(2); return; }
    if (!validateLocation()) { wizSet(3); return; }
    submitPlace();
}

// ── Drag & drop upload + preview ───────────────────────────────────────────
// Chọn video → kiểm tra ≤15MB và ≤30 giây (giống Google, không cho dài quá) + xem trước
function onVideoPick(input) {
    const prev = document.getElementById('dzPrevVid');
    const dz = input.closest('.dropzone');
    prev.innerHTML = ''; if (dz) dz.classList.remove('has-files');
    const files = Array.from(input.files || []);
    if (!files.length) return;
    if (files.length > 3) { alert('Tối đa 3 video cho mỗi địa điểm.'); input.value = ''; return; }
    if (files.some(f => f.size > 15 * 1024 * 1024)) { alert('Có video quá lớn (tối đa 15MB/video).'); input.value = ''; return; }
    let pending = files.length, invalid = false;
    files.forEach(f => {
        const url = URL.createObjectURL(f);
        const probe = document.createElement('video');
        probe.preload = 'metadata';
        probe.onloadedmetadata = () => {
            if (probe.duration > 31) { invalid = true; }
            else { const pv = document.createElement('video'); pv.src = url; pv.controls = true; pv.style.cssText = 'width:160px;border-radius:10px'; prev.appendChild(pv); }
            if (--pending === 0) finish();
        };
        probe.onerror = () => { invalid = true; if (--pending === 0) finish(); };
        probe.src = url;
    });
    function finish() {
        if (invalid) { alert('Có video quá dài (>30 giây) hoặc không đọc được — vui lòng chọn lại.'); input.value = ''; prev.innerHTML = ''; return; }
        if (dz) dz.classList.add('has-files');
    }
}

function dzPreview(inputId, prevId) {
    const input = document.getElementById(inputId), prev = document.getElementById(prevId);
    if (!input || !prev) return;
    prev.innerHTML = '';
    Array.from(input.files).forEach(f => {
        const url = URL.createObjectURL(f);
        const img = document.createElement('img');
        img.src = url; img.className = 'dz-thumb'; img.onload = () => URL.revokeObjectURL(url);
        prev.appendChild(img);
    });
    const dz = input.closest('.dropzone');
    if (dz) dz.classList.toggle('has-files', input.files.length > 0);
}
function dzInit() {
    document.querySelectorAll('#addPlaceModal .dropzone').forEach(dz => {
        if (dz._bound || !dz.dataset.dz) return; dz._bound = true;   // bỏ qua dropzone video (tự xử lý riêng)
        const input = document.getElementById(dz.dataset.dz), prev = dz.dataset.prev;
        ['dragenter','dragover'].forEach(ev => dz.addEventListener(ev, e => { e.preventDefault(); dz.classList.add('drag'); }));
        ['dragleave','dragend'].forEach(ev => dz.addEventListener(ev, e => { e.preventDefault(); dz.classList.remove('drag'); }));
        dz.addEventListener('drop', e => {
            e.preventDefault(); dz.classList.remove('drag');
            const files = e.dataTransfer.files; if (!files || !files.length) return;
            if (!input.multiple) { const dt = new DataTransfer(); dt.items.add(files[0]); input.files = dt.files; }
            else { input.files = files; }
            dzPreview(input.id, prev);
        });
    });
}

function openAddPlace(presetLat, presetLng) {
    if (map) map.closePopup();   // đóng popup "Thêm địa điểm tại đây" nếu có
    const hasPreset = (typeof presetLat === 'number' && typeof presetLng === 'number');
    if (hasPreset) {
        document.getElementById('newLat').value = presetLat.toFixed(6);
        document.getElementById('newLng').value = presetLng.toFixed(6);
    }
    dzInit();
    wizSet(1);
    const modal = new bootstrap.Modal(document.getElementById('addPlaceModal'));
    modal.show();
    document.getElementById('addPlaceModal').addEventListener('shown.bs.modal', () => {
        if (!miniMap) {
            miniMap = L.map('miniMap').setView([21.0285, 105.8542], 13);
            window.cityTiles(miniMap);
            miniMap.on('click', e => {
                document.getElementById('newLat').value = e.latlng.lat.toFixed(6);
                document.getElementById('newLng').value = e.latlng.lng.toFixed(6);
                if (miniMarker) miniMap.removeLayer(miniMarker);
                miniMarker = L.marker(e.latlng).addTo(miniMap);
            });
            if (!hasPreset && navigator.geolocation)
                navigator.geolocation.getCurrentPosition(p => miniMap.setView([p.coords.latitude, p.coords.longitude], 15));
        } else {
            miniMap.invalidateSize();
        }
        // Điền sẵn marker + center theo toạ độ click trên bản đồ chính
        if (hasPreset) {
            if (miniMarker) miniMap.removeLayer(miniMarker);
            miniMarker = L.marker([presetLat, presetLng]).addTo(miniMap);
            miniMap.setView([presetLat, presetLng], 16);
        }
    }, { once: true });
}

// Nhập tay lat/lng → di chuyển marker trên mini-map
function syncMiniMarker() {
    const lat = parseFloat(document.getElementById('newLat').value);
    const lng = parseFloat(document.getElementById('newLng').value);
    if (isNaN(lat) || isNaN(lng) || !miniMap) return;
    if (miniMarker) miniMap.removeLayer(miniMarker);
    miniMarker = L.marker([lat, lng]).addTo(miniMap);
    miniMap.setView([lat, lng], Math.max(miniMap.getZoom(), 14));
}


async function submitPlace() {
    // Kiểm tra lại toàn bộ (báo lỗi inline, nhảy về đúng bước nếu sai)
    if (!validateStep1()) { wizSet(1); return; }
    if (!validatePrice()) { wizSet(2); return; }
    if (!validateLocation()) { wizSet(3); return; }

    const lat = parseFloat(document.getElementById('newLat').value);
    const lng = parseFloat(document.getElementById('newLng').value);
    const name = document.getElementById('newName').value.trim();
    const imageFile = document.getElementById('newImageFile').files[0];
    // Ảnh KHÔNG bắt buộc — thiếu thì dùng ảnh mặc định, chủ địa điểm bổ sung sau ở "Sửa địa điểm"

    const data = {
        Name:       name,
        Category:   document.getElementById('newCategory').value,
        About:      document.getElementById('newAbout').value,
        Address:    document.getElementById('newAddress').value,
        Phone:      document.getElementById('newPhone').value,
        Phone2:     document.getElementById('newPhone2').value,
        OpenTime:   document.getElementById('newOpenTime').value,
        CloseTime:  document.getElementById('newCloseTime').value,
        WebsiteUrl: document.getElementById('newWebsite').value,
        MinPrice:   parseInt(document.getElementById('newMinPrice').value) || null,
        MaxPrice:   parseInt(document.getElementById('newMaxPrice').value) || null,
        Visibility: document.getElementById('newVisibility').value,
        Latitude:   lat,
        Longitude:  lng,
        TagIds:     Array.from(document.querySelectorAll('.new-tag-cb:checked')).map(cb => parseInt(cb.value))
    };

    const res = await fetch('/Map/AddPlace', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
    });
    const json = await res.json();

    if (res.ok && json.success) {
        if (json.id) {
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
            const uploadOne = async (file, isMenu) => {
                const fd = new FormData();
                fd.append('placeId', json.id);
                fd.append('image', file);
                fd.append('isMenu', isMenu);
                try { await fetch('/Map/UploadImage', { method: 'POST', headers: { 'RequestVerificationToken': token }, body: fd }); } catch {}
            };
            // 1) Ảnh đại diện từ máy (nếu có) — là ảnh thường đầu tiên → thành ảnh chính
            if (imageFile) await uploadOne(imageFile, false);
            // 2) Nhiều ảnh khác (không bắt buộc)
            for (const f of document.getElementById('newMoreImages').files) await uploadOne(f, false);
            // 3) Ảnh menu/thực đơn (không bắt buộc)
            for (const f of document.getElementById('newMenuImages').files) await uploadOne(f, true);
            // 4) Video ngắn (tối đa 3, không bắt buộc)
            for (const vid of Array.from(document.getElementById('newVideo').files).slice(0, 3)) {
                const fd = new FormData();
                fd.append('placeId', json.id); fd.append('image', vid); fd.append('isVideo', 'true');
                try { await fetch('/Map/UploadImage', { method: 'POST', headers: { 'RequestVerificationToken': token }, body: fd }); } catch {}
            }
        }
        bootstrap.Modal.getInstance(document.getElementById('addPlaceModal')).hide();
        const msg = data.Visibility === 'public'
            ? `Đã đăng địa điểm công khai "${data.Name}".`
            : `Đã lưu địa điểm cá nhân "${data.Name}".`;
        showToast(msg, 'success');
        loadPlaces(currentCat);
    } else if (json.message) {
        alert(json.message);   // thông báo lỗi cụ thể từ server (giới hạn gói, validation…)
    } else {
        alert('Lỗi khi lưu địa điểm. Vui lòng thử lại.');
    }
}

// ── AI Chat ───────────────────────────────────────────────────────────────
function formatAiMsg(text) {
    // Convert [text](/url) markdown links → clickable <a>
    let html = text
        .replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')
        .replace(/\[([^\]]+)\]\((\/[^)]+)\)/g,
            '<a href="$2" style="color:#7c3aed;font-weight:600;text-decoration:underline" target="_self">$1</a>')
        .replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>')
        .replace(/\n/g, '<br>');
    return html;
}
function toggleChat() {
    const w = document.getElementById('chatWidget');
    const c = document.getElementById('chatChevron');
    if (w.classList.contains('collapsed')) {
        w.classList.replace('collapsed', 'expanded');
        c.className = 'bi bi-chevron-down';
    } else {
        w.classList.replace('expanded', 'collapsed');
        c.className = 'bi bi-chevron-up';
    }
}

let _chatBusy = false;
// ── Lịch sử chat (lưu 5 đoạn gần nhất ở trình duyệt) ──
const CHAT_KEY = 'cityscout_chat_v1';
function loadChatHistory() {
    try { return JSON.parse(localStorage.getItem(CHAT_KEY) || '[]'); } catch { return []; }
}
function saveChatHistory(q, a) {
    let h = loadChatHistory();
    h.push({ q: q, a: a });
    h = h.slice(-5);                       // chỉ giữ 5 đoạn gần nhất
    try { localStorage.setItem(CHAT_KEY, JSON.stringify(h)); } catch {}
}
function restoreChatHistory() {
    const body = document.getElementById('chatBody');
    if (!body) return;
    const h = loadChatHistory();
    if (!h.length) return;
    let html = '<div class="chat-msg ai" style="opacity:.7;font-size:.8rem">— Lịch sử gần đây —</div>';
    h.forEach(m => {
        html += `<div class="chat-msg user"><b>Bạn:</b> ${escHtml(m.q)}</div>`;
        html += `<div class="chat-msg ai"><b>AI:</b> ${formatAiMsg(m.a)}</div>`;
    });
    html += '<div class="chat-msg ai" style="opacity:.7;font-size:.8rem">— Tin mới —</div>';
    body.innerHTML += html;
}
function clearChatHistory() {
    try { localStorage.removeItem(CHAT_KEY); } catch {}
    const body = document.getElementById('chatBody');
    if (body) body.innerHTML = '<div class="chat-msg ai"><em>Đã xoá lịch sử. Hỏi gì cứ hỏi nhé!</em></div>';
}

// Chip gợi ý → điền câu hỏi + gửi luôn
function chatChip(text) {
    const input = document.getElementById('chatInput');
    if (!input) return;
    input.value = text;
    const chips = document.querySelector('.chat-chips');
    if (chips) chips.remove();
    sendChat();
}

async function sendChat() {
    if (_chatBusy) return;
    const input = document.getElementById('chatInput');
    const sendBtn = document.querySelector('.btn-sm-accent');
    const body  = document.getElementById('chatBody');
    const val   = input.value.trim();
    if (!val) return;

    _chatBusy = true;
    input.disabled = true;
    if (sendBtn) sendBtn.disabled = true;

    body.innerHTML += `<div class="chat-msg user"><b>Bạn:</b> ${escHtml(val)}</div>`;
    input.value = '';
    const loadId = 'ai-' + Date.now();
    body.innerHTML += `<div id="${loadId}" class="chat-msg ai"><em>⏳ Đang suy nghĩ…</em></div>`;
    body.scrollTop = body.scrollHeight;

    try {
        const r = await fetch('/Ai/Chat', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ prompt: val })
        });
        document.getElementById(loadId)?.remove();
        if (r.ok) {
            const d = await r.json();
            body.innerHTML += `<div class="chat-msg ai"><b>AI:</b> ${formatAiMsg(d.answer)}</div>`;
            saveChatHistory(val, d.answer);
        } else {
            body.innerHTML += `<div class="chat-msg err"><i class="bi bi-exclamation-triangle-fill"></i> Không kết nối được AI.</div>`;
        }
    } catch {
        document.getElementById(loadId)?.remove();
        body.innerHTML += `<div class="chat-msg err"><i class="bi bi-exclamation-triangle-fill"></i> Lỗi hệ thống.</div>`;
    } finally {
        _chatBusy = false;
        input.disabled = false;
        if (sendBtn) sendBtn.disabled = false;
        input.focus();
    }
    body.scrollTop = body.scrollHeight;
}

// ── Helpers ───────────────────────────────────────────────────────────────
function showToast(msg, type) {
    const t = document.createElement('div');
    t.className = `map-toast map-toast-${type}`;
    const ico = type === 'success' ? 'bi-check-circle-fill' : (type === 'error' ? 'bi-x-circle-fill' : 'bi-info-circle-fill');
    t.innerHTML = `<i class="bi ${ico}"></i> ` + msg.replace(/[<>]/g, '');
    document.body.appendChild(t);
    setTimeout(() => t.classList.add('show'), 50);
    setTimeout(() => { t.classList.remove('show'); setTimeout(() => t.remove(), 300); }, 4000);
}

function escHtml(s) {
    return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
}
</script>
}
