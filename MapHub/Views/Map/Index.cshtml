async function fetchWeatherForCenter() {
    if (!isPro) return;
    const panel = document.getElementById('weatherPanel');
    if (panel) panel.classList.add('weather-updating');
    const center = map.getCenter();
    try {
        // Gọi open-meteo TRỰC TIẾP từ trình duyệt (IP người dùng, open-meteo bật CORS) — không qua server
        const url = `https://api.open-meteo.com/v1/forecast?latitude=${center.lat.toFixed(4)}`
                  + `&longitude=${center.lng.toFixed(4)}&current=temperature_2m,wind_speed_10m,weather_code`;
        const res = await fetch(url);
        if (!res.ok) throw new Error('weather http ' + res.status);
        const data = await res.json();
        const c = data.current;
        if (!c) throw new Error('no current');

        const code = c.weather_code;
        currentWeather = { temperatureC: c.temperature_2m, windKph: c.wind_speed_10m, weatherCode: code, summary: weatherCodeSummary(code) };
        document.getElementById('weatherIcon').textContent = weatherCodeIcon(code);
        document.getElementById('weatherTemp').textContent = `${Math.round(c.temperature_2m)}°C`;
        document.getElementById('weatherDesc').textContent = currentWeather.summary;
        document.getElementById('weatherWind').innerHTML = `<i class="bi bi-wind"></i> ${Math.round(c.wind_speed_10m)} km/h`;
        if (allPlaces.length > 0) renderPlaces(allPlaces);
    } catch {
        const desc = document.getElementById('weatherDesc');
        if (desc) desc.textContent = 'Thời tiết tạm thời không khả dụng';
    } finally {
        if (panel) panel.classList.remove('weather-updating');
    }
}

function weatherCodeSummary(code) {
    if (code === 0) return 'Trời quang';
    if (code === 1 || code === 2) return 'Ít mây';
    if (code === 3) return 'Nhiều mây';
    if (code === 45 || code === 48) return 'Sương mù';
    if (code === 51 || code === 53 || code === 55) return 'Mưa phùn';
    if (code === 61 || code === 63 || code === 65) return 'Mưa';
    if (code === 71 || code === 73 || code === 75) return 'Tuyết';
    if (code === 80 || code === 81 || code === 82) return 'Mưa rào';
    if (code === 95 || code === 96 || code === 99) return 'Giông sét';
    return 'Thời tiết thay đổi';
}

function weatherCodeIcon(code) {
    if (code === 0)  return '☀️';
    if (code <= 2)   return '🌤️';
    if (code === 3)  return '☁️';
    if (code <= 48)  return '🌫️';
    if (code <= 55)  return '🌦️';
    if (code <= 65)  return '🌧️';
    if (code <= 75)  return '🌨️';
    return '⛈️';
}

function getWeatherSuitability(weatherCode, category) {
    if (weatherCode == null) return 'good';
    const cat = (category || '').toLowerCase();
    const indoor = ['restaurant', 'cafe', 'hotel', 'culture', 'education'].includes(cat);
    const semiOutdoor = ['entertainment', 'temple'].includes(cat);

    if (weatherCode <= 2) return 'good';
    if (weatherCode === 3 || weatherCode === 45 || weatherCode === 48)
        return indoor ? 'good' : 'mid';
    if (weatherCode <= 55)   // light drizzle
        return indoor ? 'good' : 'mid';
    if (weatherCode <= 65)   // moderate rain
        return indoor ? 'mid' : 'bad';
    // heavy rain / storm
    return indoor ? 'mid' : 'bad';
}

function createWeatherMarker(suitability) {
    const palette = {
        good: { fill: '#22c55e', ring: '#16a34a' },
        mid:  { fill: '#f59e0b', ring: '#d97706' },
        bad:  { fill: '#ef4444', ring: '#dc2626' }
    };
    const c = palette[suitability] || palette.good;
    return L.divIcon({
        className: '',
        html: `<svg xmlns="http://www.w3.org/2000/svg" width="26" height="36" viewBox="0 0 26 36">
            <path d="M13 0C5.82 0 0 5.82 0 13c0 8.58 13 23 13 23s13-14.42 13-23C26 5.82 20.18 0 13 0z"
                  fill="${c.fill}" stroke="${c.ring}" stroke-width="1.5"/>
            <circle cx="13" cy="13" r="5.5" fill="white" opacity="0.85"/>
        </svg>`,
        iconSize:    [26, 36],
        iconAnchor:  [13, 36],
        popupAnchor: [0, -36]
    });
}

// ── Data ──────────────────────────────────────────────────────────────────
let currentBudget = '';
let openNowOnly = false;
let currentDistrict = '';

function onBudgetSlide() {
