@{
    ViewData["Title"] ??= "Bản đồ";   // tiêu đề SEO do MapController.Index đặt theo danh mục
    ViewData["BodyClass"] = "map-view";
    bool isAuth  = User.Identity?.IsAuthenticated == true;
    bool isPro   = User.IsInRole("Pro") || User.IsInRole("Admin");
    bool isAdmin = User.IsInRole("Admin");
}

<h1 class="visually-hidden">@(ViewBag.H1 ?? "Bản đồ địa điểm tại Hà Nội — CityScout")</h1>

<div class="map-shell-wrap d-flex flex-column" style="height: calc(100vh - 56px);">

    <!-- ── MAP TAG BAR ────────────────────────────────────────────────────── -->
    <div class="map-tagbar">
        <button class="map-tag active" data-cat="" onclick="filterCat(this,'')">
            <i class="bi bi-compass-fill"></i> Tất cả
        </button>
        <button class="map-tag map-tag-restaurant" data-cat="restaurant" onclick="filterCat(this,'restaurant')">
            <i class="bi bi-shop-window"></i> Nhà hàng
        </button>
        <button class="map-tag map-tag-cafe" data-cat="cafe" onclick="filterCat(this,'cafe')">
            <i class="bi bi-cup-hot-fill"></i> Cà phê
        </button>
        <button class="map-tag map-tag-entertainment" data-cat="entertainment" onclick="filterCat(this,'entertainment')">
            <i class="bi bi-joystick"></i> Vui chơi
        </button>
        <button class="map-tag map-tag-culture" data-cat="culture" onclick="filterCat(this,'culture')">
            <i class="bi bi-bank"></i> Văn hóa
        </button>
        <button class="map-tag map-tag-temple" data-cat="temple" onclick="filterCat(this,'temple')">
            <i class="bi bi-moon-stars-fill"></i> Tâm linh
        </button>
        <button class="map-tag map-tag-nature" data-cat="nature" onclick="filterCat(this,'nature')">
            <i class="bi bi-tree-fill"></i> Thiên nhiên
        </button>
        <button class="map-tag map-tag-education" data-cat="education" onclick="filterCat(this,'education')">
            <i class="bi bi-mortarboard-fill"></i> Giáo dục
        </button>
        <button class="map-tag map-tag-hotel" data-cat="hotel" onclick="filterCat(this,'hotel')">
            <i class="bi bi-building-fill"></i> Lưu trú
        </button>
    </div>

    <!-- ── MAIN AREA: SIDEBAR + MAP ──────────────────────────────────────── -->
    <div class="d-flex flex-grow-1" style="min-height:0;">

        <!-- Sidebar -->
        <div id="mapSidebar" class="map-sidebar-panel">

            <!-- Search -->
            <div class="sidebar-search-box">
                <div style="position:relative">
                    <i class="bi bi-search" style="position:absolute;left:12px;top:50%;transform:translateY(-50%);color:#94a3b8;font-size:.9rem;pointer-events:none"></i>
                    <input type="text" id="searchInput" class="sidebar-search-input" style="padding-left:34px"
                           placeholder="Tìm tên, địa chỉ...">
                </div>
            </div>

            <!-- Budget filter (thanh kéo, thay cho dropdown) -->
            <div class="sidebar-search-box" style="margin-top:.55rem">
                <label style="font-size:.83rem;color:#475569;display:block;margin-bottom:.25rem">
                    <i class="bi bi-cash-coin" style="color:#0891b2"></i> Ngân sách tối đa: <strong id="budgetLabel" style="color:#0891b2">Mọi mức giá</strong>
                </label>
                <input type="range" id="budgetRange" class="form-range" min="50000" max="2000000" step="50000"
                       value="2000000" oninput="onBudgetSlide()">
            </div>

            <!-- District filter (Quận/Huyện) -->
            <div class="sidebar-search-box" style="margin-top:.45rem">
                <select id="districtFilter" class="sidebar-search-input"
                        style="cursor:pointer;appearance:auto" onchange="filterDistrict(this.value)">
                    <option value="">📍 Mọi quận/huyện</option>
                    <option>Ba Đình</option>
                    <option>Hoàn Kiếm</option>
                    <option>Đống Đa</option>
                    <option>Hai Bà Trưng</option>
                    <option>Cầu Giấy</option>
                    <option>Thanh Xuân</option>
                    <option>Tây Hồ</option>
                    <option>Hoàng Mai</option>
                    <option>Long Biên</option>
                    <option>Hà Đông</option>
                    <option>Nam Từ Liêm</option>
                    <option>Bắc Từ Liêm</option>
                    <option>Mỹ Đình</option>
                    <option>Sơn Tây</option>
                    <option>Thạch Thất</option>
                    <option>Hòa Lạc</option>
                </select>
            </div>

            <!-- Time filter (giờ mở cửa) -->
            <label style="display:flex;align-items:center;gap:.5rem;margin:.5rem .2rem .2rem;font-size:.88rem;cursor:pointer;color:#475569">
                <input type="checkbox" id="openNowFilter" onchange="filterOpenNow(this.checked)" style="cursor:pointer">
                <i class="bi bi-clock"></i> Chỉ hiện địa điểm <strong>đang mở cửa</strong>
            </label>

            @if (!isAuth)
            {
                <div class="auth-nudge">
                    <p><i class="bi bi-box-arrow-in-right" style="color:#0891b2"></i> <strong>Đăng nhập</strong> để thêm địa điểm và lập kế hoạch.</p>
                    <div class="d-flex gap-2">
                        <a href="/Account/Login?returnUrl=/Map" class="btn-accent btn-sm-accent">Đăng nhập</a>
                        <a href="/Account/Register"            class="btn-ghost  btn-sm-ghost" >Đăng ký</a>
                    </div>
                </div>
            }
            else
            {
                <button class="btn-accent w-100 mb-2" onclick="openAddPlace()">
                    ＋ Thêm địa điểm
                </button>
            }

            <!-- Place list -->
            <div id="placeList" class="place-list-scroll">
                <div class="text-center text-muted p-4">
                    <div class="spinner-border spinner-border-sm me-1"></div> Đang tải…
                </div>
            </div>
        </div>

        <!-- Map -->
        <div id="map" class="flex-grow-1"></div>
    </div>
</div>

<!-- ── AI CHAT WIDGET ─────────────────────────────────────────────────────── -->
@if (isPro)
{
    <div id="chatWidget" class="chat-widget collapsed">
        <div class="chat-widget-header" onclick="toggleChat()">
            <span><i class="bi bi-robot"></i> Trợ lý AI CityScout</span>
            <span style="display:flex;gap:.6rem;align-items:center">
                <button type="button" title="Xoá lịch sử chat" onclick="event.stopPropagation();clearChatHistory()"
                        style="background:none;border:none;color:#fff;cursor:pointer;font-size:.85rem;opacity:.85"><i class="bi bi-trash"></i></button>
                <i class="bi bi-chevron-up" id="chatChevron"></i>
            </span>
        </div>
        <div id="chatBody" class="chat-widget-body">
            <div class="chat-msg ai"><em>Xin chào! Tôi có thể giúp bạn tìm địa điểm ăn uống, vui chơi tại Hà Nội. Hỏi thử nhé!</em></div>
        </div>
        <div class="chat-widget-footer">
            <input type="text" id="chatInput" class="chat-input-box" placeholder="Hỏi AI..."
                   onkeydown="if(event.key==='Enter') sendChat()">
            <button class="btn-accent btn-sm-accent" onclick="sendChat()"><i class="bi bi-send"></i></button>
        </div>
    </div>
}
else if (isAuth)
{
    <div class="chat-pro-teaser" onclick="window.location='/Payments/Premium'">
        <span><i class="bi bi-robot"></i> AI CityScout — <strong>Nâng cấp Pro</strong> để dùng</span>
        <i class="bi bi-lock"></i>
    </div>
}

<!-- ── ADD PLACE MODAL ────────────────────────────────────────────────────── -->
@if (isAuth)
{
    <div class="modal fade" id="addPlaceModal" tabindex="-1">
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-geo-alt-fill"></i> Thêm Địa Điểm Mới</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    @Html.AntiForgeryToken()
                    <div class="row g-3">
                        <!-- Tên & Danh mục -->
                        <div class="col-md-7">
                            <label class="form-label fw-semibold">Tên địa điểm <span class="text-danger">*</span></label>
                            <input type="text" id="newName" class="form-control" placeholder="VD: Quán Phở Bắc" required>
                        </div>
                        <div class="col-md-5">
                            <label class="form-label fw-semibold">Danh mục</label>
                            <select id="newCategory" class="form-select">
                                <optgroup label="Cá nhân">
                                    <option value="home">🏠 Nhà riêng</option>
                                    <option value="work">🏢 Công ty</option>
                                    <option value="school">🏫 Trường học</option>
                                    <option value="favorite">❤️ Quán ăn yêu thích</option>
                                </optgroup>
                                <optgroup label="Công khai">
                                    <option value="restaurant">🍽️ Nhà hàng</option>
                                    <option value="cafe">☕ Cà phê</option>
                                    <option value="entertainment">🎯 Vui chơi</option>
                                    <option value="hotel">🏨 Lưu trú</option>
                                    <option value="culture">🏛️ Văn hóa / Bảo tàng</option>
                                    <option value="temple">🛕 Tâm linh</option>
                                    <option value="nature">🌿 Thiên nhiên</option>
                                    <option value="education">🎓 Giáo dục</option>
                                    <option value="other">📌 Khác</option>
                                </optgroup>
                            </select>
                        </div>
                        <!-- Địa chỉ & Điện thoại -->
                        <div class="col-md-8">
                            <label class="form-label fw-semibold">Địa chỉ</label>
                            <input type="text" id="newAddress" class="form-control" placeholder="Số nhà, đường, quận…">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Điện thoại</label>
                            <input type="text" id="newPhone" class="form-control" placeholder="024 xxxx xxxx">
                        </div>
                        <!-- Giới thiệu -->
                        <div class="col-12">
                            <label class="form-label fw-semibold">Giới thiệu / Mô tả</label>
                            <textarea id="newAbout" class="form-control" rows="2"
                                      placeholder="Không gian, món đặc trưng, lưu ý khi đến..."></textarea>
                        </div>
                        <!-- Tags -->
                        <div class="col-12">
                            <label class="form-label fw-semibold"><i class="bi bi-tags-fill"></i> Tags</label>
                            @{ var allTagsAdd = ViewBag.AllTags as List<MapHub.Models.Tag> ?? new List<MapHub.Models.Tag>(); }
                            @if (allTagsAdd.Any())
                            {
                                <div class="d-flex flex-wrap gap-2">
                                    @foreach (var tag in allTagsAdd)
                                    {
                                        <label style="display:inline-flex;align-items:center;gap:.35rem;padding:.3rem .7rem;border:1px solid #e2e8f0;border-radius:20px;cursor:pointer;font-size:.88rem">
                                            <input type="checkbox" class="new-tag-cb" value="@tag.Id"> @tag.Name
                                        </label>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="form-text">Chưa có tag nào (Admin tạo ở Admin → Tags).</div>
                            }
                        </div>
                        <!-- Giá: nhập số Từ – Đến -->
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Giá từ (đ)</label>
                            <input type="number" id="newMinPrice" class="form-control" placeholder="VD: 30000" min="0">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Giá đến (đ)</label>
                            <input type="number" id="newMaxPrice" class="form-control" placeholder="VD: 150000" min="0">
                        </div>
                        <div class="col-12">
                            <label class="form-label fw-semibold">Website</label>
                            <input type="url" id="newWebsite" class="form-control" placeholder="https://...">
                        </div>
                        <!-- Ảnh (bắt buộc): URL hoặc tải từ máy -->
                        <div class="col-12">
                            <label class="form-label fw-semibold">Ảnh đại diện <span class="text-danger">*</span></label>
                            <input type="url" id="newImageUrl" class="form-control mb-2"
                                   placeholder="https://... (dán link ảnh)">
                            <div class="d-flex align-items-center gap-2">
                                <span class="text-muted small text-nowrap">— hoặc tải từ máy —</span>
                                <input type="file" id="newImageFile" class="form-control form-control-sm" accept="image/*">
                            </div>
                        </div>
                        <!-- Quyền riêng tư -->
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Quyền xem</label>
                            <select id="newVisibility" class="form-select">
                                <option value="private">🔒 Cá nhân (Chỉ tôi thấy)</option>
                                <option value="public">🌍 Công khai (Mọi người thấy ngay)</option>
                            </select>
                        </div>
                        <!-- Tọa độ -->
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Tọa độ (click bản đồ hoặc nhập tay)</label>
                            <div class="input-group">
                                <input type="text" id="newLat" class="form-control" placeholder="Vĩ độ" oninput="syncMiniMarker()" required>
                                <input type="text" id="newLng" class="form-control" placeholder="Kinh độ" oninput="syncMiniMarker()" required>
                            </div>
                            <small class="text-muted">Click bản đồ bên dưới, hoặc gõ trực tiếp vĩ độ / kinh độ</small>
                        </div>
                        <!-- Mini map -->
                        <div class="col-12">
                            <div id="miniMap" style="height:240px; border-radius:10px; overflow:hidden;"></div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn-ghost" data-bs-dismiss="modal">Hủy</button>
                    <button type="button" class="btn-accent" onclick="submitPlace()"><i class="bi bi-check-lg"></i> Lưu địa điểm</button>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
<script>
let map, allPlaces = [], markers = [], miniMap, miniMarker, routingControl;
let currentCat = '';
let currentWeather = null;
let weatherFetchTimeout = null;
const isPro = @(isPro ? "true" : "false");   // Pro/Admin mới được xem thời tiết
const isAuth = @(isAuth ? "true" : "false");

// Lưu / bỏ lưu địa điểm (yêu thích)
function toggleSave(placeId, btn, full) {
    if (!isAuth) { window.location = '/Account/Login?returnUrl=/Map'; return; }
    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
    fetch('/Map/ToggleSave', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': token },
        body: 'placeId=' + placeId
    }).then(r => r.json()).then(d => {
        if (!d.ok) return;
        if (btn) btn.innerHTML = d.saved
            ? (full ? '<i class="bi bi-heart-fill" style="color:#e11d48"></i> Đã lưu' : '<i class="bi bi-heart-fill" style="color:#e11d48"></i>')
            : (full ? '<i class="bi bi-heart"></i> Lưu' : '<i class="bi bi-heart"></i>');
        const p = allPlaces.find(x => x.id === placeId); if (p) p.isSaved = d.saved;
    }).catch(() => {});
}

document.addEventListener('DOMContentLoaded', () => {
    map = L.map('map').setView([21.0285, 105.8542], 12);
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '© <a href="https://openstreetmap.org">OpenStreetMap</a> contributors',
        maxZoom: 19
    }).addTo(map);

    addWeatherControl();

    // Click chỗ trống trên bản đồ → gợi ý thêm địa điểm tại đó (như Google Maps)
    if (isAuth) {
        map.on('click', e => {
            L.popup({ closeButton: true })
                .setLatLng(e.latlng)
                .setContent(`<div style="text-align:center;min-width:140px"><i class="bi bi-geo-alt-fill"></i> Thêm địa điểm tại đây?<br>
                    <button type="button" onclick="openAddPlace(${e.latlng.lat}, ${e.latlng.lng})"
                        style="margin-top:6px;padding:5px 12px;background:#0891b2;color:#fff;border:none;border-radius:8px;cursor:pointer;font-weight:600;font-size:13px"><i class="bi bi-plus-lg"></i> Thêm địa điểm</button></div>`)
                .openOn(map);
        });
    }

    if (isPro) {
        fetchWeatherForCenter();
        map.on('moveend', () => {
            clearTimeout(weatherFetchTimeout);
            weatherFetchTimeout = setTimeout(fetchWeatherForCenter, 1500);
        });
        setInterval(fetchWeatherForCenter, 15 * 60 * 1000);
    }

    // Read ?cat= from URL (links from home page category chips)
    const urlCat = new URLSearchParams(window.location.search).get('cat') || '';
    if (urlCat) {
        currentCat = urlCat;
        const btn = document.querySelector(`.map-tag[data-cat="${urlCat}"]`);
        if (btn) {
            document.querySelectorAll('.map-tag').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
        }
    }
    loadPlaces(currentCat);
    restoreChatHistory();   // hiện lại 5 đoạn chat gần nhất
});

// ── Weather ───────────────────────────────────────────────────────────────
function addWeatherControl() {
    const WeatherCtrl = L.Control.extend({
        options: { position: 'topright' },
        onAdd: function () {
            const div = L.DomUtil.create('div', 'weather-map-panel');
            div.id = 'weatherPanel';
            if (isPro) {
                div.innerHTML = `
                    <div class="weather-panel-row">
                        <div class="weather-panel-icon" id="weatherIcon">⏳</div>
                        <div>
                            <div class="weather-panel-temp" id="weatherTemp">--°C</div>
                            <div class="weather-panel-desc" id="weatherDesc">Đang tải thời tiết…</div>
                            <div class="weather-panel-wind" id="weatherWind"></div>
                        </div>
                    </div>
                    <div class="weather-legend">
                        <span class="wleg wleg-good">Phù hợp</span>
                        <span class="wleg wleg-mid">Trung bình</span>
                        <span class="wleg wleg-bad">Không phù hợp</span>
                    </div>`;
            } else {
                // Khách / Free: chặn thời tiết, mời lên Pro
                div.innerHTML = `
                    <div class="weather-panel-row">
                        <div class="weather-panel-icon"><i class="bi bi-lock-fill"></i></div>
                        <div>
                            <div class="weather-panel-temp" style="font-size:.95rem">Thời tiết theo địa điểm</div>
                            <div class="weather-panel-desc">Tính năng dành cho thành viên Pro</div>
                            <div class="weather-panel-wind">
                                <a href="/Payments/Premium" style="color:#0891b2;font-weight:700;text-decoration:none"><i class="bi bi-lightning-charge-fill"></i> Lên Pro để xem →</a>
                            </div>
                        </div>
                    </div>`;
            }
            L.DomEvent.disableClickPropagation(div);
            L.DomEvent.disableScrollPropagation(div);
            return div;
        }
    });
    map.addControl(new WeatherCtrl());
}

async function fetchWeatherForCenter() {
    if (!isPro) return;
    const panel = document.getElementById('weatherPanel');
    if (panel) panel.classList.add('weather-updating');
    const center = map.getCenter();
    try {
        // Gọi open-meteo TRỰC TIẾP từ trình duyệt (IP người dùng, open-meteo bật CORS) — không qua server
        const url = `https://api.open-meteo.com/v1/forecast?latitude=${center.lat.toFixed(4)}`
                  + `&longitude=${center.lng.toFixed(4)}&current=temperature_2m,wind_speed_10m,weather_code`;
        const res = await fetch(url);
        if (!res.ok) throw new Error('weather http ' + res.status);
        const data = await res.json();
        const c = data.current;
        if (!c) throw new Error('no current');

        const code = c.weather_code;
        currentWeather = { temperatureC: c.temperature_2m, windKph: c.wind_speed_10m, weatherCode: code, summary: weatherCodeSummary(code) };
        document.getElementById('weatherIcon').textContent = weatherCodeIcon(code);
        document.getElementById('weatherTemp').textContent = `${Math.round(c.temperature_2m)}°C`;
        document.getElementById('weatherDesc').textContent = currentWeather.summary;
        document.getElementById('weatherWind').innerHTML = `<i class="bi bi-wind"></i> ${Math.round(c.wind_speed_10m)} km/h`;
        if (allPlaces.length > 0) renderPlaces(allPlaces);
    } catch {
        const desc = document.getElementById('weatherDesc');
        if (desc) desc.textContent = 'Thời tiết tạm thời không khả dụng';
    } finally {
        if (panel) panel.classList.remove('weather-updating');
    }
}

function weatherCodeSummary(code) {
    if (code === 0) return 'Trời quang';
    if (code === 1 || code === 2) return 'Ít mây';
    if (code === 3) return 'Nhiều mây';
    if (code === 45 || code === 48) return 'Sương mù';
    if (code === 51 || code === 53 || code === 55) return 'Mưa phùn';
    if (code === 61 || code === 63 || code === 65) return 'Mưa';
    if (code === 71 || code === 73 || code === 75) return 'Tuyết';
    if (code === 80 || code === 81 || code === 82) return 'Mưa rào';
    if (code === 95 || code === 96 || code === 99) return 'Giông sét';
    return 'Thời tiết thay đổi';
}

function weatherCodeIcon(code) {
    if (code === 0)  return '☀️';
    if (code <= 2)   return '🌤️';
    if (code === 3)  return '☁️';
    if (code <= 48)  return '🌫️';
    if (code <= 55)  return '🌦️';
    if (code <= 65)  return '🌧️';
    if (code <= 75)  return '🌨️';
    return '⛈️';
}

function getWeatherSuitability(weatherCode, category) {
    if (weatherCode == null) return 'good';
    const cat = (category || '').toLowerCase();
    const indoor = ['restaurant', 'cafe', 'hotel', 'culture', 'education'].includes(cat);
    const semiOutdoor = ['entertainment', 'temple'].includes(cat);

    if (weatherCode <= 2) return 'good';
    if (weatherCode === 3 || weatherCode === 45 || weatherCode === 48)
        return indoor ? 'good' : 'mid';
    if (weatherCode <= 55)   // light drizzle
        return indoor ? 'good' : 'mid';
    if (weatherCode <= 65)   // moderate rain
        return indoor ? 'mid' : 'bad';
    // heavy rain / storm
    return indoor ? 'mid' : 'bad';
}

function createWeatherMarker(suitability) {
    const palette = {
        good: { fill: '#22c55e', ring: '#16a34a' },
        mid:  { fill: '#f59e0b', ring: '#d97706' },
        bad:  { fill: '#ef4444', ring: '#dc2626' }
    };
    const c = palette[suitability] || palette.good;
    return L.divIcon({
        className: '',
        html: `<svg xmlns="http://www.w3.org/2000/svg" width="26" height="36" viewBox="0 0 26 36">
            <path d="M13 0C5.82 0 0 5.82 0 13c0 8.58 13 23 13 23s13-14.42 13-23C26 5.82 20.18 0 13 0z"
                  fill="${c.fill}" stroke="${c.ring}" stroke-width="1.5"/>
            <circle cx="13" cy="13" r="5.5" fill="white" opacity="0.85"/>
        </svg>`,
        iconSize:    [26, 36],
        iconAnchor:  [13, 36],
        popupAnchor: [0, -36]
    });
}

// ── Data ──────────────────────────────────────────────────────────────────
let currentBudget = '';
let openNowOnly = false;
let currentDistrict = '';

function onBudgetSlide() {
    const v = parseInt(document.getElementById('budgetRange').value);
    const label = document.getElementById('budgetLabel');
    if (v >= 2000000) { label.textContent = 'Mọi mức giá'; currentBudget = ''; }
    else { label.textContent = 'Dưới ' + v.toLocaleString('vi-VN') + 'đ'; currentBudget = v; }
    // Lọc ngay lập tức trên client (không cần tải lại server) — kéo tới đâu lọc tới đó
    renderPlaces(allPlaces);
}

function filterOpenNow(checked) {
    openNowOnly = checked;
    renderPlaces(allPlaces);   // lọc client-side, không cần tải lại
}

function filterDistrict(v) {
    currentDistrict = v;
    renderPlaces(allPlaces);   // lọc theo quận/huyện trong địa chỉ (client-side)
}

// Ước lượng giờ mở cửa theo LOẠI địa điểm (Place chưa lưu giờ riêng)
function categoryHours(cat) {
    switch ((cat || '').toLowerCase()) {
        case 'hotel':         return { open: 0,  close: 24 };  // 24/24
        case 'cafe':          return { open: 7,  close: 22 };
        case 'restaurant':    return { open: 10, close: 22 };
        case 'entertainment': return { open: 9,  close: 23 };
        case 'nature':        return { open: 6,  close: 18 };
        case 'temple':        return { open: 6,  close: 18 };
        case 'culture':
        case 'education':     return { open: 8,  close: 17 };
        default:              return { open: 8,  close: 22 };
    }
}

function isOpenNow(cat) {
    const h = categoryHours(cat);
    if (h.open === 0 && h.close >= 24) return true;            // mở cả ngày
    const d = new Date();
    const now = d.getHours() + d.getMinutes() / 60;
    return now >= h.open && now < h.close;
}

function hoursLabel(cat) {
    const h = categoryHours(cat);
    if (h.open === 0 && h.close >= 24) return 'Mở cả ngày';
    const f = n => String(n).padStart(2, '0') + ':00';
    return `${f(h.open)}–${f(h.close)}`;
}

function loadPlaces(cat, q) {
    let url = '/Map/GetPlaces';
    const params = [];
    if (cat) params.push('category=' + encodeURIComponent(cat));
    if (q)   params.push('q=' + encodeURIComponent(q));
    if (params.length) url += '?' + params.join('&');

    fetch(url).then(r => r.json()).then(data => {
        allPlaces = data;
        renderPlaces(data);
    });
}

function priceLabel(min, max) {
    if (min == null && max == null) return 'Miễn phí / chưa rõ';
    const k = n => Math.round(n / 1000) + 'k';
    if (min != null && max != null && min !== max) return `${k(min)}–${k(max)}đ`;
    return k(max ?? min) + 'đ';
}

function suitLabel(s) {
    if (s === 'good') return { text: '<i class="bi bi-check-circle-fill"></i> Thời tiết phù hợp', cls: 'suit-good' };
    if (s === 'mid')  return { text: '<i class="bi bi-cloud-sun-fill"></i> Trung bình',          cls: 'suit-mid'  };
    return                   { text: '<i class="bi bi-exclamation-triangle-fill"></i> Không thuận lợi', cls: 'suit-bad'  };
}

function renderPlaces(list) {
    markers.forEach(m => map.removeLayer(m));
    markers = [];
    const container = document.getElementById('placeList');

    // Lọc client-side: ngân sách + đang mở cửa + quận/huyện (theo địa chỉ)
    let view = list;
    if (currentBudget !== '' && currentBudget != null) {
        // Giá khởi điểm của địa điểm (min, hoặc max nếu thiếu min). Địa điểm chưa rõ giá bị ẩn khi đặt ngân sách.
        view = view.filter(p => {
            const price = (p.minPrice != null) ? p.minPrice : p.maxPrice;
            return price != null && price <= currentBudget;
        });
    }
    if (openNowOnly) view = view.filter(p => isOpenNow(p.category));
    if (currentDistrict) view = view.filter(p => (p.address || '').toLowerCase().includes(currentDistrict.toLowerCase()));

    if (!view.length) {
        container.innerHTML = '<p class="text-muted text-center p-3">Không tìm thấy địa điểm nào.</p>';
        return;
    }

    container.innerHTML = '';
    view.forEach(p => {
        const suit = currentWeather
            ? getWeatherSuitability(currentWeather.weatherCode, p.category)
            : 'good';
        const sl = suitLabel(suit);

        // Weather-coloured marker
        const icon = createWeatherMarker(suit);
        const weatherPopupLine = currentWeather
            ? `<br><span style="font-size:12px;font-weight:700;color:${suit==='good'?'#16a34a':suit==='mid'?'#d97706':'#dc2626'}">${sl.text}</span>`
            : '';

        const m = L.marker([p.latitude, p.longitude], { icon }).addTo(map)
            .bindPopup(`<b>${p.name}</b><br><small>${p.address || ''}</small>${weatherPopupLine}<br>
                        <a href="/Map/Details/${p.id}" style="display:inline-block;margin-top:6px;padding:4px 12px;background:#0891b2;color:#fff;border-radius:8px;text-decoration:none;font-size:13px;font-weight:600">Xem chi tiết →</a>
                        <button type="button" onclick="toggleSave(${p.id}, this, true)" style="display:inline-block;margin:6px 0 0 6px;padding:4px 10px;background:#fff;border:1px solid #e2e8f0;border-radius:8px;font-size:13px;font-weight:600;cursor:pointer">${p.isSaved ? '<i class="bi bi-heart-fill" style="color:#e11d48"></i> Đã lưu' : '<i class="bi bi-heart"></i> Lưu'}</button>`);
        markers.push(m);

        // Sidebar card
        const card = document.createElement('div');
        card.className = 'place-list-card';
        card.innerHTML = `
            <img src="${p.primaryImage}" alt="${p.name}" class="place-list-img" loading="lazy"
                 onerror="this.onerror=null;this.src='https://placehold.co/120x120?text=No+Img'">
            <div class="place-list-info">
                <div class="place-list-name">${p.name}</div>
                <div class="place-list-cat">${categoryLabel(p.category)} · <i class="bi bi-cash-coin"></i> ${priceLabel(p.minPrice, p.maxPrice)}</div>
                <div class="place-list-cat" style="margin-top:2px">
                    <i class="bi bi-clock"></i> ${hoursLabel(p.category)} ·
                    <span style="font-weight:700;color:${isOpenNow(p.category) ? '#16a34a' : '#dc2626'}">
                        ${isOpenNow(p.category) ? 'Đang mở' : 'Đã đóng'}
                    </span>
                </div>
                ${p.address ? `<div class="place-list-addr"><i class="bi bi-geo-alt-fill"></i> ${p.address}</div>` : ''}
                <div class="place-list-footer">
                    <span class="place-list-rating">${p.rating > 0 ? '★ ' + p.rating : 'Chưa có đánh giá'}</span>
                    <div class="place-list-actions">
                        <button class="btn-list-action" onclick="toggleSave(${p.id}, this, false);event.stopPropagation();" title="Lưu">${p.isSaved ? '<i class="bi bi-heart-fill" style="color:#e11d48"></i>' : '<i class="bi bi-heart"></i>'}</button>
                        <button class="btn-list-action" onclick="routeTo(${p.latitude},${p.longitude});event.stopPropagation();" title="Chỉ đường"><i class="bi bi-compass"></i></button>
                        <a href="/Map/Details/${p.id}" class="btn-list-action" title="Chi tiết" onclick="event.stopPropagation();"><i class="bi bi-info-circle"></i></a>
                    </div>
                </div>
                ${currentWeather ? `<div class="place-weather-badge ${sl.cls}">${sl.text}</div>` : ''}
            </div>`;
        card.onclick = () => { map.setView([p.latitude, p.longitude], 16); m.openPopup(); };
        container.appendChild(card);
    });
}

function categoryLabel(cat) {
    const map = {
        restaurant:'<i class="bi bi-shop-window"></i> Nhà hàng', cafe:'<i class="bi bi-cup-hot-fill"></i> Cà phê',
        entertainment:'<i class="bi bi-joystick"></i> Vui chơi', hotel:'<i class="bi bi-building-fill"></i> Lưu trú',
        culture:'<i class="bi bi-bank"></i> Văn hóa', temple:'<i class="bi bi-moon-stars-fill"></i> Tâm linh',
        nature:'<i class="bi bi-tree-fill"></i> Thiên nhiên', education:'<i class="bi bi-mortarboard-fill"></i> Giáo dục',
        home:'<i class="bi bi-house-fill"></i> Nhà riêng', work:'<i class="bi bi-building"></i> Công ty',
        school:'<i class="bi bi-mortarboard"></i> Trường học', favorite:'<i class="bi bi-heart-fill"></i> Quán yêu thích' };
    return map[cat?.toLowerCase()] || ('<i class="bi bi-geo-alt-fill"></i> ' + (cat || 'Khác'));
}

// ── Filters ───────────────────────────────────────────────────────────────
function filterCat(btn, cat) {
    document.querySelectorAll('.map-tag').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    currentCat = cat;
    loadPlaces(cat, document.getElementById('searchInput').value.trim());
}

document.getElementById('searchInput').addEventListener('input', function() {
    clearTimeout(this._t);
    this._t = setTimeout(() => loadPlaces(currentCat, this.value.trim()), 350);
});

// ── Routing ───────────────────────────────────────────────────────────────
function routeTo(lat, lng) {
    const fallback = () => drawRoute(21.0285, 105.8542, lat, lng);
    if (!navigator.geolocation) { fallback(); return; }
    navigator.geolocation.getCurrentPosition(
        pos => drawRoute(pos.coords.latitude, pos.coords.longitude, lat, lng),
        fallback
    );
}

function drawRoute(slat, slng, dlat, dlng) {
    if (routingControl) map.removeControl(routingControl);
    routingControl = L.Routing.control({
        waypoints: [L.latLng(slat, slng), L.latLng(dlat, dlng)],
        routeWhileDragging: false, showAlternatives: false, fitSelectedRoutes: true,
        lineOptions: { styles: [{ color:'#0891b2', opacity:0.85, weight:6 }] },
        createMarker: () => null
    }).on('routingerror', () => {
        map.removeControl(routingControl);
        window.open(`https://www.google.com/maps/dir/?api=1&destination=${dlat},${dlng}&origin=${slat},${slng}`, '_blank');
    }).addTo(map);
}

// ── Add Place Modal ───────────────────────────────────────────────────────
// Có thể truyền sẵn lat/lng (vd click từ bản đồ chính) để điền toạ độ luôn
function openAddPlace(presetLat, presetLng) {
    if (map) map.closePopup();   // đóng popup "Thêm địa điểm tại đây" nếu có
    const hasPreset = (typeof presetLat === 'number' && typeof presetLng === 'number');
    if (hasPreset) {
        document.getElementById('newLat').value = presetLat.toFixed(6);
        document.getElementById('newLng').value = presetLng.toFixed(6);
    }
    const modal = new bootstrap.Modal(document.getElementById('addPlaceModal'));
    modal.show();
    document.getElementById('addPlaceModal').addEventListener('shown.bs.modal', () => {
        if (!miniMap) {
            miniMap = L.map('miniMap').setView([21.0285, 105.8542], 13);
            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png').addTo(miniMap);
            miniMap.on('click', e => {
                document.getElementById('newLat').value = e.latlng.lat.toFixed(6);
                document.getElementById('newLng').value = e.latlng.lng.toFixed(6);
                if (miniMarker) miniMap.removeLayer(miniMarker);
                miniMarker = L.marker(e.latlng).addTo(miniMap);
            });
            if (!hasPreset && navigator.geolocation)
                navigator.geolocation.getCurrentPosition(p => miniMap.setView([p.coords.latitude, p.coords.longitude], 15));
        } else {
            miniMap.invalidateSize();
        }
        // Điền sẵn marker + center theo toạ độ click trên bản đồ chính
        if (hasPreset) {
            if (miniMarker) miniMap.removeLayer(miniMarker);
            miniMarker = L.marker([presetLat, presetLng]).addTo(miniMap);
            miniMap.setView([presetLat, presetLng], 16);
        }
    }, { once: true });
}

// Nhập tay lat/lng → di chuyển marker trên mini-map
function syncMiniMarker() {
    const lat = parseFloat(document.getElementById('newLat').value);
    const lng = parseFloat(document.getElementById('newLng').value);
    if (isNaN(lat) || isNaN(lng) || !miniMap) return;
    if (miniMarker) miniMap.removeLayer(miniMarker);
    miniMarker = L.marker([lat, lng]).addTo(miniMap);
    miniMap.setView([lat, lng], Math.max(miniMap.getZoom(), 14));
}


async function submitPlace() {
    const lat = parseFloat(document.getElementById('newLat').value);
    const lng = parseFloat(document.getElementById('newLng').value);
    const name = document.getElementById('newName').value.trim();
    const imageUrl = document.getElementById('newImageUrl').value.trim();
    const imageFile = document.getElementById('newImageFile').files[0];

    if (!name) { alert('Vui lòng nhập tên địa điểm!'); return; }
    if (isNaN(lat) || isNaN(lng)) { alert('Vui lòng chọn vị trí trên bản đồ (hoặc nhập tọa độ)!'); return; }
    if (!imageUrl && !imageFile) { alert('Vui lòng thêm ảnh đại diện (dán URL hoặc tải từ máy)!'); return; }

    const data = {
        Name:       name,
        Category:   document.getElementById('newCategory').value,
        About:      document.getElementById('newAbout').value,
        Address:    document.getElementById('newAddress').value,
        Phone:      document.getElementById('newPhone').value,
        WebsiteUrl: document.getElementById('newWebsite').value,
        MinPrice:   parseFloat(document.getElementById('newMinPrice').value) || null,
        MaxPrice:   parseFloat(document.getElementById('newMaxPrice').value) || null,
        ImageUrl:   document.getElementById('newImageUrl').value,
        Visibility: document.getElementById('newVisibility').value,
        Latitude:   lat,
        Longitude:  lng,
        TagIds:     Array.from(document.querySelectorAll('.new-tag-cb:checked')).map(cb => parseInt(cb.value))
    };

    const res = await fetch('/Map/AddPlace', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
    });
    const json = await res.json();

    if (res.ok && json.success) {
        // Nếu chọn file từ máy → upload làm ảnh chính
        if (imageFile && json.id) {
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
            const fd = new FormData();
            fd.append('placeId', json.id);
            fd.append('image', imageFile);
            try { await fetch('/Map/UploadImage', { method: 'POST', headers: { 'RequestVerificationToken': token }, body: fd }); } catch {}
        }
        bootstrap.Modal.getInstance(document.getElementById('addPlaceModal')).hide();
        const msg = data.Visibility === 'public'
            ? `Đã đăng địa điểm công khai "${data.Name}".`
            : `Đã lưu địa điểm cá nhân "${data.Name}".`;
        showToast(msg, 'success');
        loadPlaces(currentCat);
    } else if (json.error === 'limit') {
        alert(json.message);
    } else {
        alert('Lỗi khi lưu địa điểm. Vui lòng thử lại.');
    }
}

// ── AI Chat ───────────────────────────────────────────────────────────────
function formatAiMsg(text) {
    // Convert [text](/url) markdown links → clickable <a>
    let html = text
        .replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;')
        .replace(/\[([^\]]+)\]\((\/[^)]+)\)/g,
            '<a href="$2" style="color:#7c3aed;font-weight:600;text-decoration:underline" target="_self">$1</a>')
        .replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>')
        .replace(/\n/g, '<br>');
    return html;
}
function toggleChat() {
    const w = document.getElementById('chatWidget');
    const c = document.getElementById('chatChevron');
    if (w.classList.contains('collapsed')) {
        w.classList.replace('collapsed', 'expanded');
        c.className = 'bi bi-chevron-down';
    } else {
        w.classList.replace('expanded', 'collapsed');
        c.className = 'bi bi-chevron-up';
    }
}

let _chatBusy = false;
// ── Lịch sử chat (lưu 5 đoạn gần nhất ở trình duyệt) ──
const CHAT_KEY = 'cityscout_chat_v1';
function loadChatHistory() {
    try { return JSON.parse(localStorage.getItem(CHAT_KEY) || '[]'); } catch { return []; }
}
function saveChatHistory(q, a) {
    let h = loadChatHistory();
    h.push({ q: q, a: a });
    h = h.slice(-5);                       // chỉ giữ 5 đoạn gần nhất
    try { localStorage.setItem(CHAT_KEY, JSON.stringify(h)); } catch {}
}
function restoreChatHistory() {
    const body = document.getElementById('chatBody');
    if (!body) return;
    const h = loadChatHistory();
    if (!h.length) return;
    let html = '<div class="chat-msg ai" style="opacity:.7;font-size:.8rem">— Lịch sử gần đây —</div>';
    h.forEach(m => {
        html += `<div class="chat-msg user"><b>Bạn:</b> ${escHtml(m.q)}</div>`;
        html += `<div class="chat-msg ai"><b>AI:</b> ${formatAiMsg(m.a)}</div>`;
    });
    html += '<div class="chat-msg ai" style="opacity:.7;font-size:.8rem">— Tin mới —</div>';
    body.innerHTML += html;
}
function clearChatHistory() {
    try { localStorage.removeItem(CHAT_KEY); } catch {}
    const body = document.getElementById('chatBody');
    if (body) body.innerHTML = '<div class="chat-msg ai"><em>Đã xoá lịch sử. Hỏi gì cứ hỏi nhé!</em></div>';
}

async function sendChat() {
    if (_chatBusy) return;
    const input = document.getElementById('chatInput');
    const sendBtn = document.querySelector('.btn-sm-accent');
    const body  = document.getElementById('chatBody');
    const val   = input.value.trim();
    if (!val) return;

    _chatBusy = true;
    input.disabled = true;
    if (sendBtn) sendBtn.disabled = true;

    body.innerHTML += `<div class="chat-msg user"><b>Bạn:</b> ${escHtml(val)}</div>`;
    input.value = '';
    const loadId = 'ai-' + Date.now();
    body.innerHTML += `<div id="${loadId}" class="chat-msg ai"><em>⏳ Đang suy nghĩ…</em></div>`;
    body.scrollTop = body.scrollHeight;

    try {
        const r = await fetch('/Ai/Chat', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ prompt: val })
        });
        document.getElementById(loadId)?.remove();
        if (r.ok) {
            const d = await r.json();
            body.innerHTML += `<div class="chat-msg ai"><b>AI:</b> ${formatAiMsg(d.answer)}</div>`;
            saveChatHistory(val, d.answer);
        } else {
            body.innerHTML += `<div class="chat-msg err"><i class="bi bi-exclamation-triangle-fill"></i> Không kết nối được AI.</div>`;
        }
    } catch {
        document.getElementById(loadId)?.remove();
        body.innerHTML += `<div class="chat-msg err"><i class="bi bi-exclamation-triangle-fill"></i> Lỗi hệ thống.</div>`;
    } finally {
        _chatBusy = false;
        input.disabled = false;
        if (sendBtn) sendBtn.disabled = false;
        input.focus();
    }
    body.scrollTop = body.scrollHeight;
}

// ── Helpers ───────────────────────────────────────────────────────────────
function showToast(msg, type) {
    const t = document.createElement('div');
    t.className = `map-toast map-toast-${type}`;
    const ico = type === 'success' ? 'bi-check-circle-fill' : (type === 'error' ? 'bi-x-circle-fill' : 'bi-info-circle-fill');
    t.innerHTML = `<i class="bi ${ico}"></i> ` + msg.replace(/[<>]/g, '');
    document.body.appendChild(t);
    setTimeout(() => t.classList.add('show'), 50);
    setTimeout(() => { t.classList.remove('show'); setTimeout(() => t.remove(), 300); }, 4000);
}

function escHtml(s) {
    return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
}
