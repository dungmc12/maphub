async function fetchWeatherForCenter() {
    if (!isPro) return;
    const panel = document.getElementById('weatherPanel');
    if (panel) panel.classList.add('weather-updating');
    const center = map.getCenter();
    try {
        // Gọi open-meteo TRỰC TIẾP từ trình duyệt (IP người dùng, open-meteo bật CORS) — không qua server
        const url = `https://api.open-meteo.com/v1/forecast?latitude=${center.lat.toFixed(4)}`
                  + `&longitude=${center.lng.toFixed(4)}&current=temperature_2m,wind_speed_10m,weather_code`;
        const res = await fetch(url);
        if (!res.ok) throw new Error('weather http ' + res.status);
        const data = await res.json();
        const c = data.current;
        if (!c) throw new Error('no current');

        const code = c.weather_code;
        currentWeather = { temperatureC: c.temperature_2m, windKph: c.wind_speed_10m, weatherCode: code, summary: weatherCodeSummary(code) };
        document.getElementById('weatherIcon').textContent = weatherCodeIcon(code);
        document.getElementById('weatherTemp').textContent = `${Math.round(c.temperature_2m)}°C`;
        document.getElementById('weatherDesc').textContent = currentWeather.summary;
        document.getElementById('weatherWind').innerHTML = `<i class="bi bi-wind"></i> ${Math.round(c.wind_speed_10m)} km/h`;
        if (allPlaces.length > 0) renderPlaces(allPlaces);
    } catch {
        const desc = document.getElementById('weatherDesc');
        if (desc) desc.textContent = 'Thời tiết tạm thời không khả dụng';
    } finally {
        if (panel) panel.classList.remove('weather-updating');
    }
}

function weatherCodeSummary(code) {
    if (code === 0) return 'Trời quang';
    if (code === 1 || code === 2) return 'Ít mây';
    if (code === 3) return 'Nhiều mây';
    if (code === 45 || code === 48) return 'Sương mù';
    if (code === 51 || code === 53 || code === 55) return 'Mưa phùn';
    if (code === 61 || code === 63 || code === 65) return 'Mưa';
    if (code === 71 || code === 73 || code === 75) return 'Tuyết';
    if (code === 80 || code === 81 || code === 82) return 'Mưa rào';
    if (code === 95 || code === 96 || code === 99) return 'Giông sét';
    return 'Thời tiết thay đổi';
}

function weatherCodeIcon(code) {
    if (code === 0)  return '☀️';
    if (code <= 2)   return '🌤️';
    if (code === 3)  return '☁️';
    if (code <= 48)  return '🌫️';
    if (code <= 55)  return '🌦️';
    if (code <= 65)  return '🌧️';
    if (code <= 75)  return '🌨️';
    return '⛈️';
}

function getWeatherSuitability(weatherCode, category) {
    if (weatherCode == null) return 'good';
    const cat = (category || '').toLowerCase();
    const indoor = ['restaurant', 'cafe', 'hotel', 'culture', 'education'].includes(cat);
    const semiOutdoor = ['entertainment', 'temple'].includes(cat);

    if (weatherCode <= 2) return 'good';
    if (weatherCode === 3 || weatherCode === 45 || weatherCode === 48)
        return indoor ? 'good' : 'mid';
    if (weatherCode <= 55)   // light drizzle
        return indoor ? 'good' : 'mid';
    if (weatherCode <= 65)   // moderate rain
        return indoor ? 'mid' : 'bad';
    // heavy rain / storm
    return indoor ? 'mid' : 'bad';
}

// Icon danh mục (Bootstrap Icons) — cố định theo loại địa điểm, để nhìn là biết như Google Maps
function catIconClass(cat) {
    const m = {
        restaurant:'bi-egg-fried', cafe:'bi-cup-hot-fill', entertainment:'bi-controller',
        hotel:'bi-building-fill', culture:'bi-bank', temple:'bi-moon-stars-fill',
        nature:'bi-tree-fill', education:'bi-mortarboard-fill',
        home:'bi-house-fill', work:'bi-briefcase-fill', school:'bi-mortarboard-fill',
        favorite:'bi-star-fill', other:'bi-geo-alt-fill'
    };
    return m[(cat || '').toLowerCase()] || 'bi-geo-alt-fill';
}

// Marker: giọt nước đổi MÀU theo thời tiết + ICON trắng theo danh mục (cố định)
function createWeatherMarker(suitability, category) {
    const palette = {
        good: { fill: '#22c55e', ring: '#16a34a' },
        mid:  { fill: '#f59e0b', ring: '#d97706' },
        bad:  { fill: '#ef4444', ring: '#dc2626' }
    };
    const c = palette[suitability] || palette.good;
    const ic = catIconClass(category);
    return L.divIcon({
        className: '',
        html: `<div style="position:relative;width:30px;height:40px;filter:drop-shadow(0 2px 2px rgba(0,0,0,.35))">
            <svg xmlns="http://www.w3.org/2000/svg" width="30" height="40" viewBox="0 0 26 36">
                <path d="M13 0C5.82 0 0 5.82 0 13c0 8.58 13 23 13 23s13-14.42 13-23C26 5.82 20.18 0 13 0z"
                      fill="${c.fill}" stroke="${c.ring}" stroke-width="1.5"/>
            </svg>
            <i class="bi ${ic}" style="position:absolute;top:7px;left:50%;transform:translateX(-50%);color:#fff;font-size:13px;line-height:1"></i>
        </div>`,
        iconSize:    [30, 40],
        iconAnchor:  [15, 40],
        popupAnchor: [0, -40]
    });
}

// ── Data ──────────────────────────────────────────────────────────────────
const BUDGET_MAX = 2000000, BUDGET_GAP = 50000;
let budgetLo = 0, budgetHi = BUDGET_MAX;   // khoảng giá đang chọn (2 đầu)
let openNowOnly = false;
let currentDistrict = '';

function fmtMoney(v) { return v >= 1000000 ? (v/1000000).toLocaleString('vi-VN',{maximumFractionDigits:1})+'tr' : (v/1000)+'k'; }

function onBudgetSlide(which) {
    const minEl = document.getElementById('budgetMin');
    const maxEl = document.getElementById('budgetMax');
    let lo = parseInt(minEl.value), hi = parseInt(maxEl.value);
    // Không cho 2 đầu vượt qua nhau (giữ khoảng cách tối thiểu 1 bước)
    if (hi - lo < BUDGET_GAP) {
        if (which === 'min') { lo = Math.min(lo, BUDGET_MAX - BUDGET_GAP); hi = lo + BUDGET_GAP; maxEl.value = hi; }
        else                 { hi = Math.max(hi, BUDGET_GAP); lo = hi - BUDGET_GAP; minEl.value = lo; }
    }
    budgetLo = lo; budgetHi = hi;

    // Nhãn: full = mọi mức giá; còn lại "200k – 400k" (hi tối đa ghi "2tr+")
    const label = document.getElementById('budgetLabel');
    label.textContent = (lo <= 0 && hi >= BUDGET_MAX) ? 'Mọi mức giá'
        : fmtMoney(lo) + ' – ' + (hi >= BUDGET_MAX ? '2tr+' : fmtMoney(hi));

    // Tô đoạn đã chọn trên track
    const fill = document.getElementById('drFill');
    fill.style.left  = (lo / BUDGET_MAX * 100) + '%';
    fill.style.right = (100 - hi / BUDGET_MAX * 100) + '%';

    renderPlaces(allPlaces);   // lọc ngay client-side, không tải lại server
}

function filterOpenNow(checked) {
    openNowOnly = checked;
    renderPlaces(allPlaces);   // lọc client-side, không cần tải lại
}

function filterDistrict(v) {
    currentDistrict = v;
    renderPlaces(allPlaces);   // lọc theo quận/huyện trong địa chỉ (client-side)
}

// Ước lượng giờ mở cửa theo LOẠI địa điểm (Place chưa lưu giờ riêng)
function categoryHours(cat) {
    switch ((cat || '').toLowerCase()) {
        case 'hotel':         return { open: 0,  close: 24 };  // 24/24
        case 'cafe':          return { open: 7,  close: 22 };
        case 'restaurant':    return { open: 10, close: 22 };
        case 'entertainment': return { open: 9,  close: 23 };
        case 'nature':        return { open: 6,  close: 18 };
        case 'temple':        return { open: 6,  close: 18 };
        case 'culture':
        case 'education':     return { open: 8,  close: 17 };
        default:              return { open: 8,  close: 22 };
    }
}

// Giờ thật của địa điểm (openTime/closeTime "HH:MM") nếu có, không thì ước lượng theo loại
function parseHM(s) { const m = /^(\d{1,2}):(\d{2})/.exec(s || ''); return m ? (+m[1] + (+m[2]) / 60) : null; }
function placeHours(p) {
    const o = parseHM(p.openTime), c = parseHM(p.closeTime);
    if (o != null && c != null) return { open: o, close: c, real: true };
    return categoryHours(p.category);
}
function isOpenNow(p) {
    const h = placeHours(p);
    if (h.open === 0 && h.close >= 24) return true;            // mở cả ngày
    const d = new Date();
    const now = d.getHours() + d.getMinutes() / 60;
    if (h.close <= h.open) return now >= h.open || now < h.close;   // qua nửa đêm (vd 18:00–02:00)
    return now >= h.open && now < h.close;
}
function hoursLabel(p) {
    const h = placeHours(p);
    if (h.open === 0 && h.close >= 24) return 'Mở cả ngày';
    const f = n => { const hh = Math.floor(n) % 24, mm = Math.round((n - Math.floor(n)) * 60); return String(hh).padStart(2, '0') + ':' + String(mm).padStart(2, '0'); };
    return `${f(h.open)}–${f(h.close)}` + (h.real ? '' : ' (ước tính)');
}

function loadPlaces(cat, q) {
    let url = '/Map/GetPlaces';
    const params = [];
    if (cat) params.push('category=' + encodeURIComponent(cat));
    if (q)   params.push('q=' + encodeURIComponent(q));
    if (params.length) url += '?' + params.join('&');

    fetch(url).then(r => r.json()).then(data => {
        allPlaces = data;
        renderPlaces(data);
    });
}

function priceLabel(min, max) {
    if (min == null && max == null) return 'Miễn phí / chưa rõ';
    const k = n => Math.round(n / 1000) + 'k';
    if (min != null && max != null && min !== max) return `${k(min)}–${k(max)}đ`;
    return k(max ?? min) + 'đ';
}

function suitLabel(s) {
    if (s === 'good') return { text: '<i class="bi bi-check-circle-fill"></i> Thời tiết phù hợp', cls: 'suit-good' };
    if (s === 'mid')  return { text: '<i class="bi bi-cloud-sun-fill"></i> Trung bình',          cls: 'suit-mid'  };
    return                   { text: '<i class="bi bi-exclamation-triangle-fill"></i> Không thuận lợi', cls: 'suit-bad'  };
}

function renderPlaces(list) {
    if (clusterGroup) clusterGroup.clearLayers();
    else markers.forEach(m => map.removeLayer(m));
    markers = [];
    const container = document.getElementById('placeList');

    // Lọc client-side: focus 1 địa điểm (từ /Map?place=) + ngân sách + đang mở cửa + quận/huyện
    let view = list;
    if (focusPlaceId != null) view = view.filter(p => p.id === focusPlaceId);
    if (budgetLo > 0 || budgetHi < BUDGET_MAX) {
        // Hiện địa điểm có khoảng giá GIAO với khoảng đã chọn. MIỄN PHÍ / chưa rõ giá LUÔN hiện.
        const hiCap = (budgetHi >= BUDGET_MAX) ? Infinity : budgetHi;
        view = view.filter(p => {
            if (p.minPrice == null && p.maxPrice == null) return true;
            const pMin = (p.minPrice != null) ? p.minPrice : p.maxPrice;
            const pMax = (p.maxPrice != null) ? p.maxPrice : p.minPrice;
            return pMin <= hiCap && pMax >= budgetLo;
        });
    }
    if (openNowOnly) view = view.filter(p => isOpenNow(p));
    if (currentDistrict) view = view.filter(p => (p.address || '').toLowerCase().includes(currentDistrict.toLowerCase()));

    if (!view.length) {
        container.innerHTML = focusPlaceId != null
            ? '<div class="p-3 text-center"><p class="text-muted mb-2">Không tìm thấy địa điểm này.</p><button class="btn-accent btn-sm-accent" onclick="clearFocus()">Xem tất cả địa điểm</button></div>'
            : '<p class="text-muted text-center p-3">Không tìm thấy địa điểm nào.</p>';
        return;
    }

    container.innerHTML = '';
    if (focusPlaceId != null) {
        const bar = document.createElement('div');
        bar.style.cssText = 'display:flex;align-items:center;justify-content:space-between;gap:.5rem;padding:.55rem .75rem;margin-bottom:.6rem;background:var(--accent-soft);border-radius:12px;font-size:.85rem;font-weight:600;color:var(--accent-dark)';
        bar.innerHTML = '<span>Đang xem 1 địa điểm của bạn</span><button onclick="clearFocus()" style="border:none;background:#fff;border-radius:8px;padding:.25rem .6rem;font-weight:600;cursor:pointer;color:var(--accent)">Xem tất cả</button>';
        container.appendChild(bar);
    }
    // 1) MARKER — dựng tất cả rồi nạp 1 lần vào cluster (nhanh hơn add từng cái nhiều).
    //    Cluster chỉ vẽ phần trong vùng nhìn → hàng nghìn điểm vẫn mượt.
    const markerOf = {};
    view.forEach(p => {
        const suit = currentWeather ? getWeatherSuitability(currentWeather.weatherCode, p.category) : 'good';
        const sl = suitLabel(suit);
        const icon = createWeatherMarker(suit, p.category);
        const weatherPopupLine = currentWeather
            ? `<br><span style="font-size:12px;font-weight:700;color:${suit==='good'?'#16a34a':suit==='mid'?'#d97706':'#dc2626'}">${sl.text}</span>`
            : '';
        const m = L.marker([p.latitude, p.longitude], { icon })
            .bindPopup(`<b>${p.name}</b><br><small>${p.address || ''}</small>${weatherPopupLine}<br>
                        <a href="/Map/Details/${p.id}" style="display:inline-block;margin-top:6px;padding:4px 12px;background:#0891b2;color:#fff;border-radius:8px;text-decoration:none;font-size:13px;font-weight:600">Xem chi tiết →</a>
                        <button type="button" onclick="toggleSave(${p.id}, this, true)" style="display:inline-block;margin:6px 0 0 6px;padding:4px 10px;background:#fff;border:1px solid #e2e8f0;border-radius:8px;font-size:13px;font-weight:600;cursor:pointer">${p.isSaved ? '<i class="bi bi-heart-fill" style="color:#e11d48"></i> Đã lưu' : '<i class="bi bi-heart"></i> Lưu'}</button>`);
        markers.push(m);
        markerOf[p.id] = m;
    });
    if (clusterGroup) clusterGroup.addLayers(markers);   // bulk add — không block UI
    else markers.forEach(m => m.addTo(map));

    // 2) SIDEBAR — render theo lô + nạp tiếp khi cuộn tới (tránh dựng hàng nghìn DOM cùng lúc).
    const BATCH = 40;
    let rendered = 0;
    function makeCard(p, idx) {
        const suit = currentWeather ? getWeatherSuitability(currentWeather.weatherCode, p.category) : 'good';
        const sl = suitLabel(suit);
        const m = markerOf[p.id];
        const card = document.createElement('div');
        card.className = 'place-list-card';
        card.innerHTML = `
            <img src="${p.primaryImage}" alt="${p.name}" class="place-list-img" loading="lazy"
                 onerror="this.onerror=null;this.src='https://placehold.co/120x120?text=No+Img'">
            <div class="place-list-info">
                <div class="place-list-name">${p.name}</div>
                <div class="place-list-cat">${categoryLabel(p.category)} · <i class="bi bi-cash-coin"></i> ${priceLabel(p.minPrice, p.maxPrice)}</div>
                <div class="place-list-cat" style="margin-top:2px">
                    <i class="bi bi-clock"></i> ${hoursLabel(p)} ·
                    <span style="font-weight:700;color:${isOpenNow(p) ? '#16a34a' : '#dc2626'}">
                        ${isOpenNow(p) ? 'Đang mở' : 'Đã đóng'}
                    </span>
                </div>
                ${p.address ? `<div class="place-list-addr"><i class="bi bi-geo-alt-fill"></i> ${p.address}</div>` : ''}
                <div class="place-list-footer">
                    <span class="place-list-rating">${p.rating > 0 ? '★ ' + p.rating : 'Chưa có đánh giá'}</span>
                    <div class="place-list-actions">
                        <button class="btn-list-action" onclick="toggleSave(${p.id}, this, false);event.stopPropagation();" title="Lưu">${p.isSaved ? '<i class="bi bi-heart-fill" style="color:#e11d48"></i>' : '<i class="bi bi-heart"></i>'}</button>
                        <button class="btn-list-action" onclick="routeTo(${p.latitude},${p.longitude});event.stopPropagation();" title="Chỉ đường"><i class="bi bi-compass"></i></button>
                        <a href="/Map/Details/${p.id}" class="btn-list-action" title="Chi tiết" onclick="event.stopPropagation();"><i class="bi bi-info-circle"></i></a>
                    </div>
                </div>
                ${currentWeather ? `<div class="place-weather-badge ${sl.cls}">${sl.text}</div>` : ''}
            </div>`;
        card.onclick = () => { if (clusterGroup && m) clusterGroup.zoomToShowLayer(m, () => m.openPopup()); else { map.setView([p.latitude, p.longitude], 16); if (m) m.openPopup(); } };
        card.style.animationDelay = Math.min(idx, 12) * 30 + 'ms';
        return card;
    }
    let sentinel = null, io = null;
    function renderBatch() {
        const frag = document.createDocumentFragment();
        const end = Math.min(rendered + BATCH, view.length);
        for (let i = rendered; i < end; i++) frag.appendChild(makeCard(view[i], i - rendered));
        if (sentinel) container.removeChild(sentinel);
        container.appendChild(frag);
        rendered = end;
        if (rendered < view.length) {
            sentinel = document.createElement('div');
            sentinel.style.height = '1px';
            container.appendChild(sentinel);
            io.observe(sentinel);
        } else if (io) { io.disconnect(); }
    }
    io = ('IntersectionObserver' in window)
        ? new IntersectionObserver(es => { if (es.some(e => e.isIntersecting)) renderBatch(); }, { root: container, rootMargin: '300px' })
        : { observe(){}, disconnect(){} };
    renderBatch();
    // Trình duyệt cũ không có IO → render hết phần còn lại
    if (!('IntersectionObserver' in window)) while (rendered < view.length) renderBatch();

    // Focus 1 địa điểm (từ /Map?place=) → căn giữa + mở popup
    if (focusPlaceId != null && markers.length && view.length) {
        map.setView([view[0].latitude, view[0].longitude], 16);
        setTimeout(() => markers[0].openPopup(), 250);
    }
}

