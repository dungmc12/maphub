@{
    ViewData["Title"] ??= "Bản đồ";   // tiêu đề SEO do MapController.Index đặt theo danh mục
    ViewData["BodyClass"] = "map-view";
    bool isAuth  = User.Identity?.IsAuthenticated == true;
    bool isPro   = User.IsInRole("Pro") || User.IsInRole("Admin");
    bool isAdmin = User.IsInRole("Admin");
}

<h1 class="visually-hidden">@(ViewBag.H1 ?? "Bản đồ địa điểm tại Hà Nội — CityScout")</h1>

<div class="map-shell-wrap d-flex flex-column" style="height: calc(100vh - 60px);">

    <!-- ── MAP TAG BAR ────────────────────────────────────────────────────── -->
    <div class="map-tagbar">
        <button class="map-tag active" data-cat="" onclick="filterCat(this,'')">
            <i class="bi bi-compass-fill"></i> Tất cả
        </button>
        <button class="map-tag map-tag-restaurant" data-cat="restaurant" onclick="filterCat(this,'restaurant')">
            <i class="bi bi-shop-window"></i> Nhà hàng
        </button>
        <button class="map-tag map-tag-cafe" data-cat="cafe" onclick="filterCat(this,'cafe')">
            <i class="bi bi-cup-hot-fill"></i> Cà phê
        </button>
        <button class="map-tag map-tag-entertainment" data-cat="entertainment" onclick="filterCat(this,'entertainment')">
            <i class="bi bi-joystick"></i> Vui chơi
        </button>
        <button class="map-tag map-tag-culture" data-cat="culture" onclick="filterCat(this,'culture')">
            <i class="bi bi-bank"></i> Văn hóa
        </button>
        <button class="map-tag map-tag-temple" data-cat="temple" onclick="filterCat(this,'temple')">
            <i class="bi bi-moon-stars-fill"></i> Tâm linh
        </button>
        <button class="map-tag map-tag-nature" data-cat="nature" onclick="filterCat(this,'nature')">
            <i class="bi bi-tree-fill"></i> Thiên nhiên
        </button>
        <button class="map-tag map-tag-education" data-cat="education" onclick="filterCat(this,'education')">
            <i class="bi bi-mortarboard-fill"></i> Giáo dục
        </button>
        <button class="map-tag map-tag-hotel" data-cat="hotel" onclick="filterCat(this,'hotel')">
            <i class="bi bi-building-fill"></i> Lưu trú
        </button>
    </div>

    <!-- ── MAIN AREA: SIDEBAR + MAP ──────────────────────────────────────── -->
    <div class="d-flex flex-grow-1 map-body" style="min-height:0;">

        <!-- Sidebar -->
        <div id="mapSidebar" class="map-sidebar-panel">

            <!-- Search -->
            <div class="sidebar-search-box">
                <div style="position:relative">
                    <i class="bi bi-search" style="position:absolute;left:12px;top:50%;transform:translateY(-50%);color:#94a3b8;font-size:.9rem;pointer-events:none"></i>
                    <input type="text" id="searchInput" class="sidebar-search-input" style="padding-left:34px"
                           placeholder="Tìm tên, địa chỉ, tag…">
                </div>
                @{ var mapTags = ViewBag.AllTags as List<MapHub.Models.Tag> ?? new List<MapHub.Models.Tag>(); }
                @if (mapTags.Any())
                {
                    <div class="search-tag-row">
                        @foreach (var t in mapTags)
                        {
                            <button type="button" class="search-tag-chip" onclick="searchByTag('@t.Name.Replace("'", "\\'")')">@t.Name</button>
                        }
                    </div>
                }
            </div>

            <!-- Budget filter — thanh kéo 2 đầu (từ → đến) -->
            <div class="sidebar-search-box" style="margin-top:.55rem">
                <label style="font-size:.83rem;color:#475569;display:block;margin-bottom:.4rem">
                    <i class="bi bi-cash-coin" style="color:#0891b2"></i> Khoảng giá: <strong id="budgetLabel" style="color:#0891b2">Mọi mức giá</strong>
                </label>
                <div class="dual-range">
                    <div class="dr-track"></div>
                    <div class="dr-fill" id="drFill" style="left:0;right:0"></div>
                    <input type="range" id="budgetMin" min="0" max="2000000" step="50000" value="0" oninput="onBudgetSlide('min')">
                    <input type="range" id="budgetMax" min="0" max="2000000" step="50000" value="2000000" oninput="onBudgetSlide('max')">
                </div>
            </div>

            <!-- Quận/huyện + Đang mở cửa: gom 1 hàng gọn -->
            <div class="sidebar-search-box" style="margin-top:.45rem;display:flex;gap:.5rem;align-items:center">
                <select id="districtFilter" class="sidebar-search-input"
                        style="flex:1;min-width:0;cursor:pointer;appearance:auto" onchange="filterDistrict(this.value)">
                    <option value="">📍 Mọi quận/huyện</option>
                    <option>Ba Đình</option>
                    <option>Hoàn Kiếm</option>
                    <option>Đống Đa</option>
                    <option>Hai Bà Trưng</option>
                    <option>Cầu Giấy</option>
                    <option>Thanh Xuân</option>
                    <option>Tây Hồ</option>
                    <option>Hoàng Mai</option>
                    <option>Long Biên</option>
                    <option>Hà Đông</option>
                    <option>Nam Từ Liêm</option>
                    <option>Bắc Từ Liêm</option>
                    <option>Mỹ Đình</option>
                    <option>Sơn Tây</option>
                    <option>Thạch Thất</option>
                    <option>Hòa Lạc</option>
                </select>
                <label style="display:flex;align-items:center;gap:.3rem;font-size:.8rem;cursor:pointer;color:#475569;white-space:nowrap" title="Chỉ hiện địa điểm đang mở cửa">
                    <input type="checkbox" id="openNowFilter" onchange="filterOpenNow(this.checked)" style="cursor:pointer">
                    <i class="bi bi-clock"></i> Đang mở
                </label>
            </div>

            @if (!isAuth)
            {
                <div class="auth-nudge">
                    <p><i class="bi bi-box-arrow-in-right" style="color:#0891b2"></i> <strong>Đăng nhập</strong> để thêm địa điểm và lập kế hoạch.</p>
                    <div class="d-flex gap-2">
                        <a href="/Account/Login?returnUrl=/Map" class="btn-accent btn-sm-accent">Đăng nhập</a>
                        <a href="/Account/Register"            class="btn-ghost  btn-sm-ghost" >Đăng ký</a>
                    </div>
                </div>
            }
            else
            {
                <button class="btn-accent w-100 mb-2" onclick="openAddPlace()">
                    ＋ Thêm địa điểm
                </button>
            }

            <!-- Place list -->
            <div id="placeList" class="place-list-scroll">
                @for (int s = 0; s < 6; s++)
                {
                    <div class="skeleton-card">
                        <div class="skel skel-img"></div>
                        <div style="flex:1">
                            <div class="skel skel-line" style="width:70%"></div>
                            <div class="skel skel-line" style="width:45%"></div>
                            <div class="skel skel-line" style="width:85%;margin-top:14px"></div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Map -->
        <div id="map" class="flex-grow-1"></div>
    </div>
</div>

<!-- ── ROUTE PANEL (Material 3) ──────────────────────────────────────────── -->
<div id="routePanel" class="route-panel rp-hidden">
    <div class="rp-grab" onclick="toggleRouteSheet()"></div>
    <div class="rp-header" onclick="if(window.innerWidth<768)toggleRouteSheet()">
        <div class="rp-head-main">
            <div class="rp-name" id="rpName">Tuyến đường</div>
            <div class="rp-summary" id="rpSummary"></div>
        </div>
        <button type="button" class="rp-x" onclick="event.stopPropagation();cancelRoute()" title="Đóng" aria-label="Đóng tuyến đường"><i class="bi bi-x-lg"></i></button>
    </div>
    <div class="rp-actions">
        <button type="button" class="rp-btn rp-btn-primary" onclick="startNav()"><i class="bi bi-navigation-fill"></i> Bắt đầu</button>
        <button type="button" class="rp-btn" onclick="saveRoute()" title="Lưu tuyến"><i class="bi bi-bookmark-plus"></i> Lưu <span class="rp-badge" id="rpSavedN" style="display:none">0</span></button>
        <button type="button" class="rp-btn" onclick="copyRouteLink()" title="Sao chép link"><i class="bi bi-link-45deg"></i> Link</button>
        <button type="button" class="rp-btn rp-btn-ghost" onclick="cancelRoute()" title="Hủy tuyến"><i class="bi bi-x-circle"></i> Hủy</button>
    </div>
    <ul class="rp-steps" id="rpSteps"></ul>
</div>

<!-- ── AI CHAT WIDGET ─────────────────────────────────────────────────────── -->
@if (isPro)
{
    <div id="chatWidget" class="chat-widget collapsed">
        <div class="chat-widget-header" onclick="toggleChat()">
            <span><i class="bi bi-robot"></i> Trợ lý AI CityScout</span>
            <span style="display:flex;gap:.6rem;align-items:center">
                <button type="button" title="Xoá lịch sử chat" onclick="event.stopPropagation();clearChatHistory()"
                        style="background:none;border:none;color:#fff;cursor:pointer;font-size:.85rem;opacity:.85"><i class="bi bi-trash"></i></button>
                <i class="bi bi-chevron-up" id="chatChevron"></i>
            </span>
        </div>
        <div id="chatBody" class="chat-widget-body">
            <div class="chat-msg ai"><em>Xin chào! Tôi có thể giúp bạn tìm địa điểm ăn uống, vui chơi tại Hà Nội. Hỏi thử nhé!</em></div>
            <div class="chat-chips">
                <button type="button" class="chat-chip" onclick="chatChip('Đi chơi tối nay ở Hà Nội')">Đi chơi tối nay</button>
                <button type="button" class="chat-chip" onclick="chatChip('Quán cà phê yên tĩnh để học bài')">Cà phê học tập</button>
                <button type="button" class="chat-chip" onclick="chatChip('Địa điểm chụp ảnh đẹp ở Hà Nội')">Chụp ảnh đẹp</button>
                <button type="button" class="chat-chip" onclick="chatChip('Địa điểm vui chơi cho gia đình')">Cho gia đình</button>
            </div>
        </div>
        <div class="chat-widget-footer">
            <input type="text" id="chatInput" class="chat-input-box" placeholder="Hỏi AI..."
                   onkeydown="if(event.key==='Enter') sendChat()">
            <button class="btn-accent btn-sm-accent" onclick="sendChat()"><i class="bi bi-send"></i></button>
        </div>
    </div>
}
else if (isAuth)
{
    <div class="chat-pro-teaser" onclick="window.location='/Payments/Premium'">
        <span><i class="bi bi-robot"></i> AI CityScout — <strong>Nâng cấp Pro</strong> để dùng</span>
        <i class="bi bi-lock"></i>
    </div>
}

<!-- ── ADD PLACE MODAL ────────────────────────────────────────────────────── -->
@if (isAuth)
{
    <div class="modal fade" id="addPlaceModal" tabindex="-1">
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-geo-alt-fill"></i> Thêm Địa Điểm Mới</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body wiz">
                    @Html.AntiForgeryToken()
                    <!-- Stepper -->
                    <div class="wiz-head">
                        <div class="wiz-dot active" data-dot="1"><b>1</b><span>Thông tin</span></div>
                        <div class="wiz-bar"></div>
                        <div class="wiz-dot" data-dot="2"><b>2</b><span>Hình ảnh</span></div>
                        <div class="wiz-bar"></div>
                        <div class="wiz-dot" data-dot="3"><b>3</b><span>Vị trí</span></div>
                    </div>

                    <!-- STEP 1 — Thông tin cơ bản -->
                    <div class="wiz-step active" data-step="1">
                        <div class="alert alert-light border d-flex align-items-center gap-2 py-2 mb-3" style="font-size:.85rem">
                            <span style="font-size:1.1rem">⚡</span>
                            <span>Vội? Chỉ cần <b>tên</b> + <b>chọn vị trí trên bản đồ</b> rồi bấm <b>“Lưu nhanh”</b>. Ảnh, giờ, giá, menu… bổ sung sau ở <b>“Sửa địa điểm”</b> (chỉ bạn sửa được).</span>
                        </div>
                        <div class="row g-3">
                            <div class="col-md-7">
                                <label class="form-label fw-semibold">Tên địa điểm <span class="text-danger">*</span></label>
                                <input type="text" id="newName" class="form-control" placeholder="VD: Quán Phở Bắc" maxlength="200">
                            </div>
                            <div class="col-md-5">
                                <label class="form-label fw-semibold">Danh mục</label>
                                <select id="newCategory" class="form-select">
                                    <optgroup label="Cá nhân">
                                        <option value="home">Nhà riêng</option>
                                        <option value="work">Công ty</option>
                                        <option value="school">Trường học</option>
                                        <option value="favorite">Quán ăn yêu thích</option>
                                    </optgroup>
                                    <optgroup label="Công khai">
                                        <option value="restaurant">Nhà hàng</option>
                                        <option value="cafe">Cà phê</option>
                                        <option value="entertainment">Vui chơi</option>
                                        <option value="hotel">Lưu trú</option>
                                        <option value="culture">Văn hóa / Bảo tàng</option>
                                        <option value="temple">Tâm linh</option>
                                        <option value="nature">Thiên nhiên</option>
                                        <option value="education">Giáo dục</option>
                                        <option value="other">Khác</option>
                                    </optgroup>
                                </select>
                            </div>
                            <div class="col-12">
                                <label class="form-label fw-semibold">Địa chỉ</label>
                                <input type="text" id="newAddress" class="form-control" placeholder="Số nhà, đường, quận…">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Điện thoại</label>
                                <input type="tel" id="newPhone" class="form-control" placeholder="0912345678" data-digits maxlength="11">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Hotline phụ <small class="text-muted">(tùy chọn)</small></label>
                                <input type="tel" id="newPhone2" class="form-control" placeholder="Số dự phòng khi số trên bận" data-digits maxlength="11">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Giờ mở cửa</label>
                                <input type="time" id="newOpenTime" class="form-control">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label fw-semibold">Giờ đóng cửa</label>
                                <input type="time" id="newCloseTime" class="form-control">
                            </div>
                            <div class="col-12">
                                <label class="form-label fw-semibold">Giới thiệu / Mô tả</label>
                                <textarea id="newAbout" class="form-control" rows="2"
                                          placeholder="Không gian, món đặc trưng, lưu ý khi đến..."></textarea>
                            </div>
                            <div class="col-12">
                                <label class="form-label fw-semibold">Tags</label>
                                @{ var allTagsAdd = ViewBag.AllTags as List<MapHub.Models.Tag> ?? new List<MapHub.Models.Tag>(); }
                                @if (allTagsAdd.Any())
                                {
                                    <div class="tag-pills">
                                        @foreach (var tag in allTagsAdd)
                                        {
                                            <label class="tag-pill"><input type="checkbox" class="new-tag-cb" value="@tag.Id" hidden>@tag.Name</label>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <div class="form-text">Chưa có tag nào (Admin tạo ở Admin → Tags).</div>
                                }
                            </div>
                            <div class="col-md-7">
                                <label class="form-label fw-semibold">Khoảng giá <small class="text-muted">(đồng)</small></label>
                                <div class="input-group">
                                    <span class="input-group-text">Từ</span>
                                    <input type="number" id="newMinPrice" class="form-control" placeholder="30.000" min="0" step="1000" onkeydown="if(['.',',','e','-'].includes(event.key))event.preventDefault()">
                                    <span class="input-group-text">đến</span>
                                    <input type="number" id="newMaxPrice" class="form-control" placeholder="150.000" min="0" step="1000" onkeydown="if(['.',',','e','-'].includes(event.key))event.preventDefault()">
                                </div>
                            </div>
                            <div class="col-md-5">
                                <label class="form-label fw-semibold">Quyền xem</label>
                                <select id="newVisibility" class="form-select">
                                    <option value="private">Cá nhân (Chỉ tôi thấy)</option>
                                    <option value="public">Công khai (Mọi người thấy)</option>
                                </select>
                            </div>
                            <div class="col-12">
                                <label class="form-label fw-semibold">Website</label>
                                <input type="url" id="newWebsite" class="form-control" placeholder="https://...">
                            </div>
                        </div>
                    </div>

                    <!-- STEP 2 — Hình ảnh -->
                    <div class="wiz-step" data-step="2">
                        <label class="form-label fw-semibold">Ảnh đại diện <small class="text-muted">(không bắt buộc — có thể thêm sau ở “Sửa địa điểm”)</small></label>
                        <div class="dropzone" onclick="document.getElementById('newImageFile').click()"
                             data-dz="newImageFile" data-prev="dzPrev1">
                            <input type="file" id="newImageFile" accept="image/*" hidden onchange="dzPreview('newImageFile','dzPrev1')">
                            <div class="dz-empty">
                                <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 4h-5L7 7H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3l-2.5-3z"/><circle cx="12" cy="13" r="3"/></svg>
                                <div><b>Kéo &amp; thả ảnh</b> vào đây hoặc bấm để chọn</div>
                            </div>
                            <div class="dz-prev" id="dzPrev1"></div>
                        </div>

                        <label class="form-label fw-semibold mt-2">Thêm nhiều ảnh khác <small class="text-muted">(không bắt buộc)</small></label>
                        <div class="dropzone dz-sm" onclick="document.getElementById('newMoreImages').click()"
                             data-dz="newMoreImages" data-prev="dzPrev2">
                            <input type="file" id="newMoreImages" accept="image/*" multiple hidden onchange="dzPreview('newMoreImages','dzPrev2')">
                            <div class="dz-empty"><span>Kéo thả nhiều ảnh thực tế của địa điểm</span></div>
                            <div class="dz-prev" id="dzPrev2"></div>
                        </div>

                        <label class="form-label fw-semibold mt-2">Ảnh thực đơn / menu <small class="text-muted">(không bắt buộc)</small></label>
                        <div class="dropzone dz-sm" onclick="document.getElementById('newMenuImages').click()"
                             data-dz="newMenuImages" data-prev="dzPrev3">
                            <input type="file" id="newMenuImages" accept="image/*" multiple hidden onchange="dzPreview('newMenuImages','dzPrev3')">
                            <div class="dz-empty"><span>Kéo thả ảnh thực đơn (cho quán ăn/cafe)</span></div>
                            <div class="dz-prev" id="dzPrev3"></div>
                        </div>

                        <label class="form-label fw-semibold mt-2"><i class="bi bi-camera-video"></i> Video ngắn <small class="text-muted">(không bắt buộc · tối đa 3 video · mỗi video ≤30 giây · ≤15MB)</small></label>
                        <div class="dropzone dz-sm" onclick="document.getElementById('newVideo').click()">
                            <input type="file" id="newVideo" accept="video/mp4,video/webm,video/quicktime" multiple hidden onchange="onVideoPick(this)">
                            <div class="dz-empty"><span>Kéo thả video clip giới thiệu (mp4/webm)</span></div>
                            <div class="dz-prev" id="dzPrevVid"></div>
                        </div>
                    </div>

                    <!-- STEP 3 — Vị trí -->
                    <div class="wiz-step" data-step="3">
                        <label class="form-label fw-semibold">Vị trí trên bản đồ <span class="text-danger">*</span></label>
                        <p class="text-muted" style="font-size:.86rem;margin-bottom:.5rem">Bấm vào bản đồ để chọn vị trí, hoặc nhập toạ độ.</p>
                        <div class="input-group mb-2">
                            <span class="input-group-text">Vĩ độ</span>
                            <input type="text" id="newLat" class="form-control" placeholder="VD: 21.0285" oninput="syncMiniMarker()">
                            <span class="input-group-text">Kinh độ</span>
                            <input type="text" id="newLng" class="form-control" placeholder="VD: 105.8542" oninput="syncMiniMarker()">
                        </div>
                        <div id="coordErr" class="field-err"></div>
                        <div id="miniMap" style="height:400px; border-radius:14px; overflow:hidden; border:1px solid var(--line)"></div>
                    </div>
                </div>
                <div class="modal-footer wiz-foot">
                    <button type="button" class="btn-ghost" data-bs-dismiss="modal">Hủy</button>
                    <button type="button" class="btn-ghost" id="wizBack" onclick="wizGo(-1)" style="display:none">Quay lại</button>
                    <button type="button" class="btn-ghost" id="wizQuick" onclick="quickSave()" title="Tạo nhanh chỉ với tên + vị trí, bổ sung ảnh/chi tiết sau">⚡ Lưu nhanh</button>
                    <div style="flex:1"></div>
                    <button type="button" class="btn-accent" id="wizNext" onclick="wizGo(1)">Tiếp tục</button>
                    <button type="button" class="btn-accent" id="wizFinish" onclick="submitPlace()" style="display:none"><i class="bi bi-check-lg"></i> Hoàn tất</button>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
<script>
let map, allPlaces = [], markers = [], clusterGroup = null, miniMap, miniMarker, routingControl;
let currentCat = '';
let focusPlaceId = null;   // khi mở /Map?place=id → chỉ hiện đúng 1 địa điểm
let currentWeather = null;
let weatherFetchTimeout = null;
const isPro = @(isPro ? "true" : "false");   // Pro/Admin mới được xem thời tiết
const isAuth = @(isAuth ? "true" : "false");

// Lưu / bỏ lưu địa điểm (yêu thích)
function toggleSave(placeId, btn, full) {
    if (!isAuth) { window.location = '/Account/Login?returnUrl=/Map'; return; }
    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
    fetch('/Map/ToggleSave', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': token },
        body: 'placeId=' + placeId
    }).then(r => r.json()).then(d => {
        if (!d.ok) return;
        if (btn) btn.innerHTML = d.saved
            ? (full ? '<i class="bi bi-heart-fill" style="color:#e11d48"></i> Đã lưu' : '<i class="bi bi-heart-fill" style="color:#e11d48"></i>')
            : (full ? '<i class="bi bi-heart"></i> Lưu' : '<i class="bi bi-heart"></i>');
        const p = allPlaces.find(x => x.id === placeId); if (p) p.isSaved = d.saved;
    }).catch(() => {});
}

document.addEventListener('DOMContentLoaded', () => {
    map = L.map('map').setView([21.0285, 105.8542], 12);
    window.cityTiles(map);

    // Gom marker thành cụm (Leaflet.markercluster) → hàng nghìn địa điểm vẫn mượt,
    // chỉ vẽ cụm trong vùng nhìn thay vì toàn bộ marker. Bỏ qua nếu thư viện chưa nạp.
    if (window.L && L.markerClusterGroup) {
        clusterGroup = L.markerClusterGroup({
            chunkedLoading: true,          // nạp marker theo lô, không block UI
            // Bán kính gom nhỏ + giảm mạnh khi zoom vào → cụm ít điểm (2–5) tách sớm.
            maxClusterRadius: z => (z >= 13 ? 12 : 45),
            spiderfyOnMaxZoom: true,
            disableClusteringAtZoom: 15    // phóng tới mức thấy đường (≥15) là hiện hết từng địa điểm
        });
        map.addLayer(clusterGroup);
    }

    // Mobile: đảm bảo map nhận đúng kích thước (sau khi layout xếp cột) + khi xoay/đổi cỡ
    setTimeout(() => map.invalidateSize(), 200);
    window.addEventListener('resize', () => map.invalidateSize());
    window.addEventListener('orientationchange', () => setTimeout(() => map.invalidateSize(), 300));

    addWeatherControl();

    // Click chỗ trống trên bản đồ → gợi ý thêm địa điểm tại đó (như Google Maps)
    if (isAuth) {
        map.on('click', e => {
            L.popup({ closeButton: true })
                .setLatLng(e.latlng)
                .setContent(`<div style="text-align:center;min-width:140px"><i class="bi bi-geo-alt-fill"></i> Thêm địa điểm tại đây?<br>
                    <button type="button" onclick="openAddPlace(${e.latlng.lat}, ${e.latlng.lng})"
                        style="margin-top:6px;padding:5px 12px;background:#0891b2;color:#fff;border:none;border-radius:8px;cursor:pointer;font-weight:600;font-size:13px"><i class="bi bi-plus-lg"></i> Thêm địa điểm</button></div>`)
                .openOn(map);
        });
    }

    if (isPro) {
        fetchWeatherForCenter();
        map.on('moveend', () => {
            clearTimeout(weatherFetchTimeout);
            weatherFetchTimeout = setTimeout(fetchWeatherForCenter, 1500);
        });
        setInterval(fetchWeatherForCenter, 15 * 60 * 1000);
    }

    // Read ?cat= from URL (links from home page category chips)
    const urlCat = new URLSearchParams(window.location.search).get('cat') || '';
    if (urlCat) {
        currentCat = urlCat;
        const btn = document.querySelector(`.map-tag[data-cat="${urlCat}"]`);
        if (btn) {
            document.querySelectorAll('.map-tag').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
        }
    }
    // Read ?q= từ thanh tìm kiếm trang chủ → điền sẵn + lọc
    const urlQ = new URLSearchParams(window.location.search).get('q') || '';
    if (urlQ) {
        const si = document.getElementById('searchInput');
        if (si) si.value = urlQ;
    }
    // Read ?place= → mở bản đồ chỉ hiện đúng 1 địa điểm (từ "Địa điểm của tôi" → Xem)
    const urlPlace = new URLSearchParams(window.location.search).get('place');
    if (urlPlace) { focusPlaceId = parseInt(urlPlace) || null; currentCat = ''; }

    loadPlaces(currentCat, urlQ.trim());

    // Read ?route=lat,lng → tự vẽ đường đi tới địa điểm ngay trong app (từ nút "Chỉ đường")
    const urlRoute = new URLSearchParams(window.location.search).get('route');
    if (urlRoute) {
        const parts = urlRoute.split(',').map(Number);
        if (parts.length === 2 && !isNaN(parts[0]) && !isNaN(parts[1]))
            setTimeout(() => routeTo(parts[0], parts[1]), 700);
    }
    restoreChatHistory();   // hiện lại 5 đoạn chat gần nhất
});

// ── Weather ───────────────────────────────────────────────────────────────
