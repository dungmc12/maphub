<!-- ── DOWNLOAD / CTA BANNER ─────────────────────────────────────────────── -->
<div class="cta-banner cta-compact">
    <div class="container-xl">
        <div class="cta-inner reveal">
            <div>
                <h3>🤖 Lập kế hoạch bằng AI</h3>
                <p>Nhập thời gian, ngân sách và sở thích — AI sẽ đề xuất lịch trình phù hợp cho bạn.</p>
            </div>
            <div class="cta-actions">
                <a href="/Plans" class="btn-accent">Tạo lịch trình</a>
                <a href="/Plans" class="cta-link">Xem lịch trình đã lưu →</a>
            </div>
        </div>
    </div>
</div>
