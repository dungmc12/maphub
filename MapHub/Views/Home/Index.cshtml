            var tw = "https://cdn.jsdelivr.net/gh/twitter/twemoji@14.0.2/assets/svg/";
        }
        <div class="cat-grid">
            <a href="/Map?cat=restaurant" class="cat-card">
                <div class="cat-icon-box cat-orange">
                    <img src="@(tw)1f37d.svg" alt="Nhà hàng" class="cat-twemoji">
                </div>
                <span class="cat-card-label">Nhà hàng</span>
            </a>
            <a href="/Map?cat=cafe" class="cat-card">
                <div class="cat-icon-box cat-amber">
                    <img src="@(tw)2615.svg" alt="Cà phê" class="cat-twemoji">
                </div>
                <span class="cat-card-label">Cà phê</span>
            </a>
            <a href="/Map?cat=entertainment" class="cat-card">
                <div class="cat-icon-box cat-purple">
                    <img src="@(tw)1f3ae.svg" alt="Vui chơi" class="cat-twemoji">
                </div>
                <span class="cat-card-label">Vui chơi</span>
            </a>
            <a href="/Map?cat=culture" class="cat-card">
                <div class="cat-icon-box cat-blue">
                    <img src="@(tw)1f3db.svg" alt="Văn hóa" class="cat-twemoji">
                </div>
                <span class="cat-card-label">Văn hóa</span>
            </a>
            <a href="/Map?cat=temple" class="cat-card">
                <div class="cat-icon-box cat-gold">
                    <img src="@(tw)26e9.svg" alt="Tâm linh" class="cat-twemoji">
                </div>
                <span class="cat-card-label">Tâm linh</span>
            </a>
            <a href="/Map?cat=nature" class="cat-card">
                <div class="cat-icon-box cat-green">
                    <img src="@(tw)1f33f.svg" alt="Thiên nhiên" class="cat-twemoji">
                </div>
                <span class="cat-card-label">Thiên nhiên</span>
            </a>
            <a href="/Map?cat=education" class="cat-card">
                <div class="cat-icon-box cat-teal">
                    <img src="@(tw)1f393.svg" alt="Giáo dục" class="cat-twemoji">
                </div>
                <span class="cat-card-label">Giáo dục</span>
            </a>
            <a href="/Map?cat=hotel" class="cat-card">
                <div class="cat-icon-box cat-pink">
                    <img src="@(tw)1f3e8.svg" alt="Lưu trú" class="cat-twemoji">
                </div>
                <span class="cat-card-label">Lưu trú</span>
            </a>
            <a href="/Map" class="cat-card">
                <div class="cat-icon-box cat-slate">
                    <img src="@(tw)1f9ed.svg" alt="Tất cả" class="cat-twemoji">
                </div>
                <span class="cat-card-label">Tất cả</span>
            </a>
        </div>
    </div>
</div>

<!-- ── HOT NEWS & GUIDES ─────────────────────────────────────────────────── -->
@if (feedList.Any())
{
    <div class="container-xl pb-5">
        <div class="section-header reveal">
            <div>
                <h3 class="section-title">📰 Tin tức &amp; Cẩm nang</h3>
                <p class="section-sub">Kinh nghiệm, điểm đến và hoạt động mới nhất</p>
            </div>
        </div>
        <div class="news-grid reveal">
            @foreach (var post in feedList)
            {
                var postUrl = "/bai-viet/" + (string.IsNullOrEmpty(post.Slug) ? post.Id.ToString() : post.Slug);
                <a class="news-card" href="@postUrl" style="text-decoration:none;color:inherit">
                    <div class="news-card-img">
                        <img src="@(post.CoverImageUrl ?? "https://picsum.photos/seed/news-default/800/400")"
                             alt="@post.Title" loading="lazy">
                        <span class="news-type-badge @(post.Type == "guide" ? "badge-guide" : post.Type == "tip" ? "badge-tip" : "")">
                            @(post.Type == "guide" ? "Cẩm nang" : post.Type == "tip" ? "Mẹo hay" : post.Type == "toplist" ? "Top list" : post.Type == "review" ? "Review" : "Tin tức")
                        </span>
                        @if (post.IsPinned)
                        {
                            <span class="news-pin-badge"><i class="fa-solid fa-thumbtack"></i></span>
                        }
                    </div>
                    <div class="news-card-body">
                        <h5 class="news-card-title">@post.Title</h5>
                        @if (!string.IsNullOrEmpty(post.Summary))
                        {
                            <p class="news-card-summary">@post.Summary</p>
                        }
                        <div class="news-card-footer">
                            <span class="news-date">@post.PublishedAt.ToString("dd/MM/yyyy")</span>
                            <span class="news-read-more">Đọc bài →</span>
                        </div>
                    </div>
                </a>
            }
        </div>
    </div>
}

<!-- ── FEATURED PLACES ───────────────────────────────────────────────────── -->
@if (Model != null && Model.Any())
{
    <div class="container-xl pb-5">
        <div class="section-header reveal">
            <div>
                <h3 class="section-title">📍 Địa điểm nổi bật</h3>
                <p class="section-sub">Những nơi được yêu thích nhất trên CityScout</p>
            </div>
            <a href="/Map" class="btn-ghost btn-sm-ghost">Xem tất cả →</a>
        </div>
        <div class="places-grid reveal">
            @foreach (var place in Model)
            {
                var imgObj  = place.Images.FirstOrDefault();
                var img     = imgObj != null ? $"/Map/Image/{imgObj.Id}?v={place.UpdatedAt.Ticks}" : "https://picsum.photos/seed/place-default/400/300";
                var rating  = place.Reviews.Any() ? Math.Round(place.Reviews.Average(r => r.QualityRating), 1) : 0.0;
                var reviews = place.Reviews.Count;
                <div class="place-card">
                    <a href="/Map/Details/@place.Id" class="place-card-img-link">
                        <img src="@img" alt="@place.Name" loading="lazy"
                             onerror="this.onerror=null;this.src='https://placehold.co/400x300?text=No+Img'">
                        @{
                            var catMap = new Dictionary<string,string>(StringComparer.OrdinalIgnoreCase){
                                ["restaurant"]="🍽️ Nhà hàng",["cafe"]="☕ Cà phê",["entertainment"]="🎯 Vui chơi",
                                ["hotel"]="🏨 Lưu trú",["culture"]="🏛️ Văn hóa",["temple"]="🛕 Tâm linh",
                                ["nature"]="🌿 Thiên nhiên",["education"]="🎓 Giáo dục"
                            };
                            var catTxt = (place.Category != null && catMap.TryGetValue(place.Category, out var cl)) ? cl : ("📌 "+(place.Category??"Khác"));
                        }
                        <span class="place-card-category">@catTxt</span>
                    </a>
                    <div class="place-card-body">
                        <h5 class="place-card-name">
                            <a href="/Map/Details/@place.Id">@place.Name</a>
                        </h5>
                        @if (!string.IsNullOrEmpty(place.Address))
                        {
                            <p class="place-card-address">📍 @place.Address</p>
                        }
                        <div class="place-card-footer">
                            <div class="place-rating">
                                <span class="stars">★ @(rating > 0 ? rating.ToString("0.0") : "Chưa có")</span>
                                @if (reviews > 0) { <span class="review-count">(@reviews đánh giá)</span> }
                            </div>
                            @if (place.MinPrice.HasValue)
                            {
                                <span class="place-price">@place.MinPrice!.Value.ToString("N0")đ+</span>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
}

<!-- ── CITY GUIDE ────────────────────────────────────────────────────────── -->
