@model IEnumerable<MapHub.Models.Place>
@{
    ViewData["Title"] = "Trang Chủ";
    var events   = ViewBag.Events   as IEnumerable<MapHub.Models.Event>    ?? Enumerable.Empty<MapHub.Models.Event>();
    var feedPosts= ViewBag.FeedPosts as IEnumerable<MapHub.Models.FeedPost> ?? Enumerable.Empty<MapHub.Models.FeedPost>();
    var eventList = events.ToList();
    var feedList  = feedPosts.ToList();
}

<!-- ── HERO: Event Carousel (Shopee-style) ───────────────────────────────── -->
<div class="hero-banner">
    @if (eventList.Any())
    {
        <div id="heroCarousel" class="carousel slide" data-bs-ride="carousel" data-bs-interval="4500" data-bs-touch="false">
            <div class="carousel-indicators">
                @for (int i = 0; i < eventList.Count; i++)
                {
                    <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="@i"
                            class="@(i == 0 ? "active" : "")" aria-label="Slide @(i+1)"></button>
                }
            </div>
            <div class="carousel-inner">
                @for (int i = 0; i < eventList.Count; i++)
                {
                    var ev = eventList[i];
                    <div class="carousel-item @(i == 0 ? "active" : "")">
                        <div class="hero-slide"
                             style="background-image: url('@(ev.BannerImageUrl ?? "https://picsum.photos/seed/event-default/1400/500")')">
                            <div class="hero-slide-overlay">
                                <span class="event-status-badge @(ev.Status == "ongoing" ? "badge-live" : ev.Status == "ended" ? "badge-ended" : "")">
                                    @if (ev.Status == "ongoing") {
                                        <i class="bi bi-broadcast-pin"></i><span> ĐANG DIỄN RA</span>
                                    } else if (ev.Status == "upcoming") {
                                        <i class="bi bi-calendar-event-fill"></i><span> SẮP DIỄN RA</span>
                                    } else {
                                        <i class="bi bi-check-circle-fill"></i><span> ĐÃ KẾT THÚC</span>
                                    }
                                </span>
                                <h2 class="hero-event-title">@ev.Title</h2>
                                @if (!string.IsNullOrEmpty(ev.Description))
                                {
                                    <p class="hero-event-desc">@ev.Description</p>
                                }
                                <div class="hero-event-meta">
                                    <span><i class="bi bi-calendar3"></i> @ev.StartAt.ToString("dd/MM/yyyy")</span>
                                    @if (ev.Place != null)
                                    {
                                        <span><i class="bi bi-geo-alt-fill" style="color:#ff6b6b"></i> @ev.Place.Name</span>
                                    }
                                </div>
                                @if (ev.PlaceId.HasValue)
                                {
                                    <a href="/Map/Details/@ev.PlaceId" class="btn-hero-cta">
                                        <i class="bi bi-arrow-right-circle-fill"></i> Xem địa điểm
                                    </a>
                                }
                                else
                                {
                                    <span class="hero-no-place"><i class="bi bi-geo-alt"></i> Chưa liên kết địa điểm</span>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
            <button class="carousel-control-prev" type="button" data-bs-target="#heroCarousel" data-bs-slide="prev">
                <span class="carousel-control-prev-icon"></span>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#heroCarousel" data-bs-slide="next">
                <span class="carousel-control-next-icon"></span>
            </button>
        </div>
    }
    else
    {
        <div class="hero-default">
            <div class="hero-default-inner">
                <p class="eyebrow">KHÁM PHÁ HÀ NỘI</p>
                <h1>Tìm địa điểm ăn uống,<br>vui chơi quanh bạn</h1>
                <p class="subtitle">Từ trung tâm Hà Nội đến Láng &nbsp;·&nbsp; Hòa Lạc &nbsp;·&nbsp; ĐH FPT</p>
                <div class="hero-cta-row">
                    <a href="/Map" class="btn-accent">Mở bản đồ</a>
                    <a href="/Plans" class="btn-ghost">Lên kế hoạch</a>
                </div>
            </div>
        </div>
    }
</div>

<!-- ── FLOATING SEARCH ────────────────────────────────────────────────────── -->
<div class="container-xl" style="margin-top:-2.2rem;position:relative;z-index:5">
    <form class="hero-search reveal" action="/Map" method="get" role="search">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
        <input type="text" name="q" placeholder="Tìm nhà hàng, cà phê, địa điểm ở Hà Nội…" autocomplete="off">
        <button type="submit">Tìm kiếm</button>
    </form>
</div>

<!-- ── CATEGORY QUICK LINKS ───────────────────────────────────────────────── -->
