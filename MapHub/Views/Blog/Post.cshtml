@model MapHub.Models.FeedPost
@{
    string TypeLabel(string t) => t switch { "guide" => "📖 Cẩm nang", "tip" => "💡 Mẹo hay", _ => "📰 Tin tức" };
}

<div class="container-xl py-4" style="max-width:760px">
    <a href="/Blog" class="back-link">← Blog</a>

    <article class="mt-3">
        <div class="d-flex align-items-center gap-2 mb-2">
            <span class="badge bg-secondary">@TypeLabel(Model.Type)</span>
            <span class="text-muted small">@Model.PublishedAt.ToLocalTime().ToString("dd/MM/yyyy")</span>
        </div>

        <h1 class="mb-3">@Model.Title</h1>

        @if (!string.IsNullOrEmpty(Model.CoverImageUrl))
        {
            <img src="@Model.CoverImageUrl" alt="@Model.Title"
                 style="width:100%;max-height:420px;object-fit:cover;border-radius:14px;margin-bottom:1.25rem">
        }

        @if (!string.IsNullOrEmpty(Model.Summary))
        {
            <div style="font-size:1.05rem;line-height:1.8;white-space:pre-line;color:#374151">@Model.Summary</div>
        }
    </article>

    <hr class="my-4">
    <div class="d-flex gap-2">
        <a href="/Blog" class="btn-ghost">← Xem bài khác</a>
        <a href="/Map" class="btn-accent">🗺️ Khám phá bản đồ</a>
    </div>
</div>
