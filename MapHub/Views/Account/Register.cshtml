@model MapHub.Models.RegisterInputModel
@{
    ViewData["Title"] = "Đăng ký";
}

<section class="auth-wrap">
    <article class="auth-card">
        <p class="eyebrow">Tạo tài khoản</p>
        <h1>Tạo tài khoản CityScout</h1>

        <div style="display:flex;gap:.55rem;align-items:center;background:linear-gradient(135deg,#ecfeff,#f0fdfa);
             border:1px solid #a5f3fc;border-radius:12px;padding:.7rem .85rem;margin:.2rem 0 1rem;font-size:.85rem;color:#0e7490">
            <i class="bi bi-gift-fill" style="font-size:1.1rem"></i>
            <span>Đăng ký ngay để <strong>dùng thử Pro miễn phí 1 tháng</strong> — mỗi tài khoản một lần.</span>
        </div>

        <form asp-action="Register" method="post" class="auth-form">
            <input type="hidden" asp-for="ReturnUrl" />
            <div asp-validation-summary="ModelOnly" class="validation"></div>

            <label asp-for="Username">Tên đăng nhập</label>
            <input asp-for="Username" autocomplete="username" placeholder="vd: dungnguyen hoặc travel_hn" />
            <span asp-validation-for="Username" class="validation"></span>
            <p style="font-size:.74rem;color:#94a3b8;margin:-.2rem 0 .3rem">4–30 ký tự, chỉ gồm chữ, số và . _ -</p>

            <label asp-for="Password">Mật khẩu</label>
            <div style="position:relative">
                <input asp-for="Password" id="regPwd" autocomplete="new-password" style="padding-right:2.5rem" />
                <button type="button" onclick="togglePwd('regPwd',this)"
                    style="position:absolute;right:.6rem;top:50%;transform:translateY(-50%);
                    background:none;border:none;cursor:pointer;color:#94a3b8;padding:.2rem">
                    <i class="bi bi-eye"></i>
                </button>
            </div>
            <span asp-validation-for="Password" class="validation"></span>

            <label asp-for="ConfirmPassword">Nhập lại mật khẩu</label>
            <div style="position:relative">
                <input asp-for="ConfirmPassword" id="regPwd2" autocomplete="new-password" style="padding-right:2.5rem" />
                <button type="button" onclick="togglePwd('regPwd2',this)"
                    style="position:absolute;right:.6rem;top:50%;transform:translateY(-50%);
                    background:none;border:none;cursor:pointer;color:#94a3b8;padding:.2rem">
                    <i class="bi bi-eye"></i>
                </button>
            </div>
            <span asp-validation-for="ConfirmPassword" class="validation"></span>

            <p style="font-size:.76rem;color:#64748b;margin:.2rem 0 .1rem;line-height:1.5">
                <i class="bi bi-shield-lock"></i> Hãy đặt mật khẩu <strong>mạnh và riêng biệt</strong> (≥8 ký tự, có chữ và số, không dùng lại mật khẩu cũ).
                Nếu trình duyệt báo <em>"mật khẩu bị lộ trong vụ rò rỉ dữ liệu"</em>, nghĩa là mật khẩu đó từng rò rỉ ở nơi khác — chỉ cần đổi sang mật khẩu khác là hết.
            </p>

            <button type="submit" class="btn-accent">Tạo tài khoản</button>
        </form>

        <p class="auth-switch">
            Đã có tài khoản?
            <a asp-action="Login" asp-route-returnUrl="@Model.ReturnUrl">Đăng nhập ngay</a>
        </p>
    </article>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
    function togglePwd(id, btn) {
        var inp = document.getElementById(id);
        var icon = btn.querySelector('i');
        if (inp.type === 'password') {
            inp.type = 'text';
            icon.className = 'bi bi-eye-slash';
        } else {
            inp.type = 'password';
            icon.className = 'bi bi-eye';
        }
    }
    </script>
}
