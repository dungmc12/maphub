@{
    ViewData["Title"] = "Quên mật khẩu";
}

<section class="auth-wrap">
    <article class="auth-card">
        <p class="eyebrow">Khôi phục tài khoản</p>
        <h1>Quên mật khẩu</h1>

        @if (ViewBag.Sent == true)
        {
            <div style="background:#ecfdf5;border:1px solid #a7f3d0;border-radius:12px;padding:1rem;margin:.6rem 0;color:#065f46;font-size:.9rem;line-height:1.6">
                ✅ Đã gửi yêu cầu đổi mật khẩu tới quản trị viên.<br>
                Quản trị viên sẽ đặt lại mật khẩu mới và liên hệ lại cho bạn. Vui lòng chờ trong ít giờ.
            </div>
            <p class="auth-switch"><a asp-action="Login">← Về trang đăng nhập</a></p>
        }
        else
        {
            <p style="color:#64748b;font-size:.9rem;margin:.2rem 0 1rem;line-height:1.6">
                Vì hệ thống chưa gửi email tự động, hãy gửi yêu cầu cho <strong>quản trị viên</strong>.
                Quản trị viên sẽ đặt lại mật khẩu mới cho bạn và báo lại.
            </p>
            @if (ViewBag.Error != null)
            {
                <div class="validation" style="margin-bottom:.6rem">@ViewBag.Error</div>
            }
            <form asp-action="ForgotPassword" method="post" class="auth-form">
                @Html.AntiForgeryToken()
                <label for="fpEmail">Email tài khoản</label>
                <input id="fpEmail" type="email" name="email" autocomplete="email" placeholder="vd: ban@gmail.com" required>

                <label for="fpMsg">Lời nhắn cho quản trị viên <small class="text-muted">(tùy chọn)</small></label>
                <textarea id="fpMsg" name="message" rows="3" placeholder="VD: Mình quên mật khẩu, nhờ admin đặt lại giúp."></textarea>

                <button type="submit" class="btn-accent">Gửi yêu cầu cho quản trị viên</button>
            </form>
            <p class="auth-switch" style="margin-top:1rem">
                Nhớ mật khẩu rồi? <a asp-action="Login">Đăng nhập</a>
            </p>
        }
    </article>
</section>
