@model MapHub.Models.LoginInputModel
@{
    ViewData["Title"] = "Đăng nhập";
}

<section class="auth-wrap">
    <article class="auth-card">
        <p class="eyebrow">Chào mừng quay lại</p>
        <h1>Đăng nhập CityScout</h1>
        <p class="subtitle">Đăng nhập để xem bản đồ và dữ liệu điểm riêng theo tài khoản của bạn.</p>

        <form asp-action="Login" method="post" class="auth-form">
            <input type="hidden" asp-for="ReturnUrl" />
            <div asp-validation-summary="ModelOnly" class="validation"></div>

            <label asp-for="Email"></label>
            <input asp-for="Email" autocomplete="username" />
            <span asp-validation-for="Email" class="validation"></span>

            <label asp-for="Password"></label>
            <input asp-for="Password" autocomplete="current-password" />
            <span asp-validation-for="Password" class="validation"></span>

            <label class="checkbox-field">
                <input asp-for="RememberMe" />
                <span>Ghi nhớ đăng nhập trên thiết bị này</span>
            </label>

            <button type="submit" class="btn-accent">Đăng nhập</button>
        </form>

        <p class="auth-switch">
            Chưa có tài khoản?
            <a asp-action="Register" asp-route-returnUrl="@Model.ReturnUrl">Tạo tài khoản mới</a>
        </p>
    </article>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
