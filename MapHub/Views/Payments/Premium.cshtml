@{
    ViewData["Title"] = "Nâng cấp Pro – CityScout";
    bool isPro = User.Identity?.IsAuthenticated == true && (User.IsInRole("Admin") || User.IsInRole("Pro") || (ViewBag.IsPro as bool? ?? false));
    bool isLoggedIn = User.Identity?.IsAuthenticated == true;
    var proExpiresAt = ViewBag.ProExpiresAt as DateTime?;
    string? currentPlan = ViewBag.CurrentPlan as string;   // "month" | "year" | null
}

<style>
.pr-grid { display:flex; gap:1.5rem; justify-content:center; flex-wrap:wrap; padding:2.5rem 1rem; max-width:980px; margin:0 auto; }
.pr-card { flex:1 1 260px; max-width:300px; background:#fff; border:2px solid #e5e7eb; border-radius:20px;
           padding:1.8rem 1.5rem; display:flex; flex-direction:column; box-shadow:0 4px 20px rgba(0,0,0,.06); }
.pr-card.featured { border-color:#8b5cf6; background:linear-gradient(160deg,#faf5ff,#fff); box-shadow:0 8px 32px rgba(139,92,246,.15); position:relative; }
.pr-card.best { border-color:#f59e0b; background:linear-gradient(160deg,#fffbeb,#fff); box-shadow:0 8px 32px rgba(245,158,11,.12); position:relative; }
.pr-badge { position:absolute; top:-14px; left:50%; transform:translateX(-50%);
            background:#8b5cf6; color:#fff; font-size:.7rem; font-weight:800;
            padding:.2rem .9rem; border-radius:20px; white-space:nowrap; }
.pr-badge.gold { background:linear-gradient(90deg,#f59e0b,#f97316); }
.pr-tier { font-size:.8rem; font-weight:700; text-transform:uppercase; letter-spacing:.8px; color:#64748b; margin-bottom:.4rem; }
.pr-price { font-size:2rem; font-weight:900; color:#1e293b; line-height:1; }
.pr-price span { font-size:.95rem; font-weight:400; color:#64748b; }
.pr-desc { font-size:.82rem; color:#64748b; margin:.35rem 0 1rem; }
.pr-feats { list-style:none; margin:0 0 1.5rem; padding:0; font-size:.85rem; display:flex; flex-direction:column; gap:.45rem; flex:1; }
.pr-feats li::before { content:"✓ "; color:#22c55e; font-weight:700; }
.pr-feats li.no { color:#94a3b8; }
.pr-feats li.no::before { content:"✗ "; color:#cbd5e1; }
.pr-btn { display:block; text-align:center; padding:.75rem 1rem; border-radius:12px; font-weight:700; font-size:.92rem;
          border:none; cursor:pointer; text-decoration:none; transition:all .15s; }
.pr-btn-ghost { border:2px solid #e5e7eb; color:#64748b; background:#fff; }
.pr-btn-ghost:hover { border-color:#c4b5fd; }
.pr-btn-month { background:#8b5cf6; color:#fff; }
.pr-btn-month:hover { background:#7c3aed; }
.pr-btn-year { background:linear-gradient(90deg,#f59e0b,#f97316); color:#fff; }
.pr-btn-year:hover { filter:brightness(.95); }
.pr-btn-active { background:#f0fdf4; color:#16a34a; border:2px solid #86efac; cursor:default; }
.pr-save { display:inline-block; font-size:.65rem; background:#22c55e; color:#fff;
           padding:.1rem .45rem; border-radius:6px; vertical-align:middle; margin-left:.3rem; }
.pr-using-tag { display:inline-block; font-size:.66rem; font-weight:800; background:#dcfce7; color:#16a34a;
                border:1px solid #86efac; padding:.12rem .5rem; border-radius:999px; margin-left:.4rem; vertical-align:middle; }
</style>

<!-- Hero -->
<div class="premium-hero">
    <div class="premium-hero-inner">
        <div class="premium-badge"><i class="bi bi-stars"></i> CityScout Pro</div>
        <h1 class="premium-title">Khám phá Hà Nội không giới hạn</h1>
        <p class="premium-subtitle">
            Lập kế hoạch hành trình thông minh, gợi ý địa điểm bằng AI<br>
            và thêm không giới hạn địa điểm yêu thích.
        </p>
        @if (isPro)
        {
            <div class="premium-active-badge">
                <i class="bi bi-patch-check-fill"></i> Bạn đang là thành viên Pro
                @if (proExpiresAt.HasValue)
                {
                    <text> · Hết hạn @proExpiresAt.Value.ToLocalTime().ToString("dd/MM/yyyy")</text>
                }
            </div>
        }
    </div>
</div>

<!-- 3 pricing cards -->
<div class="pr-grid">

    <!-- Free -->
    <div class="pr-card">
        <div class="pr-tier">Miễn phí</div>
        <div class="pr-price">0đ <span>/ mãi mãi</span></div>
        <div class="pr-desc">Khám phá Hà Nội cơ bản</div>
        <ul class="pr-feats">
            <li>Xem bản đồ &amp; địa điểm</li>
            <li>Thêm tối đa 3 địa điểm</li>
            <li>Tạo tối đa 3 kế hoạch</li>
            <li>Viết đánh giá địa điểm</li>
            <li class="no">Chat AI tư vấn hành trình</li>
            <li class="no">Tạo kế hoạch bằng AI</li>
            <li class="no">Chia sẻ kế hoạch công khai</li>
        </ul>
        @if (!isLoggedIn)
        {
            <a href="/Account/Register" class="pr-btn pr-btn-ghost">Đăng ký miễn phí</a>
        }
        else if (!isPro)
        {
            <div class="pr-btn pr-btn-ghost" style="cursor:default">Gói hiện tại</div>
        }
    </div>

    <!-- Pro tháng -->
    <div class="pr-card featured">
        <div class="pr-badge">Phổ biến</div>
        <div class="pr-tier">Pro @if (isPro && currentPlan == "month") { <span class="pr-using-tag">Đang dùng</span> }</div>
        <div class="pr-price">@(((decimal)ViewBag.MonthAmount).ToString("#,##0"))đ <span>/ tháng</span></div>
        <div class="pr-desc">Gia hạn mỗi 30 ngày</div>
        <ul class="pr-feats">
            <li>Tất cả tính năng miễn phí</li>
            <li>Không giới hạn địa điểm</li>
            <li>Không giới hạn kế hoạch</li>
            <li>Chat AI tư vấn hành trình</li>
            <li>Tạo kế hoạch tự động bằng AI</li>
            <li>Chia sẻ kế hoạch qua link</li>
            <li>Lọc địa điểm nâng cao</li>
        </ul>
        @if (!isLoggedIn)
        {
            <a href="/Account/Login" class="pr-btn pr-btn-month">Đăng nhập để mua</a>
        }
        else
        {
            <form method="post" action="/Payments/Create">
                @Html.AntiForgeryToken()
                <input type="hidden" name="plan" value="month">
                <button type="submit" class="pr-btn pr-btn-month w-100">
                    <i class="bi bi-qr-code-scan me-1"></i> @(isPro ? "Gia hạn thêm 1 tháng" : "Đăng ký 1 tháng")
                </button>
            </form>
        }
    </div>

    <!-- Pro năm -->
    <div class="pr-card best">
        <div class="pr-badge gold">Tiết kiệm nhất</div>
        <div class="pr-tier">Pro @if (isPro && currentPlan == "year") { <span class="pr-using-tag">Đang dùng</span> }</div>
        <div class="pr-price">@(((decimal)ViewBag.YearAmount).ToString("#,##0"))đ <span>/ năm</span></div>
        <div class="pr-desc">Dùng trọn 365 ngày <span class="pr-save">-17%</span></div>
        <ul class="pr-feats">
            <li>Tất cả tính năng miễn phí</li>
            <li>Không giới hạn địa điểm</li>
            <li>Không giới hạn kế hoạch</li>
            <li>Chat AI tư vấn hành trình</li>
            <li>Tạo kế hoạch tự động bằng AI</li>
            <li>Chia sẻ kế hoạch qua link</li>
            <li>Lọc địa điểm nâng cao</li>
        </ul>
        @if (!isLoggedIn)
        {
            <a href="/Account/Login" class="pr-btn pr-btn-year">Đăng nhập để mua</a>
        }
        else
        {
            <form method="post" action="/Payments/Create">
                @Html.AntiForgeryToken()
                <input type="hidden" name="plan" value="year">
                <button type="submit" class="pr-btn pr-btn-year w-100">
                    <i class="bi bi-qr-code-scan me-1"></i> @(isPro ? "Gia hạn thêm 1 năm" : "Đăng ký 1 năm")
                </button>
            </form>
        }
    </div>

</div>

<!-- FAQ -->
<div class="container mb-5" style="max-width:700px">
    <h4 class="text-center mb-4 fw-bold">Câu hỏi thường gặp</h4>
    <div class="faq-list">
        <div class="faq-item">
            <div class="faq-q">Thanh toán như thế nào?</div>
            <div class="faq-a">
                Chọn gói → quét mã QR chuyển khoản ngân hàng → nhập mã giao dịch từ thông báo SMS/app ngân hàng → admin duyệt trong vòng 24 giờ.
            </div>
        </div>
        <div class="faq-item">
            <div class="faq-q">AI trong CityScout Pro hoạt động thế nào?</div>
            <div class="faq-a">
                CityScout sử dụng Google Gemini AI để gợi ý địa điểm phù hợp, trả lời câu hỏi về Hà Nội và tự động tạo lịch trình theo sở thích của bạn.
            </div>
        </div>
        <div class="faq-item">
            <div class="faq-q">Tôi có thể hủy bất cứ lúc nào không?</div>
            <div class="faq-a">
                Có. Tính năng Pro vẫn hoạt động đến hết chu kỳ thanh toán hiện tại.
            </div>
        </div>
    </div>
</div>
