@{
    ViewData["Title"] = "Nâng cấp Pro – CityScout";
    bool isPro = User.Identity?.IsAuthenticated == true && (User.IsInRole("Admin") || User.IsInRole("Pro") || (ViewBag.IsPro as bool? ?? false));
    bool isLoggedIn = User.Identity?.IsAuthenticated == true;
}

<style>
    .plan-pick {
        display: flex; align-items: center; gap: .75rem; cursor: pointer;
        border: 2px solid #e5e7eb; border-radius: 12px; padding: .8rem 1rem;
        margin-bottom: .6rem; transition: all .15s;
    }
    .plan-pick:hover { border-color: #c4b5fd; }
    .plan-pick.active { border-color: #8b5cf6; background: #faf5ff; }
    .plan-pick-name { font-weight: 700; }
    .plan-pick-desc { font-size: .78rem; color: #64748b; }
    .plan-pick-price { margin-left: auto; font-weight: 800; color: #6d28d9; white-space: nowrap; }
    .plan-pick-badge {
        font-size: .65rem; background: #22c55e; color: #fff;
        padding: .1rem .4rem; border-radius: 6px; vertical-align: middle;
    }
</style>

<div class="premium-page">

    <!-- Hero -->
    <div class="premium-hero">
        <div class="premium-hero-inner">
            <div class="premium-badge"><i class="bi bi-stars"></i> CityScout Pro</div>
            <h1 class="premium-title">Khám phá Hà Nội không giới hạn</h1>
            <p class="premium-subtitle">
                Lập kế hoạch hành trình thông minh, gợi ý địa điểm bằng AI<br>
                và thêm không giới hạn địa điểm yêu thích.
            </p>
            @if (isPro)
            {
                <div class="premium-active-badge"><i class="bi bi-patch-check-fill"></i> Bạn đang là thành viên Pro</div>
            }
        </div>
    </div>

    <!-- Pricing cards -->
    <div class="container py-5" style="max-width:900px">
        <div class="row g-4 justify-content-center">

            <!-- Free -->
            <div class="col-md-5">
                <div class="pricing-card">
                    <div class="pricing-tier">Miễn phí</div>
                    <div class="pricing-price">
                        <span class="price-num">0đ</span>
                        <span class="price-period">/ mãi mãi</span>
                    </div>
                    <ul class="pricing-features">
                        <li class="feat-ok">✓ Xem bản đồ & địa điểm</li>
                        <li class="feat-ok">✓ Thêm tối đa 3 địa điểm</li>
                        <li class="feat-ok">✓ Tạo tối đa 3 kế hoạch</li>
                        <li class="feat-ok">✓ Viết đánh giá địa điểm</li>
                        <li class="feat-no">✗ Chat AI tư vấn hành trình</li>
                        <li class="feat-no">✗ Tạo kế hoạch bằng AI</li>
                        <li class="feat-no">✗ Không giới hạn địa điểm</li>
                        <li class="feat-no">✗ Chia sẻ kế hoạch công khai</li>
                    </ul>
                    @if (!isLoggedIn)
                    {
                        <a href="/Account/Register" class="pricing-btn pricing-btn-ghost">Đăng ký miễn phí</a>
                    }
                    else if (!isPro)
                    {
                        <div class="pricing-btn pricing-btn-ghost pricing-current">Gói hiện tại</div>
                    }
                </div>
            </div>

            <!-- Pro -->
            <div class="col-md-5">
                <div class="pricing-card pricing-card-pro">
                    <div class="pricing-popular">Phổ biến nhất</div>
                    <div class="pricing-tier">Pro</div>
                    <div class="pricing-price">
                        <span class="price-num">@(((decimal)ViewBag.MonthAmount).ToString("#,##0"))đ</span>
                        <span class="price-period">/ tháng</span>
                    </div>
                    <ul class="pricing-features">
                        <li class="feat-ok">✓ Tất cả tính năng miễn phí</li>
                        <li class="feat-ok">✓ Không giới hạn địa điểm</li>
                        <li class="feat-ok">✓ Không giới hạn kế hoạch</li>
                        <li class="feat-ok">✓ Chat AI tư vấn hành trình</li>
                        <li class="feat-ok">✓ Tạo kế hoạch tự động bằng AI</li>
                        <li class="feat-ok">✓ Chia sẻ kế hoạch công khai</li>
                        <li class="feat-ok">✓ Ưu tiên hiển thị địa điểm</li>
                        <li class="feat-ok">✓ Hỗ trợ ưu tiên</li>
                    </ul>
                    @if (isPro)
                    {
                        <div class="pricing-btn pricing-btn-ghost pricing-current">
                            <i class="bi bi-patch-check-fill" style="color:#22c55e"></i> Đang sử dụng
                        </div>
                    }
                    else if (!isLoggedIn)
                    {
                        <a href="/Account/Login" class="pricing-btn pricing-btn-pro">Đăng nhập để nâng cấp</a>
                    }
                    else
                    {
                        <button class="pricing-btn pricing-btn-pro" onclick="showPayment()">
                            <i class="bi bi-lightning-charge-fill"></i> Nâng cấp ngay
                        </button>
                    }
                </div>
            </div>

        </div>

        <!-- Feature comparison -->
        <div class="mt-5">
            <h4 class="text-center mb-4 fw-bold">So sánh chi tiết</h4>
            <div class="table-responsive">
                <table class="table table-bordered align-middle text-center compare-table">
                    <thead class="table-light">
                        <tr>
                            <th class="text-start">Tính năng</th>
                            <th>Miễn phí</th>
                            <th class="table-warning"><i class="bi bi-stars" style="color:#e06d1b"></i> Pro</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td class="text-start">Xem bản đồ & địa điểm</td>
                            <td>✓</td>
                            <td>✓</td>
                        </tr>
                        <tr>
                            <td class="text-start">Thêm địa điểm</td>
                            <td>3 địa điểm</td>
                            <td class="fw-semibold">Không giới hạn</td>
                        </tr>
                        <tr>
                            <td class="text-start">Tạo kế hoạch hành trình</td>
                            <td>3 kế hoạch</td>
                            <td class="fw-semibold">Không giới hạn</td>
                        </tr>
                        <tr>
                            <td class="text-start">Viết đánh giá & xếp hạng</td>
                            <td>✓</td>
                            <td>✓</td>
                        </tr>
                        <tr>
                            <td class="text-start">Chat AI tư vấn (Gemini)</td>
                            <td>✗</td>
                            <td>✓</td>
                        </tr>
                        <tr>
                            <td class="text-start">Tạo kế hoạch bằng AI</td>
                            <td>✗</td>
                            <td>✓</td>
                        </tr>
                        <tr>
                            <td class="text-start">Chia sẻ kế hoạch qua link</td>
                            <td>✗</td>
                            <td>✓</td>
                        </tr>
                        <tr>
                            <td class="text-start">Lọc địa điểm nâng cao</td>
                            <td>✗</td>
                            <td>✓</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- FAQ -->
        <div class="mt-5 mb-3">
            <h4 class="text-center mb-4 fw-bold">Câu hỏi thường gặp</h4>
            <div class="faq-list">
                <div class="faq-item">
                    <div class="faq-q">AI trong CityScout Pro hoạt động thế nào?</div>
                    <div class="faq-a">
                        CityScout sử dụng Google Gemini AI để gợi ý địa điểm phù hợp,
                        trả lời câu hỏi về Hà Nội và tự động tạo lịch trình hành trình theo sở thích của bạn.
                    </div>
                </div>
                <div class="faq-item">
                    <div class="faq-q">Tôi có thể hủy đăng ký bất cứ lúc nào không?</div>
                    <div class="faq-a">
                        Có. Bạn có thể hủy gói Pro bất kỳ lúc nào. Tính năng Pro vẫn hoạt động
                        đến hết chu kỳ thanh toán hiện tại.
                    </div>
                </div>
                <div class="faq-item">
                    <div class="faq-q">Thanh toán qua phương thức nào?</div>
                    <div class="faq-a">
                        Hiện tại hỗ trợ thanh toán qua QR Code ngân hàng, MoMo và ZaloPay.
                        Sẽ có thêm cổng thanh toán quốc tế trong tương lai.
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Payment modal: 2 bước (chọn gói → QR + xác nhận) -->
<div id="paymentOverlay" class="modal-overlay" style="display:none" onclick="if(event.target===this)closePayModal()">
    <div class="modal-panel" style="max-width:460px;max-height:90vh;overflow-y:auto">
        <div class="modal-panel-header">
            <span id="modalTitle">💳 Nâng cấp CityScout Pro</span>
            <button class="modal-close" onclick="closePayModal()">✕</button>
        </div>

        <!-- Bước 1: Chọn gói -->
        <div id="step1" style="padding:20px">
            <p class="text-muted mb-3">Chọn gói bạn muốn đăng ký:</p>
            <label class="plan-pick active" id="plan-month-label" onclick="pickPlan('month')">
                <div>
                    <div class="plan-pick-name">Gói tháng</div>
                    <div class="plan-pick-desc">Gia hạn mỗi 30 ngày</div>
                </div>
                <div class="plan-pick-price">@(((decimal)ViewBag.MonthAmount).ToString("#,##0"))đ</div>
            </label>
            <label class="plan-pick" id="plan-year-label" onclick="pickPlan('year')">
                <div>
                    <div class="plan-pick-name">Gói năm <span class="plan-pick-badge">Tiết kiệm</span></div>
                    <div class="plan-pick-desc">Dùng trọn 1 năm</div>
                </div>
                <div class="plan-pick-price">@(((decimal)ViewBag.YearAmount).ToString("#,##0"))đ</div>
            </label>
            <button id="btnGetQr" class="btn-accent w-100 mt-3" onclick="createPayment()">
                <i class="bi bi-qr-code-scan"></i> Lấy mã QR chuyển khoản
            </button>
        </div>

        <!-- Bước 2: QR + xác nhận -->
        <div id="step2" style="display:none;padding:20px">
            <div class="text-center mb-3">
                <div id="qrSpinner"><div class="spinner-border text-secondary"></div><div class="text-muted small mt-1">Đang tải QR…</div></div>
                <img id="qrImg" src="" style="display:none;width:220px;border-radius:12px;border:1px solid #eee">
                <div id="qrErr" style="display:none" class="alert alert-info small mt-2">Không tải được QR — dùng thông tin bên dưới để CK thủ công.</div>
            </div>

            <div style="background:#f8fafc;border-radius:10px;padding:.75rem 1rem;font-size:.9rem;margin-bottom:1rem">
                <div class="d-flex justify-content-between py-1 border-bottom"><span class="text-muted">Ngân hàng</span><strong id="s2Bank"></strong></div>
                <div class="d-flex justify-content-between py-1 border-bottom"><span class="text-muted">Số TK</span><strong id="s2Acc"></strong></div>
                <div class="d-flex justify-content-between py-1 border-bottom"><span class="text-muted">Chủ TK</span><strong id="s2Name"></strong></div>
                <div class="d-flex justify-content-between py-1 border-bottom"><span class="text-muted">Số tiền</span><strong id="s2Amount" class="text-primary"></strong></div>
                <div class="d-flex justify-content-between py-1 align-items-center">
                    <span class="text-muted">Nội dung CK</span>
                    <span>
                        <strong id="s2Code" class="text-danger" style="letter-spacing:.5px"></strong>
                        <button onclick="copyCode()" style="background:none;border:1px solid #e2e8f0;border-radius:5px;padding:.1rem .4rem;font-size:.75rem;cursor:pointer;margin-left:.3rem">📋</button>
                    </span>
                </div>
            </div>

            <div class="alert alert-warning small py-2">⚠️ <strong>Bắt buộc ghi đúng nội dung</strong> để hệ thống nhận đúng đơn của bạn.</div>

            <!-- Xác nhận đã CK -->
            <div id="confirmSection">
                <p class="fw-semibold mt-3 mb-1">Sau khi chuyển khoản xong:</p>
                <input id="bankRef" type="text" class="form-control form-control-sm mb-2" placeholder="Mã giao dịch ngân hàng (tuỳ chọn)" maxlength="100">
                <button class="btn-accent w-100" onclick="confirmTransfer()">
                    <i class="bi bi-check-circle"></i> Tôi đã chuyển khoản
                </button>
            </div>

            <div id="confirmDone" style="display:none" class="alert alert-success text-center mt-3">
                ✅ Yêu cầu đã gửi! Admin sẽ duyệt và tài khoản bạn lên Pro trong vòng 24 giờ.
            </div>

            <div class="text-center mt-2">
                <button onclick="backToStep1()" class="text-muted small" style="background:none;border:none;cursor:pointer">← Chọn lại gói</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
let _selectedPlan = 'month';
let _currentCode = '';
const _token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';

function showPayment() {
    document.getElementById('paymentOverlay').style.display = 'flex';
    document.body.style.overflow = 'hidden';
}
function closePayModal() {
    document.getElementById('paymentOverlay').style.display = 'none';
    document.body.style.overflow = '';
    backToStep1();
}
function pickPlan(which) {
    _selectedPlan = which;
    document.getElementById('plan-month-label').classList.toggle('active', which === 'month');
    document.getElementById('plan-year-label').classList.toggle('active', which === 'year');
}
function backToStep1() {
    document.getElementById('step1').style.display = 'block';
    document.getElementById('step2').style.display = 'none';
    document.getElementById('confirmSection').style.display = 'block';
    document.getElementById('confirmDone').style.display = 'none';
    document.getElementById('bankRef').value = '';
}
async function createPayment() {
    const btn = document.getElementById('btnGetQr');
    btn.disabled = true; btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Đang tạo…';
    try {
        const fd = new FormData();
        fd.append('plan', _selectedPlan);
        fd.append('__RequestVerificationToken', _token);
        const r = await fetch('/Payments/Create', { method:'POST', body: fd });
        const d = await r.json();
        if (!d.ok) throw new Error(d.msg || 'Lỗi tạo đơn');
        _currentCode = d.code;
        showStep2(d);
    } catch(e) {
        alert('Có lỗi: ' + e.message);
    } finally {
        btn.disabled = false; btn.innerHTML = '<i class="bi bi-qr-code-scan"></i> Lấy mã QR chuyển khoản';
    }
}
function showStep2(d) {
    document.getElementById('step1').style.display = 'none';
    document.getElementById('step2').style.display = 'block';
    document.getElementById('s2Bank').textContent = d.bankCode;
    document.getElementById('s2Acc').textContent = d.accountNumber;
    document.getElementById('s2Name').textContent = d.accountName;
    document.getElementById('s2Amount').textContent = d.amount + 'đ';
    document.getElementById('s2Code').textContent = d.code;
    const img = document.getElementById('qrImg');
    img.onload = () => { document.getElementById('qrSpinner').style.display='none'; img.style.display='inline'; };
    img.onerror = () => { document.getElementById('qrSpinner').style.display='none'; document.getElementById('qrErr').style.display='block'; };
    img.src = d.qrUrl;
}
function copyCode() {
    navigator.clipboard.writeText(document.getElementById('s2Code').textContent.trim())
        .then(() => { const b = event.target; b.textContent='✅'; setTimeout(()=>b.textContent='📋',1500); });
}
async function confirmTransfer() {
    const btn = event.target.closest('button');
    btn.disabled = true; btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Đang gửi…';
    try {
        const fd = new FormData();
        fd.append('code', _currentCode);
        fd.append('bankRef', document.getElementById('bankRef').value);
        fd.append('__RequestVerificationToken', _token);
        const r = await fetch('/Payments/Confirm', { method:'POST', body: fd });
        const d = await r.json();
        if (d.ok) {
            document.getElementById('confirmSection').style.display = 'none';
            document.getElementById('confirmDone').style.display = 'block';
        } else { alert(d.msg || 'Lỗi xác nhận'); }
    } catch { alert('Lỗi kết nối'); }
    finally { btn.disabled = false; }
}
document.addEventListener('keydown', e => { if (e.key === 'Escape') closePayModal(); });
function startLoading() {
    document.getElementById('btnText').style.display = 'none';
    document.getElementById('btnLoading').style.display = 'inline';
    document.getElementById('btnCreateQr').disabled = true;
}
</script>
}
