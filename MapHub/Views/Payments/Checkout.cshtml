@model MapHub.Models.Payment
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Env
@{
    ViewData["Title"] = "Thanh toán Pro – CityScout";
    bool alreadyPaid = Model.Status == "paid";
}

<style>
.ck-wrap  { max-width:460px; margin:2rem auto; padding:0 1rem; }
.ck-card  { background:#fff; border:1px solid #e5e7eb; border-radius:20px;
            box-shadow:0 8px 36px rgba(0,0,0,.08); overflow:hidden; }

/* header */
.ck-hd    { background:linear-gradient(135deg,#7c3aed,#a855f7);
            color:#fff; padding:1.25rem 1.5rem; text-align:center; }
.ck-hd h5 { margin:0; font-weight:800; font-size:1.05rem; }
.ck-hd small { opacity:.85; font-size:.88rem; }

/* steps */
.ck-steps { background:#f8f9fb; border-bottom:1px dashed #e5e7eb;
            padding:.8rem 1.2rem; font-size:.8rem; color:#475569; }
.ck-steps li { margin:.2rem 0; }
.ck-steps li strong { color:#1e293b; }

/* qr zone */
.ck-qr { padding:1.5rem 1rem 1rem; display:flex; flex-direction:column; align-items:center;
         background:#f8f5ff; border-bottom:1px dashed #e5e7eb; }
.ck-qr-img { width:240px; height:240px; border-radius:14px;
             border:4px solid #fff; box-shadow:0 4px 20px rgba(124,58,237,.18);
             display:block; object-fit:contain; }
.ck-qr-hint { font-size:.78rem; color:#64748b; margin-top:.55rem; text-align:center; }

/* info table */
.ck-info { padding:.9rem 1.4rem; }
.ck-row  { display:flex; justify-content:space-between; align-items:center;
           padding:.4rem 0; border-bottom:1px dashed #f0f0f0; font-size:.88rem; }
.ck-row:last-child { border-bottom:none; }
.ck-row > span { color:#64748b; }
.ck-code { font-weight:800; color:#e11d48; letter-spacing:.8px; font-size:1rem; }
.ck-copy { background:none; border:1px solid #e2e8f0; border-radius:6px;
           padding:.1rem .45rem; font-size:.75rem; cursor:pointer; margin-left:.35rem; color:#7c3aed; }
.ck-copy:hover { background:#faf5ff; }

/* warn */
.ck-warn { margin:0 1.4rem .8rem; background:#fffbeb; border:1px solid #fcd34d;
           border-radius:10px; padding:.6rem .9rem; font-size:.82rem; }

/* waiting */
.ck-wait { margin:1rem 1.4rem 1.5rem; background:#f0f9ff; border:1px solid #bae6fd;
           border-radius:14px; padding:1.1rem 1rem; text-align:center; }
.ck-wait-title { font-weight:700; color:#0369a1; font-size:.95rem; margin-bottom:.35rem; }
.ck-wait-sub   { font-size:.8rem; color:#64748b; }

/* success */
.ck-success { margin:1rem 1.4rem 1.5rem; background:#f0fdf4; border:1px solid #86efac;
              border-radius:14px; padding:1.2rem 1rem; text-align:center; }
.ck-success-icon { font-size:2.5rem; line-height:1; }
.ck-success-title { font-weight:800; color:#15803d; font-size:1.1rem; margin:.3rem 0 .2rem; }
.ck-success-sub   { font-size:.83rem; color:#64748b; }
</style>

<div class="ck-wrap">
    <div class="ck-card">

        <div class="ck-hd">
            <h5><i class="fa-solid fa-qrcode me-1"></i> Thanh toán qua chuyển khoản</h5>
            <small>Gói @ViewBag.PlanLabel · <strong>@Model.Amount.ToString("#,##0")đ</strong></small>
        </div>

        <ol class="ck-steps">
            <li><strong>Bước 1:</strong> Quét mã QR bằng app ngân hàng bất kỳ</li>
            <li><strong>Bước 2:</strong> Chuyển khoản đúng số tiền, ghi nội dung <strong style="color:#e11d48">@Model.Code</strong></li>
            <li><strong>Bước 3:</strong> Trang này tự cập nhật khi hệ thống nhận được tiền <i class="fa-solid fa-circle-check" style="color:#16a34a"></i></li>
        </ol>

        <!-- QR -->
        <div class="ck-qr">
            <img id="qrImg" class="ck-qr-img"
                 src="@ViewBag.QrUrl"
                 alt="VietQR – @Model.Code"
                 onerror="this.style.display='none';document.getElementById('qrFallback').style.display='block'">
            <div id="qrFallback" style="display:none;width:240px;height:80px;display:none;
                 align-items:center;justify-content:center;background:#fef2f2;border-radius:12px;
                 font-size:.8rem;color:#ef4444;text-align:center;padding:1rem">
                Không tải được QR<br>Dùng số TK bên dưới
            </div>
            <div class="ck-qr-hint"><i class="fa-solid fa-mobile-screen me-1"></i>Mở app ngân hàng → Quét mã QR</div>
        </div>

        <!-- Bank info -->
        <div class="ck-info">
            <div class="ck-row"><span>Ngân hàng</span><strong>Vietcombank (VCB)</strong></div>
            <div class="ck-row"><span>Số tài khoản</span><strong>@ViewBag.AccountNumber</strong></div>
            <div class="ck-row"><span>Chủ tài khoản</span><strong>@ViewBag.AccountName</strong></div>
            <div class="ck-row"><span>Số tiền</span><strong class="text-primary">@Model.Amount.ToString("#,##0")đ</strong></div>
            <div class="ck-row">
                <span>Nội dung CK</span>
                <span>
                    <span class="ck-code" id="ckCode">@Model.Code</span>
                    <button class="ck-copy" onclick="copyCode()"><i class="fa-regular fa-copy"></i> Copy</button>
                </span>
            </div>
        </div>

        <div class="ck-warn">
            <i class="fa-solid fa-triangle-exclamation" style="color:#b45309"></i> <strong>Bắt buộc ghi đúng nội dung: @Model.Code</strong><br>
            Sai nội dung hệ thống sẽ không nhận được giao dịch của bạn.
        </div>

        <!-- Trạng thái chờ / thành công -->
        @if (alreadyPaid)
        {
            <div class="ck-success">
                <div class="ck-success-icon"><i class="fa-solid fa-circle-check" style="color:#16a34a"></i></div>
                <div class="ck-success-title">Đã kích hoạt Pro!</div>
                <div class="ck-success-sub">Tài khoản của bạn đã được nâng cấp thành công.</div>
                <a href="/" class="btn btn-sm btn-success mt-2">Về trang chủ</a>
            </div>
        }
        else
        {
            @Html.AntiForgeryToken()
            <div class="ck-wait" id="waitBox">
                <div class="spinner-border spinner-border-sm text-primary me-2"></div>
                <span class="ck-wait-title">Đang chờ xác nhận thanh toán…</span>
                <div class="ck-wait-sub mt-1">
                    Hệ thống tự động xác nhận trong vài phút sau khi bạn chuyển khoản.<br>
                    Đã chuyển lâu mà chưa lên Pro?
                    <a href="#" onclick="requestAdmin();return false;" style="color:#0369a1;font-weight:700">Gửi yêu cầu Admin duyệt →</a>
                    <div id="reqAdminMsg" style="margin-top:.45rem;font-size:.82rem"></div>
                </div>
            </div>

            @if (Env.IsDevelopment())
            {
                <div style="margin:0 1.4rem 1.5rem; text-align:center">
                    <button type="button" onclick="devConfirm()"
                            style="font-size:.78rem;padding:.4rem .8rem;border:1px dashed #cbd5e1;border-radius:8px;background:#fff;cursor:pointer;color:#94a3b8">
                        <i class="fa-solid fa-flask"></i> Giả lập đã thanh toán (chỉ DEV)
                    </button>
                </div>
            }
        }

    </div>
    <div class="text-center mt-3 pb-4">
        <a href="/Payments/Premium" class="text-muted small">← Quay lại trang gói</a>
    </div>
</div>

@section Scripts {
<script>
function copyCode() {
    const code = document.getElementById('ckCode').textContent.trim();
    navigator.clipboard.writeText(code).then(function() {
        event.target.innerHTML = '<i class="fa-solid fa-check"></i> Đã copy';
        setTimeout(() => event.target.innerHTML = '<i class="fa-regular fa-copy"></i> Copy', 2000);
    });
}

// Gửi yêu cầu Admin duyệt thủ công (khi CK lâu mà chưa tự lên Pro)
function requestAdmin() {
    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
    const el = document.getElementById('reqAdminMsg');
    el.style.color = '#64748b'; el.textContent = 'Đang gửi…';
    fetch('/Payments/Confirm', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': token },
        body: 'code=' + encodeURIComponent('@Model.Code')
    })
    .then(r => r.json())
    .then(d => {
        if (d.ok) { el.style.color = '#15803d'; el.textContent = '✅ Đã gửi yêu cầu! Admin sẽ duyệt sớm.'; }
        else { el.style.color = '#b45309'; el.textContent = d.msg || 'Đơn đã được xử lý.'; }
    })
    .catch(() => { el.style.color = '#dc2626'; el.textContent = 'Lỗi gửi yêu cầu, thử lại.'; });
}

// DEV only: giả lập webhook báo đã trả → lên Pro ngay tại localhost
function devConfirm() {
    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
    fetch('/Payments/DevConfirm', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'RequestVerificationToken': token },
        body: 'code=' + encodeURIComponent('@Model.Code')
    })
    .then(r => r.json())
    .then(d => {
        if (d.ok) {
            window.location.reload();
        } else {
            alert(d.msg || 'Lỗi giả lập thanh toán');
        }
    })
    .catch(() => alert('Không gọi được DevConfirm (app đang chạy chưa?)'));
}

// Auto-poll trạng thái mỗi 5 giây — khi webhook VCB báo về sẽ tự redirect thành công
@if (!alreadyPaid)
{
    <text>
(function() {
    var code = '@Model.Code';
    var tries = 0;
    var maxTries = 150; // ~12 phút rồi dừng (đủ cho CK chậm khi vẫn mở trang)

    function poll() {
        // Status giờ chủ động hỏi Casso → xác nhận gần như tức thì sau khi tiền vào,
        // không phụ thuộc webhook hay vòng nền (Render free có thể ngủ).
        fetch('/Payments/Status?code=' + code)
            .then(r => r.json())
            .then(d => {
                if (d.paid) {
                    document.getElementById('waitBox').innerHTML =
                        '<div class="ck-success-icon"><i class="fa-solid fa-circle-check" style="color:#16a34a"></i></div>' +
                        '<div class="ck-success-title" style="color:#15803d;font-weight:800;font-size:1.05rem;margin:.3rem 0 .2rem">Thanh toán thành công!</div>' +
                        '<div class="ck-success-sub">Tài khoản của bạn đã lên Pro. Đang chuyển hướng…</div>';
                    document.getElementById('waitBox').className = 'ck-success';
                    setTimeout(() => { window.location.href = '/Payments/Premium'; }, 2000);
                } else if (maxTries > ++tries) {
                    setTimeout(poll, 5000);
                }
            })
            .catch(() => { if (maxTries > ++tries) setTimeout(poll, 8000); });
    }
    setTimeout(poll, 3000);
})();
    </text>
}
</script>
}
