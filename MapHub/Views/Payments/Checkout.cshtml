@model MapHub.Models.Payment
@{
    ViewData["Title"] = "Thanh toán Pro – CityScout";
}

<style>
    .checkout-card {
        max-width: 520px; margin: 2rem auto; background: #fff;
        border: 1px solid var(--line, #e5e7eb); border-radius: 16px;
        padding: 1.5rem; box-shadow: 0 8px 30px rgba(0,0,0,.06);
    }
    .checkout-qr { width: 260px; max-width: 100%; border-radius: 12px; border: 1px solid #eee; }
    .checkout-info { margin-top: 1rem; border-top: 1px dashed #e5e7eb; }
    .checkout-info > div {
        display: flex; justify-content: space-between; gap: 1rem;
        padding: .5rem 0; border-bottom: 1px dashed #f0f0f0; font-size: .92rem;
    }
    .checkout-info > div span { color: #64748b; }
    .checkout-code { font-size: 1.05rem; letter-spacing: .5px; }
    .qr-box { min-height: 270px; display:flex; align-items:center; justify-content:center; }
    .copy-btn { cursor:pointer; background:none; border:1px solid #e2e8f0; border-radius:6px;
                padding:.15rem .5rem; font-size:.8rem; color:#6d28d9; margin-left:.4rem; }
    .copy-btn:hover { background:#faf5ff; }
</style>

<div class="container">
    <div class="checkout-card">
        <h4 class="text-center mb-1">Quét mã để nâng cấp Pro</h4>
        <p class="text-center text-muted mb-3">
            Gói @ViewBag.PlanLabel · <strong>@Model.Amount.ToString("#,##0")đ</strong>
        </p>

        <!-- QR area -->
        <div class="text-center my-2 qr-box" id="qrBox">
            <div id="qrLoading">
                <div class="spinner-border text-secondary mb-2"></div>
                <div class="text-muted small">Đang tải mã QR…</div>
            </div>
            <img id="qrImg" src="@ViewBag.QrUrl" alt="VietQR" class="checkout-qr" style="display:none"
                 onload="qrLoaded()" onerror="qrFailed()">
            <div id="qrFallback" style="display:none"
                 class="alert alert-info small text-start">
                Không tải được mã QR.<br>
                Vui lòng chuyển khoản thủ công theo thông tin bên dưới.
            </div>
        </div>

        <div class="checkout-info">
            <div><span>Ngân hàng</span><strong>@ViewBag.BankCode</strong></div>
            <div><span>Số tài khoản</span><strong>@ViewBag.AccountNumber</strong></div>
            <div><span>Chủ tài khoản</span><strong>@ViewBag.AccountName</strong></div>
            <div><span>Số tiền</span><strong>@Model.Amount.ToString("#,##0")đ</strong></div>
            <div>
                <span>Nội dung CK</span>
                <strong class="text-danger checkout-code" id="payCode">@Model.Code</strong>
                <button class="copy-btn" onclick="copyCode()" title="Sao chép">📋</button>
            </div>
        </div>

        <div class="alert alert-warning mt-3 small mb-0">
            ⚠️ <strong>Bắt buộc ghi đúng nội dung: <span class="text-danger">@Model.Code</span></strong>
            — hệ thống tự nhận và lên Pro ngay sau khi chuyển khoản.
        </div>

        <div id="payStatus" class="text-center mt-3">
            <div class="spinner-border spinner-border-sm text-secondary"></div>
            <span class="text-muted ms-1">Đang chờ thanh toán…</span>
        </div>

        <div class="text-center mt-3">
            <a href="/Payments/Premium" class="text-muted small">← Quay lại</a>
        </div>
    </div>
</div>

@section Scripts {
<script>
function qrLoaded() {
    document.getElementById('qrLoading').style.display = 'none';
    document.getElementById('qrImg').style.display = 'inline';
}
function qrFailed() {
    document.getElementById('qrLoading').style.display = 'none';
    document.getElementById('qrFallback').style.display = 'block';
    document.getElementById('qrBox').style.minHeight = 'auto';
}
function copyCode() {
    const code = document.getElementById('payCode').textContent.trim();
    navigator.clipboard.writeText(code).then(() => {
        const btn = document.querySelector('.copy-btn');
        btn.textContent = '✅'; setTimeout(() => btn.textContent = '📋', 1500);
    });
}
const CODE = '@Model.Code';
const timer = setInterval(async () => {
    try {
        const r = await fetch('/Payments/Status?code=' + encodeURIComponent(CODE));
        if (!r.ok) return;
        const d = await r.json();
        if (d.paid) {
            clearInterval(timer);
            document.getElementById('payStatus').innerHTML =
                '<div class="text-success fw-bold">✅ Thanh toán thành công! Đang chuyển hướng…</div>';
            setTimeout(() => location.href = '/Payments/Premium', 1800);
        }
    } catch { }
}, 3000);
</script>
}
